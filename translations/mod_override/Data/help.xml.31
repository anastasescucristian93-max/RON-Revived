			<ENTRY>Örn: /emote herkese el sallıyor.</ENTRY>
		</EMOTE>
		<FRIENDS>
			<ENTRY>/friends {komut} (diğer adı /f)</ENTRY>
			<ENTRY>Çeşitli arkadaş yönetimi komutlarına erişir</ENTRY>
			<ENTRY>- list - Bilinen tüm arkadaşları listeler (diğer adı l)</ENTRY>
			<ENTRY>- add {ad} - Arkadaş listesine bir arkadaş ekler (diğer adı a)</ENTRY>
			<ENTRY>- remove {ad} - Bir arkadaşı listeden çıkarır (diğer adı r)</ENTRY>
			<ENTRY>- msg {mesaj} - Tüm arkadaşlara mesaj gönderir (diğer adı m)</ENTRY>
			<ENTRY>Örn: /friends list</ENTRY>
			<ENTRY>/f add BHG_Masta</ENTRY>
			<ENTRY>/f m Bir oyun oynamak ister misiniz?</ENTRY>
		</FRIENDS>
		<OPTIONS>
