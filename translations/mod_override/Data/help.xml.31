				<STRING>İstenebilecek koloniler. Koloniler haritada bulunmaz, ancak nadir kaynak, haraç ve harika sağlayabilir.</STRING>
			</ENTRY>
			<ENTRY name="STANCE">
				<STRING>Text needed for CONQUESTNEGOTIATEWIN/LISTBOX/STANCE in help.xml!</STRING>
			</ENTRY>
		</LISTBOX>
		<SPOT>
			<ENTRY name="OPP_OFF_CARDS">
				<STRING>$CARDNAME0<SPACE/>$CARDDESC1</STRING>
