	<CAT hash="44397162">
		<STRING hash="34157738" hash_i="34133086" needed="1">Вы выиграли битву.</STRING>
		<STRING hash="82012261" hash_i="81987609" needed="1">Вы истребили наёмников.</STRING>
		<STRING hash="113504005" hash_i="113479353" needed="1">Вы разгромили все кочевые племена.</STRING>
		<STRING hash="84115919" hash_i="84091267" needed="1">Вы истребили наёмников.</STRING>
		<STRING hash="111333699" hash_i="111309047" needed="1">Вы успешно пересекли пустыню!</STRING>
		<STRING hash="29337395" hash_i="29467319" needed="1">Вы объединили Грецию.</STRING>
		<STRING hash="35815269" hash_i="36034993" needed="1">Вы покорили Египет.</STRING>
		<STRING hash="54706888" hash_i="54996578" needed="1">Вы разгромили Магадху.</STRING>
		<STRING hash="36085555" hash_i="36248479" needed="1">Вы покорили Индию.</STRING>
		<STRING hash="51797082" hash_i="52086772" needed="1">Вы разгромили Маурьев.</STRING>
		<STRING hash="48942727" hash_i="50799331" needed="1">Вы защитили Александра!</STRING>
		<STRING hash="62405071" hash_i="62752721" needed="1">Вы собрали достаточно металла.</STRING>
		<STRING hash="42159644" hash_i="42134992" needed="1">Вы заселили новые земли.</STRING>
		<STRING hash="43452384" hash_i="43427732" needed="1">Вы выиграли торговую войну.</STRING>
		<STRING hash="20511596" hash_i="20486944" needed="1">Вы добились успеха.</STRING>
		<STRING hash="53554556" hash_i="53529904" needed="1">Вы остановили захватчиков.</STRING>
		<STRING hash="80249280" hash_i="80224628" needed="1">Вы истребили наёмников!</STRING>
		<STRING hash="186815686" hash_i="187150976" needed="1">Большинство восстаний утихло. Ваша власть незыблема.</STRING>
		<STRING hash="64785017" hash_i="64769589" needed="1">Франция свергла монархию.</STRING>
		<STRING hash="44813056" hash_i="44788404" needed="1">Вы пересекли пустыню.</STRING>
		<STRING hash="67275366" hash_i="67250714" needed="1">Вы истребили разбойников.</STRING>
		<STRING hash="31182624" hash_i="31157972" needed="1">Вы выиграли битву.</STRING>
		<STRING hash="31208788" hash_i="31184136" needed="1">Вы выиграли битву.</STRING>
		<STRING hash="56459057" hash_i="56434405" needed="1">Вы выполнили миссию.</STRING>
	</CAT>
	<CAT hash="38438024">
		<STRING hash="37310381" hash_i="37285729" needed="1">Вы проиграли битву.</STRING>
		<STRING hash="886320487" hash_i="884168747" needed="1">Ваши армии заняли территорию без сопротивления.  Однако местные жители собрались с силами и штурмуют ваш новый форпост.  Защищайте столицу до конца отсчёта, чтобы победить.</STRING>
		<STRING hash="460127993" hash_i="464950815" needed="1">Ваша армия приближается к армии варваров.  Атакуйте их лагерь и уничтожьте все их здания, чтобы победить.</STRING>
		<STRING hash="699657885" hash_i="699635379" needed="1">Варварские нации в этом регионе слабы и наверняка покорятся вам, если вы докажете своё превосходство, захватив один из их городов.</STRING>
		<STRING hash="782757605" hash_i="781563091" needed="1">На этой территории несколько местных племён борются за власть.  Используйте дипломатию, чтобы стравить их друг с другом и утвердить своё господство.</STRING>
		<STRING hash="1041644836" hash_i="1049167724" needed="1">Варварские племена этого региона объединились, чтобы уничтожить вас.  К счастью, вы взяли с собой больше припасов, а варвары отстают от вас на эпоху.  Продержитесь до конца отсчёта, чтобы победить.</STRING>
		<STRING hash="34211834" hash_i="34187182" needed="1">Вы проиграли битву.</STRING>
		<STRING hash="85798563" hash_i="85776057" needed="1">Наёмники одолели вас.</STRING>
		<STRING hash="174879179" hash_i="174854527" needed="1">Вам не удалось разгромить все кочевые племена.</STRING>
		<STRING hash="86459437" hash_i="86436931" needed="1">Наёмники одолели вас.</STRING>
		<STRING hash="450505024" hash_i="450480372" needed="1">Вы погибли в песках, где ваши кости клевали бы стервятники, если бы и для них не было слишком жарко.</STRING>
		<STRING hash="60237741" hash_i="60592993" needed="1">Вам не удалось объединить Грецию.</STRING>
		<STRING hash="84636528" hash_i="87379740" needed="1">Вам не удалось защитить Александра!</STRING>
		<STRING hash="67149673" hash_i="67515349" needed="1">Вы не собрали достаточно металла.</STRING>
		<STRING hash="65336844" hash_i="65312192" needed="1">Ваши поселенцы разгромлены.</STRING>
		<STRING hash="29252721" hash_i="29228069" needed="1">Вы потерпели поражение.</STRING>
		<STRING hash="35405839" hash_i="37285729" needed="1">Вы проиграли битву.</STRING>
		<STRING hash="46968490" hash_i="46943838" needed="1">Вы проиграли торговую войну.</STRING>
		<STRING hash="62200690" hash_i="62176038" needed="1">Вашему народу грозит голод.</STRING>
		<STRING hash="70563669" hash_i="70541163" needed="1">Захватчики одолели вас.</STRING>
		<STRING hash="37290612" hash_i="37265960" needed="1">Вы погибли в песках.</STRING>
		<STRING hash="70807061" hash_i="70784555" needed="1">Разбойники одолели вас.</STRING>
		<STRING hash="34157738" hash_i="34133086" needed="1">Вы выиграли битву.</STRING>
		<STRING hash="40929481" hash_i="40904829" needed="1">Вы проиграли битву.</STRING>
		<STRING hash="44917033" hash_i="44892381" needed="1">Вы провалили миссию.</STRING>
		<STRING hash="444407072" hash_i="444382420" needed="1">Вы погибли в песках, где ваши кости клевали бы стервятники, если бы и для них не было слишком жарко.</STRING>
		<STRING hash="55704156" hash_i="55679504" needed="1">Вы сгинули в песках.</STRING>
		<STRING hash="79414608" hash_i="79392102" needed="1">Наёмники покинули вас.</STRING>
	</CAT>
