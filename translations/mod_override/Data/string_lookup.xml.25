		<STRING hash="43484279" hash_i="43582347" needed="1">Уничтожьте вражеские редуты.</STRING>
		<STRING hash="33571508" hash_i="33550066" needed="1">Отвоюйте свою столицу.</STRING>
		<STRING hash="30330035" hash_i="30315565" needed="1">Защитите воздушные маршруты.</STRING>
		<STRING hash="34106582" hash_i="34092112" needed="1">Уничтожьте сахарные плантации.</STRING>
		<STRING hash="39266331" hash_i="41409983" needed="1">Захватите Панамский канал.</STRING>
		<STRING hash="30412732" hash_i="30538258" needed="1">Спасите южнокорейцев.</STRING>
		<STRING hash="45781788" hash_i="45767318" needed="1">Уничтожьте вражеские здания.</STRING>
		<STRING hash="43023164" hash_i="43007736" needed="1">Найдите и спасите заложников.</STRING>
		<STRING hash="43806576" hash_i="46064446" needed="1">Внедритесь во вражеские города.</STRING>
		<STRING hash="46899210" hash_i="46990058" needed="1">Уничтожьте вражеские верфи.</STRING>
		<STRING hash="195248585" hash_i="196051265" needed="1">Соберите грабежом по 1000 каждого ресурса (кроме знаний).</STRING>
		<STRING hash="218795622" hash_i="219852572" needed="1">Пересеките пустыню и доберитесь до дозорной вышки, пока не истекло время.</STRING>
		<STRING hash="295992462" hash_i="310168264" needed="1">Захватите вражескую столицу (столицы) за $NUM0 мин.  Подсказка: постройте город с помощью горожан.</STRING>
		<STRING hash="58763443" hash_i="61754819" needed="1">Разгромите южнокорейцев (синие).</STRING>
		<STRING hash="69757868" hash_i="70251042" needed="1">Разбейте южнокорейцев (оранжевые).</STRING>
		<STRING hash="63833421" hash_i="64242217" needed="1">Разгромите северокорейцев (белые).</STRING>
		<STRING hash="24527377" hash_i="24512907" needed="1">Обороняйте свою столицу.</STRING>
		<STRING hash="45720314" hash_i="45795706" needed="1">Захватите вражеские столицы.</STRING>
		<STRING hash="16697633" hash_i="16683163" needed="1">Обороняйте свою базу.</STRING>
		<STRING hash="58520495" hash_i="61554447" needed="1">Разгромите северокорейцев (синие).</STRING>
		<STRING hash="282687747" hash_i="283102779" needed="1">Удержите начальные города южнокорейцев (оранжевые) под их контролем, пока не истечёт время</STRING>
		<STRING hash="265069940" hash_i="267798122" needed="1">Удержите начальные города южнокорейцев (синие) под их контролем, пока не истечёт время</STRING>
		<STRING hash="32913640" hash_i="34240650" needed="1">Захватите все синие города.</STRING>
		<STRING hash="63102312" hash_i="63640616" needed="1">Уничтожьте белые хижины торговцев.</STRING>
		<STRING hash="179054230" hash_i="179038802" needed="1">Найдите и захватите вражескую столицу за 90 минут.</STRING>
		<STRING hash="243222693" hash_i="253814933" needed="1">Уничтожьте хижины торговцев мятежников (белые) и защитите колумбийцев (синие).</STRING>
		<STRING hash="291149192" hash_i="291564224" needed="1">Удержите начальные города южнокорейцев (оранжевые) под их контролем, пока не истечёт время.</STRING>
		<STRING hash="273241943" hash_i="275970125" needed="1">Удержите начальные города южнокорейцев (синие) под их контролем, пока не истечёт время.</STRING>
	</CAT>
