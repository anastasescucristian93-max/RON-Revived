		<STRING hash="6194878" hash_i="6411260" needed="1">АВТОРАЗВЁРТЫВАНИЕ</STRING>
		<STRING hash="8366798" hash_i="9212466" needed="1">РУЧН. РАЗВЁРТЫВАНИЕ</STRING>
