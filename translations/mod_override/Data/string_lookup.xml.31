		<STRING hash="51797082" hash_i="52086772" needed="1">Mauryaları yendiniz.</STRING>
		<STRING hash="48942727" hash_i="50799331" needed="1">İskender'i korudunuz!</STRING>
		<STRING hash="62405071" hash_i="62752721" needed="1">Yeterince Metal topladınız.</STRING>
		<STRING hash="42159644" hash_i="42134992" needed="1">Yeni topraklara yerleştiniz.</STRING>
		<STRING hash="43452384" hash_i="43427732" needed="1">Ticaret savaşını kazandınız.</STRING>
