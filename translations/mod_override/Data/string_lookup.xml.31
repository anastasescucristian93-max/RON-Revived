	<CAT hash="30698867">
		<STRING hash="66457806" hash_i="66439508" needed="1">Düşmanı 15 dakika boyunca durdurun.</STRING>
		<STRING hash="41980852" hash_i="42056244" needed="1">Düşman başkentini ele geçirin.</STRING>
		<STRING hash="90105976" hash_i="90090548" needed="1">Düşmanın başkentini bulun ve ele geçirin.</STRING>
