	<CAT hash="5045222">
		<STRING hash="2054343" hash_i="2054343" needed="1">Consulta ./scenario/sample_script.bhs para obtener información adicional</STRING>
		<STRING hash="2044028" hash_i="2044028" needed="1">Utiliza las funciones del desencadenador (verás la lista seleccionando Editar-&gt;Insertar función de desencadenador) para controlar los acontecimientos durante la partida</STRING>
		<STRING hash="2660675" hash_i="2660675" needed="1">Inserta comandos que se ejecutarán cuando la condición del desencadenador sea real y el desencadenador esté activado.</STRING>
		<STRING hash="3935950" hash_i="3935950" needed="1">Condiciones bajo las cuales el desencadenador se activará</STRING>
		<STRING hash="865265" hash_i="865265" needed="1">Utiliza Editar-&gt;Insertar bloqueo de desencadenador para agregar un bloqueo de desencadenador vacío.</STRING>
		<STRING hash="858586" hash_i="858586" needed="1">Utiliza Editar-&gt;Insertar función de desencadenador para seleccionar en la lista de funciones disponibles</STRING>
		<STRING hash="852417" hash_i="852417" needed="1">Agrega desencadenadores y otros comandos para que se ejecuten aquí en cada imagen de la partida.</STRING>
		<STRING hash="1294078" hash_i="1294078" needed="1">Secuencia de comandos principal.</STRING>
		<STRING hash="3549171" hash_i="3549171" needed="1">Inserta comandos que sólo se deben ejecutar una vez cuando la secuencia de comandos se carga aquí.</STRING>
		<STRING hash="1853852" hash_i="1853852" needed="1">Agrega aquí cualquier etiqueta constante en una lista separada por comas.</STRING>
	</CAT>
