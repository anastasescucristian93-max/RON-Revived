	<CAT hash="44397162">
		<STRING hash="34157738" hash_i="34133086" needed="1">Has ganado la batalla.</STRING>
		<STRING hash="82012261" hash_i="81987609" needed="1">Ha expulsado a los Mercenarios.</STRING>
		<STRING hash="113504005" hash_i="113479353" needed="1">Ha derrotado a todas las tribus nómadas.</STRING>
		<STRING hash="84115919" hash_i="84091267" needed="1">Ha expulsado a los Mercenarios.</STRING>
		<STRING hash="111333699" hash_i="111309047" needed="1">Ha cruzado el desierto con éxito!</STRING>
		<STRING hash="29337395" hash_i="29467319" needed="1">Ha unido Grecia.</STRING>
		<STRING hash="35815269" hash_i="36034993" needed="1">Ha conquistado Egipto.</STRING>
		<STRING hash="54706888" hash_i="54996578" needed="1">Ha derrotado a los Magadha.</STRING>
		<STRING hash="36085555" hash_i="36248479" needed="1">Ha conquistado India.</STRING>
		<STRING hash="51797082" hash_i="52086772" needed="1">Ha derrotado a los Maurya.</STRING>
		<STRING hash="48942727" hash_i="50799331" needed="1">Ha protegido a Alejandro!</STRING>
		<STRING hash="62405071" hash_i="62752721" needed="1">Ha recogido suficiente Metal.</STRING>
		<STRING hash="42159644" hash_i="42134992" needed="1">Se ha asentado en nuevas tierras.</STRING>
		<STRING hash="43452384" hash_i="43427732" needed="1">Ha ganado la guerra del comercio.</STRING>
		<STRING hash="20511596" hash_i="20486944" needed="1">Ha tenido éxito.</STRING>
		<STRING hash="53554556" hash_i="53529904" needed="1">Ha detenido a los invasores.</STRING>
		<STRING hash="80249280" hash_i="80224628" needed="1">Ha expulsado a los Mercenarios!</STRING>
		<STRING hash="186815686" hash_i="187150976" needed="1">La mayoría de las revueltas se han sosegado. Su poder está intacto.</STRING>
		<STRING hash="64785017" hash_i="64769589" needed="1">Francia ha derrocado a la monarquía.</STRING>
		<STRING hash="44813056" hash_i="44788404" needed="1">Ha cruzado el desierto.</STRING>
		<STRING hash="67275366" hash_i="67250714" needed="1">Ha expulsado a los Brigadistas.</STRING>
		<STRING hash="31182624" hash_i="31157972" needed="1">Ha ganado la batalla.</STRING>
