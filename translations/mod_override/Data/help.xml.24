			</ENTRY>
			<ENTRY name="BUDDYLIST">
				<STRING>Listează prietenii tăi actuali.</STRING>
			</ENTRY>
		</LISTBOX>
		<CHECKBOX>
			<ENTRY name="REQUIRE_RANDOM_TEAMS">
				<STRING>{DOAR ECHIPE ALEATORII}: Cu echipe aleatorii obligatorii, jucătorii nu își pot alege coechipierii: trebuie să aleagă {"?"}.</STRING>
			</ENTRY>
			<ENTRY name="FREE_PAUSE">
				<STRING>{PAUZĂ LIBERĂ}: Bifează această casetă ca să le permiți jucătorilor să deruleze ecranul și să dea ordine când jocul e pe pauză. Opțiunea e mereu activă în jocurile solo, dar trebuie aleasă aici ca să fie folosită în jocurile multiplayer.</STRING>
			</ENTRY>
			<ENTRY name="TURBO_RESOURCES">
				<STRING>{RESURSE TURBO}: Bifează această casetă ca să crești rata de colectare a resurselor. Opțiunea este pentru jucătorii care vor să pună mai puțin accent pe colectarea resurselor și să petreacă mai mult timp cu alte părți ale jocului.</STRING>
			</ENTRY>
			<ENTRY name="TOURNAMENT_PLAY">
				<STRING>{TURNEU}: Bifează această casetă ca să ascunzi națiunile alese de jucători înainte de joc și scorurile jucătorilor în timpul jocului. Jucătorii care abandonează devreme nu văd întreaga hartă până la sfârșitul jocului.</STRING>
			</ENTRY>
			<ENTRY name="REQUIRE_RANDOM_NATIONS">
				<STRING>{DOAR NAȚIUNI ALEATORII}: Cu națiuni aleatorii obligatorii, jucătorii nu pot alege o anumită națiune: trebuie să aleagă {Aleatoriu}.</STRING>
			</ENTRY>
		</CHECKBOX>
		<COMBOBOX>
			<ENTRY name="TEAM_STYLE">
				<STRING>{ECHIPE ȘI ALIAȚI}: Clic aici ca să alegi dacă și cum vor fi organizate națiunile în echipe și dacă alianțele se pot schimba în timpul jocului.</STRING>
			</ENTRY>
			<ENTRY name="MAP_STYLE">
				<STRING>{STIL HARTĂ}: Clic aici pentru a alege stilul hărții pe care joci. Fiecare stil de hartă duce la un alt fel de joc și la o altă situație strategică.</STRING>
			</ENTRY>
			<ENTRY name="MAP_SIZE">
				<STRING>{MĂRIME HARTĂ}: Clic aici pentru a alege mărimea hărții. Hărțile mai mici duc la jocuri mai scurte; hărțile mai mari întârzie primul contact între națiuni.</STRING>
			</ENTRY>
			<ENTRY name="MAX_PLAYERS">
				<STRING>{MAX. JUCĂTORI}: Clic aici pentru a stabili numărul maxim de jucători care pot intra în acest joc.</STRING>
			</ENTRY>
			<ENTRY name="CANNON_TIMES">
				<STRING>{TIMP TAMPON}: Clic ca să-i permiți fiecărui jucător să folosească „încetinirea extremă” pentru scurte perioade într-un joc multiplayer.</STRING>
			</ENTRY>
			<ENTRY name="GAME_RULES">
				<STRING>{REGULI}: Clic aici ca să alegi dacă jocul se va juca după reguli standard sau personalizate.</STRING>
			</ENTRY>
			<ENTRY name="GAME_SPEED">
				<STRING>{VITEZA JOCULUI}: Clic aici ca să setezi viteza jocului. Jucătorii mai experimentați pot dori ca timpul să treacă mai repede în joc.</STRING>
			</ENTRY>
		</COMBOBOX>
	</GAMESPYSTAGING>
	<TUTORIALWIN>
