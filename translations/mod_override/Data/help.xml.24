				<STRING>Clic pentru a alege stilul de hartă preferat.</STRING>
			</ENTRY>
			<ENTRY name="NUM_PLAYERS">
				<STRING>Clic pentru a alege numărul preferat de jucători.</STRING>
			</ENTRY>
			<PULLDOWN_ENTRIES>
				<ENTRY name="TEAM_STYLE0">
					<STRING>{Fără preferință}: Alege această opțiune dacă nu contează ce stil de echipe se folosește. Cu mai puține preferințe poți fi potrivit mai repede cu adversari.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE1">
					<STRING>{1v1}: Alege această opțiune dacă vrei să joci împotriva unui singur adversar.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE2">
					<STRING>{2v2}: Alege această opțiune dacă vrei să joci un joc pe echipe cu doi jucători de fiecare parte.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE3">
					<STRING>{3v3}: Alege această opțiune dacă vrei să joci un joc pe echipe cu trei jucători de fiecare parte.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE4">
					<STRING>{4v4}: Alege această opțiune dacă vrei să joci un joc pe echipe cu patru jucători de fiecare parte.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE5">
					<STRING>{Asasin}: Alege această opțiune dacă vrei să joci un joc Asasin cu doi sau mai mulți jucători, în care fiecare jucător primește o națiune țintă și e răsplătit dacă o elimină.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE6">
					<STRING>{Toți contra toți}: Alege această opțiune dacă vrei să joci un toți contra toți, în care trei sau mai multe națiuni se luptă pentru supremație.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE7">
					<STRING>{Diplomație}: Alege această opțiune dacă vrei să joci un joc Diplomație, în care trei sau mai multe națiuni se luptă pentru supremație, dar pot negocia alianțe și tratate de pace.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES0">
					<STRING>{Fără preferință}: Alege această opțiune dacă nu contează ce reguli de joc se folosesc. Cu mai puține preferințe poți fi potrivit mai repede cu adversari.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES1">
					<STRING>{Standard}: Alege această opțiune pentru a juca după regulile standard. Câștigi cucerindu-ți adversarii, construind Minuni sau controlând 70% din teritoriul lumii.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES2">
					<STRING>{Standard militar}: Alege această opțiune pentru a juca după regulile militare. Câștigi cucerindu-ți adversarii sau controlând 80% din teritoriul lumii. Victoria prin Minuni nu e permisă.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES3">
					<STRING>{Deathmatch}: Alege această opțiune pentru a juca un Deathmatch. Jucătorii încep în Epoca antică cu o rezervă uriașă din fiecare resursă.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES4">
					<STRING>{Deathmatch Epoca informației}: Alege această opțiune pentru a juca un Deathmatch în Epoca informației. Jucătorii încep cu toate tehnologiile standard cercetate și cu o rezervă uriașă din fiecare resursă. Armele nucleare și tehnologiile viitorului nu sunt permise.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES5">
					<STRING>{Fără asalt}: Alege această opțiune pentru a juca un joc Fără asalt. Se folosesc regulile standard, dar jucătorii încep în pace și nu se pot ataca până când cineva ajunge în Epoca prafului de pușcă.</STRING>
				</ENTRY>
				<ENTRY name="MAPSTYLES0">
					<STRING>Alege această opțiune dacă nu contează ce stil de hartă se folosește. Cu mai puține preferințe poți fi potrivit mai repede cu adversari.</STRING>
				</ENTRY>
			</PULLDOWN_ENTRIES>
			<ENTRY name="MAX_RATING">
				<STRING>Clic pentru a alege ratingul mediu maxim al adversarilor tăi.</STRING>
			</ENTRY>
			<ENTRY name="MIN_RATING">
				<STRING>Clic pentru a alege ratingul mediu minim al adversarilor tăi.</STRING>
			</ENTRY>
		</COMBOBOX>
