	<MAXPROFILELEN>
    18
  </MAXPROFILELEN>
	<CHAT>
		<AWAY>
			<ENTRY>/away (alias /back)</ENTRY>
			<ENTRY>Comută starea de absent. Jucătorii care îți scriu direct cât ești absent vor afla că nu ești disponibil. </ENTRY>
		</AWAY>
		<BROADCAST>
			<ENTRY>/broadcast {mesaj} (alias /b)</ENTRY>
			<ENTRY>Trimite un mesaj din camera de pregătire în chatul canalului din lobby</ENTRY>
			<ENTRY>Ex.: /b Salut tuturor, veniți în jocul meu!</ENTRY>
		</BROADCAST>
		<CHANNEL>
			<ENTRY>/channel {nume}  (alias /join)</ENTRY>
			<ENTRY>Setează canalul de chat curent.</ENTRY>
			<ENTRY>Ex.: /channel LobbyTurneu</ENTRY>
		</CHANNEL>
		<EMOTE>
			<ENTRY>/emote {mesaj}  (alias /me, /em)</ENTRY>
			<ENTRY>Trimite un mesaj de acțiune în chat.</ENTRY>
			<ENTRY>Ex.: /emote face cu mâna tuturor.</ENTRY>
		</EMOTE>
		<FRIENDS>
			<ENTRY>/friends {comandă} (alias /f)</ENTRY>
			<ENTRY>Accesează diversele comenzi de gestionare a prietenilor</ENTRY>
			<ENTRY>- list - Listează toți prietenii cunoscuți (alias l)</ENTRY>
			<ENTRY>- add {nume} - Adaugă un prieten în lista de prieteni (alias a)</ENTRY>
			<ENTRY>- remove {nume} - Scoate un prieten (alias r)</ENTRY>
			<ENTRY>- msg {mesaj} - Trimite un mesaj tuturor prietenilor (alias m)</ENTRY>
			<ENTRY>Ex.: /friends list</ENTRY>
			<ENTRY>/f add BHG_Masta</ENTRY>
			<ENTRY>/f m Jucăm un joc?</ENTRY>
		</FRIENDS>
		<OPTIONS>
			<ENTRY>/options</ENTRY>
			<ENTRY/>
		</OPTIONS>
		<IGNORE>
			<ENTRY>/squelch {utilizator}  (alias /ignore)</ENTRY>
			<ENTRY>Ignoră mesajele unui utilizator</ENTRY>
			<ENTRY>Ex.: /squelch BHG_Masta</ENTRY>
		</IGNORE>
		<UNIGNORE>
			<ENTRY>/unsquelch {utilizator} (alias /unignore)</ENTRY>
			<ENTRY>Permite primirea mesajelor de la un utilizator</ENTRY>
			<ENTRY>Ex.: /unsquelch BHG_Masta</ENTRY>
		</UNIGNORE>
		<WHISPER>
			<ENTRY>/whisper {utilizator} {mesaj}  (alias /w  /m  /msg)</ENTRY>
			<ENTRY>Trimite un mesaj privat unui utilizator.</ENTRY>
			<ENTRY>Ex.: /w BHG_Masta Jucăm un joc?</ENTRY>
		</WHISPER>
		<WHO>
			<ENTRY>/who</ENTRY>
			<ENTRY>Listează utilizatorii din canalul curent.</ENTRY>
		</WHO>
		<WHOIS>
			<ENTRY>/whois {utilizator}  (alias /where  /whereis /stats)</ENTRY>
			<ENTRY>Arată dacă jucătorul e online sau offline, unde se află și ce face.</ENTRY>
		</WHOIS>
		<WHOAMI>
			<ENTRY>/whoami</ENTRY>
			<ENTRY>Arată informațiile cunoscute despre utilizator.</ENTRY>
		</WHOAMI>
		<REJOIN>
			<ENTRY>/rejoin</ENTRY>
			<ENTRY>Resetează utilizatorul să primească doar chatul camerei de pregătire</ENTRY>
		</REJOIN>
		<TIME>
			<ENTRY>/time</ENTRY>
		</TIME>
		<TEAM>
			<ENTRY>/team [mesaj] (alias /t)</ENTRY>
			<ENTRY/>
		</TEAM>
		<USERS>
			<ENTRY>/users</ENTRY>
			<ENTRY/>
		</USERS>
		<HELP>
			<ENTRY>AJUTOR COMENZI CHAT:</ENTRY>
			<ENTRY>Iată lista comenzilor de chat disponibile.</ENTRY>
			<ENTRY>Scrie /help {comandă} pentru ajutor la o anumită comandă.</ENTRY>
		</HELP>
	</CHAT>
