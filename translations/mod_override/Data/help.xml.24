		<ENTRY name="ALEXANDER">
			<STRING>
				<BULLET/>+1 atac pentru toate unitățile din raza lui.            <BULLET/>Încă +2 atac pentru toată infanteria grea din raza lui.<BULLET/>Are dublu de măiestrie.<BULLET/>Unitățile aflate în Marșul forțat al lui Alexandru se deplasează cu 50% mai repede decât cu un general obișnuit.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="NAPOLEON">
			<STRING>
				<BULLET/>+3 atac și +1 rază pentru toate unitățile de asediu din raza lui.<BULLET/>Artileria din apropierea lui Napoleon se deplasează și se desfășoară mai repede.<BULLET/>Are dublu de măiestrie.<BULLET/>Unitățile aflate în Marșul forțat al lui Napoleon se deplasează cu 50% mai repede decât cu un general obișnuit.</STRING>
		</ENTRY>
		<ENTRY name="PARMENIO">
			<STRING>
				<BULLET/>+1 atac pentru toată cavaleria grea din raza lui.<BULLET/>Are o rază cu 50% mai mare decât a unui general obișnuit.<BULLET/>Ambuscada durează de 3 ori mai mult.<BULLET/>Începe bătăliile cu 5 Însoțitori în plus.</STRING>
		</ENTRY>
		<ENTRY name="ANTIPATER">
			<STRING>
				<BULLET/>Vindecă unitățile din raza lui.<BULLET/>Când e în garnizoana unei clădiri, clădirea are +3 atac.<BULLET/>Se poate retranșa oriunde.<BULLET/>Se retranșează de 2 ori mai repede decât un general obișnuit.<BULLET/>Unitățile retranșate de Antipatros primesc 80% din daunele normale.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="PTOLEMY">
			<STRING>
				<BULLET/>+1 rază și +1 câmp vizual pentru toate unitățile cu atac la distanță și de asediu din raza lui.<BULLET/>+1 atac pentru toate unitățile de asediu din raza lui.<BULLET/>+1 armură pentru toate unitățile din raza lui.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="DARIUS">
			<STRING>
				<BULLET/>+1 armură pentru toate unitățile din raza lui.            <BULLET/>Previne daunele de uzură pentru toate unitățile din raza lui.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="MEMNON">
			<STRING>
				<BULLET/>Mereu camuflat, ca un spion.<BULLET/>Își reface măiestria de 2 ori mai repede decât un general obișnuit.<BULLET/>Le dă Mercenarilor greci bonusuri mari de atac și armură.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="SPITAMENES">
			<STRING>
				<BULLET/>+1 atac pentru toți arcașii călare din raza lui.            <BULLET/>Bonus de viteză de 20% pentru toate unitățile de cavalerie.<BULLET/>Când e în apropiere, crește prada obținută din clădirile inamice și obține pradă și din unitățile inamice.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="CHANDRAGUPTA">
			<STRING>
				<BULLET/>Are de 2 ori mai multă măiestrie decât ceilalți generali unici.<BULLET/>Previne daunele de uzură pentru toate unitățile din raza lui.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="PORUS">
			<STRING>
				<BULLET/>Detectează unitățile camuflate, ca un cercetaș.<BULLET/>Are de 2 ori mai multe puncte de viață decât ceilalți generali unici.<BULLET/>Creează de 2 ori mai multe momeli decât un general obișnuit.<BULLET/>Permite crearea de elefanți de război la Grajd.<BULLET/>Bonus de viteză de 20% pentru toate trupele de elefanți de război.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="WELLINGTON">
			<STRING>
				<BULLET/>Rază de efect dublă.<BULLET/>Vindecă unitățile din raza lui.<BULLET/>+1 apărare și +1 atac împotriva unităților de asediu și a carelor de provizii pentru unitățile din raza lui.<BULLET/>Dezactivează resursele strategice inamice în timpul bătăliilor, cât timp este în viață.<!--Alexander-->
			</STRING>
		</ENTRY>
		<ENTRY name="CHARLES">
			<STRING>
				<BULLET/>Face toate unitățile mai ieftine cât timp este în viață.<BULLET/>Accelerează cu 20% toate unitățile din raza lui.</STRING>
		</ENTRY>
		<ENTRY name="DJEZZAR">
			<STRING>
				<BULLET/>Dă +1 atac tuturor unităților din raza lui.            <BULLET/>Începe bătăliile din Cucerește lumea cu o armată de început suplimentară.</STRING>
		</ENTRY>
		<ENTRY name="FOUCHE">
			<STRING>
				<BULLET/>Infanterie de elită lăsată de un elicopter de transport de la o bază aeriană (Desant aerian). Mai rezistentă, mai rapidă și mai bine blindată decât infanteria de asalt; poate cuceri orașe.</STRING>
		</ENTRY>
		<ENTRY name="SCHWARZENBERG">
			<STRING>
				<BULLET/>Doboară rachetele nucleare inamice. Fiecare siloz de rachete ține până la 2 și lansează singur câte unul asupra fiecărei rachete nucleare sau ICBM inamice care zboară în raza lui, dacă o mai poate prinde. O rachetă nucleară doborâtă nu face daune și nu contează pentru Armaghedon.</STRING>
		</ENTRY>
		<ENTRY name="BLUCHER">
			<STRING>
				<BULLET/>+2 atac, +2 armură și bonus de viteză de 20% pentru toate unitățile de grajd din raza lui.          <BULLET/>Începe cu cavalerie suplimentară.</STRING>
		</ENTRY>
		<ENTRY name="KUTOSOV">
			<STRING>
				<BULLET/>Previne uzura unităților din raza lui.<BULLET/>Creează de trei ori mai multe momeli decât în mod normal.<BULLET/>Are rază de efect triplă.</STRING>
		</ENTRY>
		<ENTRY name="PAOLI">
			<STRING>
				<BULLET/>Are dublu de puncte de viață.<BULLET/>Poate trage instantaneu ca lunetist și poate sabota instantaneu.</STRING>
		</ENTRY>
		<ENTRY name="DARIUSCHARIOT">
			<STRING>
				<BULLET/>{Cavalerie de tragere} unică a generalului Darius, Epoca clasică #ICON28 - cavalerie de tragere rapidă, care poate trage chiar și din mers; deosebit de eficientă împotriva oricărei alte cavalerii de tragere.<!--Chariot-->
			</STRING>
		</ENTRY>
		<ENTRY name="THEDESPOT">
			<STRING>
				<BULLET/>Are toate puterile normale ale unui general (spor de armură, abilități speciale), dar este imun la lunetiști și la mituire.<BULLET/>Acționează ca un car de provizii.<BULLET/>Câmp vizual foarte mare.<BULLET/>Dublează prada din clădirile inamice distruse în raza lui și dă pradă și din unitățile inamice.</STRING>
		</ENTRY>
		<ENTRY name="THESENATOR">
			<STRING>
				<BULLET/>Are toate puterile normale ale unui general (spor de armură, abilități speciale), dar este imun la lunetiști și la mituire.<BULLET/>Clădirile din raza lui primesc +5 armură.<BULLET/>Poate mitui unități inamice, ca un spion.<BULLET/>Clădirile și trupele din raza lui se vindecă pe teritoriu prietenesc.</STRING>
		</ENTRY>
		<ENTRY name="THEMONARCH">
			<STRING>
				<BULLET/>Are toate puterile normale ale unui general (spor de armură, abilități speciale), dar este imun la lunetiști și la mituire.<BULLET/>Acționează ca un car de provizii.<BULLET/>Unitățile de asediu din raza lui se deplasează și se desfășoară de 2 ori mai repede.<BULLET/>Unitățile călare din raza lui au încă +2 atac și +2 armură.</STRING>
		</ENTRY>
		<ENTRY name="THEPRESIDENT">
			<STRING>
				<BULLET/>Are toate puterile normale ale unui general (spor de armură, abilități speciale), dar este imun la lunetiști și la mituire.<BULLET/>Clădirile care produc unități din raza lui produc de 2 ori mai repede.<BULLET/>Clădirile în construcție din raza lui se construiesc cu 33% mai repede.<BULLET/>Clădirile și trupele din raza lui se vindecă pe teritoriu prietenesc sau neutru.</STRING>
		</ENTRY>
		<ENTRY name="THECITIZEN">
			<STRING>
				<BULLET/>Are toate puterile normale ale unui general (spor de armură, abilități speciale), dar este imun la lunetiști și la mituire.<BULLET/>Acționează ca un car de provizii.<BULLET/>Toate unitățile prietene din raza lui au +2 atac și +2 armură.<BULLET/>Orașele inamice din raza lui se asimilează de 4 ori mai repede.</STRING>
		</ENTRY>
		<ENTRY name="THECEO">
			<STRING>
				<BULLET/>Are toate puterile normale ale unui general (spor de armură, abilități speciale), dar este imun la lunetiști și la mituire.<BULLET/>Clădirile și trupele din raza lui se vindecă atâta timp cât nu suferă daune de uzură.<BULLET/>Unitățile prietene din raza lui sunt imune la mituire și la lunetiști.<BULLET/>Toate unitățile prietene din raza lui au +4 rază și câmp vizual (cu excepția unităților de asediu).</STRING>
