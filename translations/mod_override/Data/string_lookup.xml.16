	<CAT hash="30698867">
		<STRING hash="66457806" hash_i="66439508" needed="1">Respingi il nemico per 15 minuti.</STRING>
		<STRING hash="41980852" hash_i="42056244" needed="1">Conquista la capitale del nemico.</STRING>
		<STRING hash="90105976" hash_i="90090548" needed="1">Trova e conquista la capitale del nemico.</STRING>
		<STRING hash="36412767" hash_i="36398297" needed="1">Distruggi l'esercito nemico.</STRING>
		<STRING hash="49582913" hash_i="49658305" needed="1">Conquista qualsiasi città barbara.</STRING>
		<STRING hash="51377575" hash_i="51363105" needed="1">Sconfiggi le tribù barbare.</STRING>
		<STRING hash="208440775" hash_i="208516167" needed="1">Sconfiggi il nemico occupandone il territorio o conquistandone la capitale.</STRING>
		<STRING hash="164281570" hash_i="164356962" needed="1">Sconfiggi gli avversari conquistando una città per ogni nazione nemica.</STRING>
		<STRING hash="59485593" hash_i="59471123" needed="1">Distruggi l'accampamento nemico.</STRING>
		<STRING hash="37152612" hash_i="37138142" needed="1">Sconfiggi l'esercito invasore.</STRING>
		<STRING hash="66307671" hash_i="66289373" needed="1">Respingi il nemico per 30 minuti.</STRING>
		<STRING hash="74894997" hash_i="74880527" needed="1">Difendi la tua capitale per 15 minuti.</STRING>
		<STRING hash="115951391" hash_i="115933093" needed="1">Respingi il nemico fino allo scadere del timer.</STRING>
		<STRING hash="119025659" hash_i="120479815" needed="1">Conquista la capitale nemica in $NUM0 minuti.</STRING>
		<STRING hash="172875505" hash_i="175801469" needed="1">Conquista la capitale nemica o resisti per $NUM0 minuti.</STRING>
		<STRING hash="137773498" hash_i="139438982" needed="1">Conquista una o più capitali del nemico entro $NUM0 minuti.</STRING>
		<STRING hash="177875231" hash_i="182163563" needed="1">Conquista una o più capitali del nemico o resisti per $NUM0 minuti.</STRING>
		<STRING hash="178310682" hash_i="178295254" needed="1">Trova e conquista la capitale del nemico entro 120 minuti.</STRING>
