	<CAT hash="44397162">
		<STRING hash="34157738" hash_i="34133086" needed="1">Hai vinto la battaglia.</STRING>
		<STRING hash="82012261" hash_i="81987609" needed="1">Hai sconfitto i Mercenari.</STRING>
		<STRING hash="113504005" hash_i="113479353" needed="1">Hai sconfitto tutte le tribù nomadi.</STRING>
		<STRING hash="84115919" hash_i="84091267" needed="1">Hai sconfitto i Mercenari.</STRING>
		<STRING hash="111333699" hash_i="111309047" needed="1">Hai attraversato il deserto con successo!</STRING>
		<STRING hash="29337395" hash_i="29467319" needed="1">Hai unificato Greece.</STRING>
		<STRING hash="35815269" hash_i="36034993" needed="1">Hai conquistato Egitto.</STRING>
		<STRING hash="54706888" hash_i="54996578" needed="1">Hai sconfitto i Magadha.</STRING>
		<STRING hash="36085555" hash_i="36248479" needed="1">Hai conquistato India.</STRING>
		<STRING hash="51797082" hash_i="52086772" needed="1">Hai sconfitto i Maurya.</STRING>
		<STRING hash="48942727" hash_i="50799331" needed="1">Hai protetto Alessandro!</STRING>
		<STRING hash="62405071" hash_i="62752721" needed="1">Hai collezionato sufficiente Metallo.</STRING>
		<STRING hash="42159644" hash_i="42134992" needed="1">Hai colonizzato nuove terre.</STRING>
		<STRING hash="43452384" hash_i="43427732" needed="1">Hai vinto la guerra commerciale.</STRING>
		<STRING hash="20511596" hash_i="20486944" needed="1">Hai avuto successo.</STRING>
		<STRING hash="53554556" hash_i="53529904" needed="1">Hai fermato gli invasori.</STRING>
		<STRING hash="80249280" hash_i="80224628" needed="1">Hai sconfitto i Mercenari!</STRING>
		<STRING hash="186815686" hash_i="187150976" needed="1">La maggior parte delle rivolte si è spenta. Il tuo potere è intatto.</STRING>
		<STRING hash="64785017" hash_i="64769589" needed="1">Francia ha rovesciato la monarchia.</STRING>
		<STRING hash="44813056" hash_i="44788404" needed="1">Hai attraversato il deserto.</STRING>
		<STRING hash="67275366" hash_i="67250714" needed="1">Hai sconfitto i briganti.</STRING>
		<STRING hash="31182624" hash_i="31157972" needed="1">Hai vinto la battaglia.</STRING>
		<STRING hash="31208788" hash_i="31184136" needed="1">Hai vinto la battaglia.</STRING>
		<STRING hash="56459057" hash_i="56434405" needed="1">Hai completato la missione.</STRING>
	</CAT>
	<CAT hash="38438024">
		<STRING hash="37310381" hash_i="37285729" needed="1">Hai perso la battaglia.</STRING>
		<STRING hash="886320487" hash_i="884168747" needed="1">I tuoi eserciti non hanno incontrato alcuna resistenza durante l'occupazione del territorio. Gli indigeni si sono tuttavia raccolti e stanno assalendo il tuo nuovo avamposto. Per ottenere la vittoria, devi difendere la tua capitale fino allo scadere del timer.</STRING>
		<STRING hash="460127993" hash_i="464950815" needed="1">Il tuo esercito si sta avvicinando a un esercito barbaro. Per vincere, devi attaccare il loro accampamento e distruggerne tutte le costruzioni.</STRING>
		<STRING hash="699657885" hash_i="699635379" needed="1">Le nazioni barbare presenti in questa regione sono deboli e pronte ad inginocchiarsi davanti alla tua nazione, se riuscirai a dimostrarne la superiorità conquistando una delle loro città.</STRING>
		<STRING hash="782757605" hash_i="781563091" needed="1">In questo territorio vi sono numerose tribù indigene in lotta per il potere. Utilizza le tue abilità diplomatiche per metterle una contro l'altra e assicurarti il dominio sull'area.</STRING>
		<STRING hash="1041644836" hash_i="1049167724" needed="1">Alcune delle tribù barbare che abitano questa regione si sono alleate per distruggerti. Fortunatamente, hai a disposizione ulteriori rifornimenti e i barbari sono indietro di un'età. Per ottenere la vittoria, devi sopravvivere fino allo scadere del timer.</STRING>
		<STRING hash="34211834" hash_i="34187182" needed="1">Hai perso la battaglia.</STRING>
		<STRING hash="85798563" hash_i="85776057" needed="1">I Mercenari ti hanno sopraffatto.</STRING>
		<STRING hash="174879179" hash_i="174854527" needed="1">Non sei stato in grado di sconfiggere tutte le tribù nomadi.</STRING>
		<STRING hash="86459437" hash_i="86436931" needed="1">I Mercenari ti hanno sopraffatto.</STRING>
		<STRING hash="450505024" hash_i="450480372" needed="1">Sei morto nelle sabbie, dove le tue ossa andrebbero in pasto agli avvoltoi, se solo non fosse troppo caldo anche per loro.</STRING>
		<STRING hash="60237741" hash_i="60592993" needed="1">Hai fallito la missione di riunificazione di Greece.</STRING>
		<STRING hash="84636528" hash_i="87379740" needed="1">Hai fallito la missione di protezione di Alessandro!</STRING>
		<STRING hash="67149673" hash_i="67515349" needed="1">Non hai accumulato sufficienti unità di Metallo.</STRING>
		<STRING hash="65336844" hash_i="65312192" needed="1">I tuoi colonizzatori sono stati sconfitti.</STRING>
		<STRING hash="29252721" hash_i="29228069" needed="1">Sei stato sconfitto.</STRING>
		<STRING hash="35405839" hash_i="37285729" needed="1">Hai perso la battaglia.</STRING>
		<STRING hash="46968490" hash_i="46943838" needed="1">Hai perso la guerra commerciale.</STRING>
		<STRING hash="62200690" hash_i="62176038" needed="1">La tua gente sta morendo di fame.</STRING>
		<STRING hash="70563669" hash_i="70541163" needed="1">Gli invasori ti hanno sopraffatto.</STRING>
		<STRING hash="37290612" hash_i="37265960" needed="1">Sei morto nelle sabbie.</STRING>
		<STRING hash="70807061" hash_i="70784555" needed="1">I briganti ti hanno sopraffatto.</STRING>
		<STRING hash="34157738" hash_i="34133086" needed="1">Hai vinto la battaglia.</STRING>
		<STRING hash="40929481" hash_i="40904829" needed="1">Hai perso la battaglia.</STRING>
		<STRING hash="44917033" hash_i="44892381" needed="1">Hai fallito la missione.</STRING>
		<STRING hash="444407072" hash_i="444382420" needed="1">Sei morto nelle sabbie, dove le tue ossa andrebbero in pasto agli avvoltoi, se solo non fosse troppo caldo anche per loro.</STRING>
		<STRING hash="55704156" hash_i="55679504" needed="1">Sei morto nelle sabbie.</STRING>
		<STRING hash="79414608" hash_i="79392102" needed="1">I Mercenari ti hanno abbandonato.</STRING>
	</CAT>
