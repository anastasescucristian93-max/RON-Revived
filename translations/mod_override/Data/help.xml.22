			</ENTRY>
			<ENTRY name="NOTICE_VICTORY_TIMER">
				<STRING>Marque esta caixa para ser avisado quando um cronômetro de vitória começar ou parar.</STRING>
			</ENTRY>
			<ENTRY name="NOTICE_WE_LOSE_CITY">
