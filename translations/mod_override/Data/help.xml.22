			</ENTRY>
			<ENTRY name="SEND">
				<STRING>Clique para enviar uma mensagem de chat aos outros jogadores desta sala.</STRING>
			</ENTRY>
			<ENTRY name="IGNORE_LIST">
				<STRING>Mostra a lista de jogadores que você está ignorando no momento.</STRING>
			</ENTRY>
			<ENTRY name="REMOVE">
				<STRING>Clique para remover a pessoa selecionada da sua Lista de amigos.</STRING>
			</ENTRY>
			<ENTRY name="ADD">
				<STRING>Clique para adicionar alguém à sua Lista de Amigos.</STRING>
			</ENTRY>
		</BUTTON>
		<CHECKBOX>
			<ENTRY name="FAVOR_BUDDIES">
				<STRING>Marque esta caixa para aumentar a chance de jogar com as pessoas da sua Lista de amigos.</STRING>
			</ENTRY>
			<ENTRY name="RATED">
				<STRING>Marque esta caixa para jogar partidas ranqueadas contra seus oponentes.</STRING>
			</ENTRY>
			<ENTRY name="STRICT_MATCHING">
				<STRING>Marque esta caixa para entrar apenas em partidas que correspondam exatamente às suas preferências. Se esta caixa não estiver marcada, o jogo tentará colocá-lo rapidamente com outros jogadores, mesmo que as suas preferências não correspondam com exatidão.</STRING>
			</ENTRY>
			<ENTRY name="PREVENT_HOSTING">
				<STRING>Marque esta caixa se você não quiser que o seu computador atue como host em nenhum momento. Experimente esta opção se estiver tendo problemas para jogar a Partida rápida.</STRING>
			</ENTRY>
		</CHECKBOX>
		<COMBOBOX>
			<ENTRY name="TRIBE">
				<STRING>Clique para selecionar a nação com a qual você vai jogar.</STRING>
			</ENTRY>
			<ENTRY name="GAME_RULES">
				<STRING>Clique para selecionar as regras de jogo que você prefere.</STRING>
			</ENTRY>
			<ENTRY name="TEAM_STYLE">
				<STRING>Clique para selecionar o tipo de equipe que você prefere.</STRING>
			</ENTRY>
			<ENTRY name="MAP_STYLE">
				<STRING>Clique para selecionar o tipo de mapa que você prefere.</STRING>
			</ENTRY>
			<ENTRY name="NUM_PLAYERS">
				<STRING>Clique para selecionar o número de jogadores que você prefere.</STRING>
			</ENTRY>
			<PULLDOWN_ENTRIES>
				<ENTRY name="TEAM_STYLE0">
					<STRING>{Sem preferência}: Selecione esta opção se não importa qual tipo de equipe será usado. Especificar menos preferências pode acelerar a busca por oponentes.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE1">
					<STRING>{1x1}: Selecione esta opção se você quiser jogar contra um único oponente.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE2">
					<STRING>{2x2}: Selecione esta opção se você quiser jogar uma partida em equipe com dois jogadores de cada lado.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE3">
					<STRING>{3x3}: Selecione esta opção se você quiser jogar uma partida em equipe com três jogadores de cada lado.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE4">
					<STRING>{4x4}: Selecione esta opção se você quiser jogar uma partida em equipe com quatro jogadores de cada lado.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE5">
					<STRING>{Assassino}: Selecione esta opção se você quiser jogar uma partida Assassino com dois ou mais jogadores, na qual cada jogador recebe uma nação-alvo e é recompensado por eliminá-la.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE6">
					<STRING>{Todos contra todos}: Selecione esta opção se você quiser jogar um todos contra todos, no qual três ou mais nações guerreiam pela supremacia.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE7">
					<STRING>{Diplomacia}: Selecione esta opção se você quiser jogar uma partida de Diplomacia, na qual três ou mais nações disputam a supremacia, mas podem negociar alianças e tratados de paz.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES0">
					<STRING>{Sem preferência}: Selecione esta opção se não importa quais regras de jogo serão usadas. Especificar menos preferências pode acelerar a busca por oponentes.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES1">
					<STRING>{Padrão}: Selecione esta opção para jogar com as regras padrão. Você vence conquistando seus oponentes, construindo Maravilhas ou controlando 70% do território do mundo.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES2">
					<STRING>{Militar padrão}: Selecione esta opção para jogar com as regras Militares. Você vence conquistando seus oponentes ou controlando 80% do território do mundo. A vitória por Maravilhas não é permitida.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES3">
					<STRING>{Deathmatch}: Selecione esta opção para jogar um Deathmatch. Os jogadores começam na Idade Antiga com uma enorme reserva de cada recurso.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES4">
					<STRING>{Deathmatch Era da Informação}: Selecione esta opção para jogar um Deathmatch na Era da Informação. Os jogadores começam com todas as tecnologias padrão pesquisadas e uma enorme reserva de cada recurso. Não são permitidas armas nucleares nem tecnologias futuras.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES5">
					<STRING>{Sem rush}: Selecione esta opção para jogar uma partida Sem rush. São usadas as regras padrão, mas os jogadores começam em paz e não podem atacar uns aos outros até que alguém chegue à Idade da Pólvora.</STRING>
				</ENTRY>
				<ENTRY name="MAPSTYLES0">
					<STRING>Selecione esta opção se não importa qual tipo de mapa será usado. Especificar menos preferências pode acelerar a busca por oponentes.</STRING>
				</ENTRY>
			</PULLDOWN_ENTRIES>
			<ENTRY name="MAX_RATING">
				<STRING>Clique para selecionar o rating médio máximo dos seus oponentes.</STRING>
			</ENTRY>
			<ENTRY name="MIN_RATING">
				<STRING>Clique para selecionar o rating médio mínimo dos seus oponentes.</STRING>
			</ENTRY>
		</COMBOBOX>
	</GAMESPYQM>
	<GAMESPYQMINVITE>
		<LISTBOX>
			<ENTRY name="PLAYERS">
				<STRING>Clique para selecionar um jogador da lista de jogadores disponíveis on-line. Um clique duplo convida esse jogador para ser seu companheiro de equipe e fecha a janela.</STRING>
			</ENTRY>
		</LISTBOX>
		<BUTTON>
			<ENTRY name="INVITE">
				<STRING>Clique para convidar o jogador selecionado para ser seu companheiro de equipe nesta partida.</STRING>
			</ENTRY>
			<ENTRY name="CANCEL">
				<STRING>Clique para fechar esta janela sem convidar nenhum companheiro de equipe.</STRING>
			</ENTRY>
		</BUTTON>
	</GAMESPYQMINVITE>
	<GAMESPYCHOICE>
		<BUTTON>
			<ENTRY name="QUICKMATCH">
				<STRING>     Clique para configurar uma Partida rápida com ranking (recomendado). Você será colocado automaticamente com outros jogadores com base no tipo de partida que prefere e no nível de habilidade dos jogadores que procuram partidas.</STRING>
			</ENTRY>
			<ENTRY name="LOBBY">
				<STRING>     Clique para entrar no lobby. No lobby, você pode hospedar uma partida sem ranking com as configurações que quiser, ou entrar em uma partida hospedada por outro jogador.</STRING>
			</ENTRY>
		</BUTTON>
		<SPOT>
			<ENTRY name="CHOICE_SPOT0">
				<STRING>     Clique para configurar uma Partida rápida (recomendado). Você será colocado automaticamente com outros jogadores com base no tipo de partida que prefere e no nível de habilidade dos jogadores que procuram partidas.</STRING>
			</ENTRY>
			<ENTRY name="CHOICE_SPOT1">
				<STRING>     Clique para entrar no lobby. No lobby, você pode hospedar uma partida com as configurações que quiser, ou entrar em uma partida hospedada por outro jogador.</STRING>
			</ENTRY>
		</SPOT>
	</GAMESPYCHOICE>
	<MAXPROFILELEN>
    18
  </MAXPROFILELEN>
	<CHAT>
		<AWAY>
			<ENTRY>/away (alias /back)</ENTRY>
			<ENTRY>Ativa ou desativa o seu status de ausente. Os jogadores que lhe enviarem mensagens diretas enquanto você estiver ausente serão avisados de que você não está disponível. </ENTRY>
		</AWAY>
		<BROADCAST>
			<ENTRY>/broadcast {mensagem} (alias /b)</ENTRY>
			<ENTRY>Envia uma mensagem de dentro da sala de preparação para o chat do canal do lobby</ENTRY>
			<ENTRY>Ex.: /b Ei, pessoal, venham jogar na minha partida!</ENTRY>
		</BROADCAST>
		<CHANNEL>
			<ENTRY>/channel {nome}  (alias /join)</ENTRY>
			<ENTRY>Define o seu canal de chat atual.</ENTRY>
			<ENTRY>Ex.: /channel LobbyTorneio</ENTRY>
		</CHANNEL>
		<EMOTE>
			<ENTRY>/emote {mensagem}  (alias /me, /em)</ENTRY>
			<ENTRY>Envia uma mensagem de ação para o chat.</ENTRY>
			<ENTRY>Ex.: /emote acena para todos.</ENTRY>
		</EMOTE>
		<FRIENDS>
			<ENTRY>/friends {comando} (alias /f)</ENTRY>
			<ENTRY>Acessa os vários comandos de gerenciamento de amigos</ENTRY>
			<ENTRY>- list - Lista todos os amigos conhecidos (alias l)</ENTRY>
			<ENTRY>- add {nome} - Adiciona um amigo à lista de amigos (alias a)</ENTRY>
			<ENTRY>- remove {nome} - Remove um amigo (alias r)</ENTRY>
			<ENTRY>- msg {mensagem} - Envia uma mensagem a todos os amigos (alias m)</ENTRY>
			<ENTRY>Ex.: /friends list</ENTRY>
			<ENTRY>/f add BHG_Masta</ENTRY>
			<ENTRY>/f m Quer jogar uma partida?</ENTRY>
		</FRIENDS>
		<OPTIONS>
			<ENTRY>/options</ENTRY>
			<ENTRY/>
		</OPTIONS>
		<IGNORE>
			<ENTRY>/squelch {usuário}  (alias /ignore)</ENTRY>
			<ENTRY>Ignora as mensagens de um usuário</ENTRY>
			<ENTRY>Ex.: /squelch BHG_Masta</ENTRY>
		</IGNORE>
		<UNIGNORE>
			<ENTRY>/unsquelch {usuário} (alias /unignore)</ENTRY>
			<ENTRY>Permite receber mensagens de um usuário</ENTRY>
			<ENTRY>Ex.: /unsquelch BHG_Masta</ENTRY>
		</UNIGNORE>
		<WHISPER>
			<ENTRY>/whisper {usuário} {mensagem}  (alias /w  /m  /msg)</ENTRY>
			<ENTRY>Envia uma mensagem privada a um usuário.</ENTRY>
			<ENTRY>Ex.: /w BHG_Masta Quer jogar uma partida?</ENTRY>
		</WHISPER>
		<WHO>
			<ENTRY>/who</ENTRY>
			<ENTRY>Lista os usuários do canal atual.</ENTRY>
		</WHO>
		<WHOIS>
			<ENTRY>/whois {usuário}  (alias /where  /whereis /stats)</ENTRY>
			<ENTRY>Mostra se o jogador está on-line ou off-line, onde está e o que está fazendo.</ENTRY>
		</WHOIS>
		<WHOAMI>
			<ENTRY>/whoami</ENTRY>
			<ENTRY>Mostra as informações conhecidas do usuário.</ENTRY>
		</WHOAMI>
		<REJOIN>
			<ENTRY>/rejoin</ENTRY>
			<ENTRY>Faz o usuário voltar a receber apenas o chat da sala de preparação</ENTRY>
		</REJOIN>
		<TIME>
			<ENTRY>/time</ENTRY>
		</TIME>
		<TEAM>
			<ENTRY>/team [mensagem] (alias /t)</ENTRY>
			<ENTRY/>
		</TEAM>
		<USERS>
			<ENTRY>/users</ENTRY>
			<ENTRY/>
		</USERS>
		<HELP>
			<ENTRY>AJUDA DOS COMANDOS DE CHAT:</ENTRY>
			<ENTRY>Esta é a lista dos comandos de chat disponíveis.</ENTRY>
			<ENTRY>Digite /help {comando} para obter ajuda sobre um comando específico.</ENTRY>
		</HELP>
	</CHAT>
