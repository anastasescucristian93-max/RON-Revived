			</ENTRY>
			<ENTRY name="NOTICE_NUKES_RESEARCHED">
				<STRING>Marque esta caixa para ser avisado quando a pesquisa de mísseis nucleares começar e terminar.</STRING>
			</ENTRY>
			<ENTRY name="NOTICE_NUKE_LAUNCHED">
