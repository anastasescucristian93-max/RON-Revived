			</ENTRY>
			<ENTRY name="NOTICE_I_NEW_AGE">
				<STRING>Marque esta caixa para ser avisado quando você chegar a uma nova era.</STRING>
			</ENTRY>
			<ENTRY name="NOTICE_FUTURE_TECH_RESEARCHED">
