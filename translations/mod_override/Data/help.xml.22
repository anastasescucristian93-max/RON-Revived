		</ENTRY>
		<SPOT>
			<ENTRY name="DEFCON">
				<STRING>Medidor de DEFCON<SPACE/>O nível atual de DEFCON é $NUM0. Quanto menor o nível, maior o perigo de uma guerra termonuclear global.</STRING>
			</ENTRY>
			<ENTRY name="NUM_NUKES">
				<STRING>Arsenal de mísseis nucleares<SPACE/>No momento, você tem $NUM0 míssil(eis) nuclear(es).</STRING>
			</ENTRY>
			<ENTRY name="NUM_NUKES_SINGULAR">
				<STRING>Arsenal de mísseis nucleares<SPACE/>No momento, você tem $NUM0 míssil(eis) nuclear(es).</STRING>
			</ENTRY>
			<ENTRY name="OPP_NUM_NUKES">
				<STRING>Arsenal de mísseis nucleares<SPACE/>No momento, seu inimigo tem $NUM0 míssil(eis) nuclear(es).</STRING>
			</ENTRY>
