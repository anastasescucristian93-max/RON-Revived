			</ENTRY>
			<ENTRY name="ARROW_RIGHT"/>
			<ENTRY name="RESOURCE_SCROLLBUT2"/>
			<ENTRY name="RESOURCE_SCROLLBUT1"/>
			<ENTRY name="BUILD_BUTTON">
				<STRING>Aprimorar força do território<SPACE/>Clique para aprimorar a força de um território, o que gera cidades e edifícios extras nas batalhas defensivas.<SPACE/>É preciso mais Tributo.</STRING>
			</ENTRY>
			<ENTRY name="RANDOM_CARD">
				<STRING>Comprar carta de bônus<SPACE/>Tributo: {$NUM0}<SPACE/>Clique para comprar uma carta de bônus. Serão oferecidas três cartas para você escolher.<SPACE/>É preciso mais Tributo.</STRING>
			</ENTRY>
			<ENTRY name="FOOD">
				<STRING>Renda de recursos raros<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Esta renda vem dos recursos raros nos territórios que você controla. Esses recursos concedem poderes bônus e renda durante as batalhas de Conquista.</STRING>
			</ENTRY>
			<ENTRY name="TIMBER">
				<STRING>Renda de recursos raros<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Esta renda vem dos recursos raros nos territórios que você controla. Esses recursos concedem poderes bônus e renda durante as batalhas de Conquista.</STRING>
			</ENTRY>
			<ENTRY name="WEALTH">
				<STRING>Renda de recursos raros<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Esta renda vem dos recursos raros nos territórios que você controla. Esses recursos concedem poderes bônus e renda durante as batalhas de Conquista.</STRING>
			</ENTRY>
			<ENTRY name="METAL">
				<STRING>Renda de recursos raros<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Esta renda vem dos recursos raros nos territórios que você controla. Esses recursos concedem poderes bônus e renda durante as batalhas de Conquista.</STRING>
			</ENTRY>
			<ENTRY name="KNOWLEDGE">
				<STRING>Renda de recursos raros<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Esta renda vem dos recursos raros nos territórios que você controla. Esses recursos concedem poderes bônus e renda durante as batalhas de Conquista.</STRING>
			</ENTRY>
			<ENTRY name="OIL">
				<STRING>Renda de recursos raros<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Esta renda vem dos recursos raros nos territórios que você controla. Esses recursos concedem poderes bônus e renda durante as batalhas de Conquista.</STRING>
			</ENTRY>
			<ENTRY name="ARROW_LEFT"/>
