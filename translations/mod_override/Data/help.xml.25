			</ENTRY>
		</EDITBOX>
		<LISTBOX>
			<ENTRY name="PLAYERS">
				<STRING>Список игроков в этой комнате.</STRING>
			</ENTRY>
			<ENTRY name="BUDDYLIST">
				<STRING>Список ваших друзей.</STRING>
			</ENTRY>
		</LISTBOX>
		<CHECKBOX>
			<ENTRY name="REQUIRE_RANDOM_TEAMS">
				<STRING>{СЛУЧАЙНЫЕ КОМАНДЫ}: игроки не могут сами выбирать союзников по команде — они должны выбрать {«?»}.</STRING>
			</ENTRY>
			<ENTRY name="FREE_PAUSE">
				<STRING>{СВОБОДНАЯ ПАУЗА}: отметьте, чтобы игроки могли прокручивать экран и отдавать приказы во время паузы. В одиночной игре этот режим включён всегда, а в сетевой его нужно выбрать здесь.</STRING>
			</ENTRY>
			<ENTRY name="TURBO_RESOURCES">
				<STRING>{ТУРБО-РЕСУРСЫ}: отметьте, чтобы ускорить сбор ресурсов. Этот вариант для игроков, которые хотят меньше заниматься сбором ресурсов и больше времени уделять другим сторонам игры.</STRING>
			</ENTRY>
			<ENTRY name="TOURNAMENT_PLAY">
				<STRING>{ТУРНИР}: отметьте, чтобы скрыть выбор наций игроков до начала игры и их счёт во время игры. Игроки, сдавшиеся раньше, не видят всю карту до конца игры.</STRING>
			</ENTRY>
			<ENTRY name="REQUIRE_RANDOM_NATIONS">
				<STRING>{СЛУЧАЙНЫЕ НАЦИИ}: игроки не могут выбрать конкретную нацию — они должны выбрать {Случайно}.</STRING>
			</ENTRY>
		</CHECKBOX>
		<COMBOBOX>
			<ENTRY name="TEAM_STYLE">
				<STRING>{КОМАНДЫ И СОЮЗНИКИ}: нажмите здесь, чтобы выбрать, будут ли нации объединены в команды и как, а также могут ли союзы меняться во время игры.</STRING>
			</ENTRY>
			<ENTRY name="MAP_STYLE">
				<STRING>{ТИП КАРТЫ}: нажмите здесь, чтобы выбрать тип карты. Каждый тип карты задаёт свой характер игры и свою стратегическую обстановку.</STRING>
			</ENTRY>
			<ENTRY name="MAP_SIZE">
				<STRING>{РАЗМЕР КАРТЫ}: нажмите здесь, чтобы выбрать размер карты. На маленьких картах игры идут быстрее, на больших нации позже встречаются друг с другом.</STRING>
			</ENTRY>
			<ENTRY name="MAX_PLAYERS">
				<STRING>{МАКС. ИГРОКОВ}: нажмите здесь, чтобы задать наибольшее число игроков, которые могут присоединиться к этой игре.</STRING>
			</ENTRY>
			<ENTRY name="CANNON_TIMES">
				<STRING>{РЕЗЕРВНОЕ ВРЕМЯ}: нажмите, чтобы разрешить каждому игроку ненадолго включать «сверхзамедление» в сетевой игре.</STRING>
			</ENTRY>
			<ENTRY name="GAME_RULES">
				<STRING>{ПРАВИЛА}: нажмите здесь, чтобы выбрать, будет ли игра идти по стандартным или особым правилам.</STRING>
			</ENTRY>
			<ENTRY name="GAME_SPEED">
				<STRING>{СКОРОСТЬ ИГРЫ}: нажмите здесь, чтобы задать скорость игры. Опытные игроки могут захотеть, чтобы время в игре шло быстрее.</STRING>
			</ENTRY>
		</COMBOBOX>
	</GAMESPYSTAGING>
