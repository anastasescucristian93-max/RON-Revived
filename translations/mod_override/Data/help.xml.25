<!-- edited with XML Spy v4.4 U (http://www.xmlspy.com) by Scott Lewis (Big Huge Games) --><!-- edited with XMLSPY v5 rel. 2 U (http://www.xmlspy.com) by Mark Sobota (Big Huge Games) --><!-- LOCALIZATION: STRING elements--><!-- LOCALIZATION: MAXPROFILELEN is an integer value that limits the # of characters allowed in the profile name.  Changing it to a string value will cause errors.--><ROOT>
	<TRIBES>
		<ENTRY name="TRIBE">
			<STRING>{НАЦИЯ}: нажмите здесь, чтобы выбрать нацию, за которую вы будете играть. В одиночной игре можно также выбрать нацию для каждого компьютерного игрока.</STRING>
		</ENTRY>
		<ENTRY name="TRIBEX">
			<STRING>{НАЦИЯ}: показывает, какой нацией будет управлять этот игрок.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOM">
			<STRING>{СЛУЧАЙНАЯ НАЦИЯ}: нация будет выбрана случайно в начале игры. Её принадлежность будет скрыта от врагов, пока они не встретят вас на карте во время игры.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMOFFENSIVE">
			<STRING>{СЛУЧАЙНАЯ: АТАКА}: нация будет выбрана случайно в начале игры. Её принадлежность будет скрыта от врагов, пока они не встретят вас на карте во время игры. Выбранная нация будет сильна в нападении.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMDEFENSIVE">
			<STRING>{СЛУЧАЙНАЯ: ОБОРОНА}: нация будет выбрана случайно в начале игры. Её принадлежность будет скрыта от врагов, пока они не встретят вас на карте во время игры. Выбранная нация подойдёт для обороны. </STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMECONOMIC">
			<STRING>{СЛУЧАЙНАЯ: ЭКОНОМИКА}: нация будет выбрана случайно в начале игры. Её принадлежность будет скрыта от врагов, пока они не встретят вас на карте во время игры. Выбранная нация будет обладать сильным экономическим потенциалом.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMXPACK">
			<STRING>{СЛУЧАЙНАЯ: X-PACK}: нация будет выбрана случайно в начале игры. Её принадлежность будет скрыта от врагов, пока они не встретят вас на карте во время игры. Будет выбрана одна из новых наций дополнения X-Pack.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMCTW">
			<STRING>{СЛУЧАЙНАЯ НАЦИЯ}: нация будет выбрана случайно в начале игры. </STRING>
		</ENTRY>
		<ENTRY name="TRIBE0">
			<STRING>{Ацтеки обладают силой жертвоприношения.}
        <BULLET/>Когда юниты вашей казармы, конюшни и дока убивают врага, вы получаете по $NUMBER0 бонусных ресурсов за каждую эпоху (максимум $NUMBER3).
        <BULLET/>Добыча с вражеских зданий увеличена на $NUMBER1%.
      <BULLET/>Вы начинаете с одним военным исследованием в библиотеке.
      <BULLET/>Вы получаете бесплатную лёгкую пехоту за каждую новую казарму (один юнит в начале, два — с Античностью и одним военным исследованием, три — с Эпохой пороха и 3 военными исследованиями).
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE1">
			<STRING>{Майя обладают силой архитектуры.}
         <BULLET/>Города, башни, форты и т. п. выпускают дополнительные стрелы/пули — даже города без гарнизона.
         <BULLET/>Здания на $NUMBER2% прочнее, а все здания, кроме чудес, строятся на $NUMBER3% быстрее.
         <BULLET/>Здания стоят на $NUMBER0% меньше древесины (кроме чудес и военных зданий).
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE2">
			<STRING>{Инки обладают силой золота.}
      <BULLET/>Рудники приносят не только металл, но и богатство.
      <BULLET/>Лимит торговли богатством +$NUMBER0%.
      <BULLET/>Когда враг убивает ваш юнит, вам возвращается $NUMBER1% его стоимости.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE3">
			<STRING>{Банту обладают силой миграции.}
         <BULLET/>+$NUMBER1 к лимиту городов (нужно хотя бы одно гражданское исследование), города на $NUMBER5% дешевле.
      <BULLET/>+$NUMBER2% к лимиту населения. Можно превышать максимальный лимит на $NUMBER3%.
      <BULLET/>Юниты казармы и горожане передвигаются на $NUMBER4% быстрее.
      <BULLET/>Улучшения юнитов не требуют военных исследований.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE4">
			<STRING>{Нубийцы обладают силой торговли.}
         <BULLET/>Торговцы на вашей территории получают +$NUMBER0% к базовым ресурсам. Вы видите редкие ресурсы на своей территории.
      <BULLET/>+$NUMBER1 к лимиту караванов.
      <BULLET/>Вы начинаете с рынком и всегда торгуете ресурсами с ценовым бонусом +$NUMBER4/-$NUMBER4.
      <BULLET/>Торговцы, караваны и рынки на $NUMBER2% дешевле и на $NUMBER3% крепче.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE5">
			<STRING>{Греки обладают силой философии.}
         <BULLET/>Исследования в библиотеке на $NUMBER1% дешевле (кроме знаний) и на $NUMBER0% быстрее.
      <BULLET/>Можно строить университеты и добывать знания с самого начала игры.
      <BULLET/>Библиотеки и университеты на $NUMBER4% дешевле.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE6">
			<STRING>{Римляне обладают силой Цезаря.}
         <BULLET/>Форты на $NUMBER3% дешевле и строятся на $NUMBER8% быстрее, дают +$NUMBER2 к национальным границам и получают улучшения бесплатно.
      <BULLET/>Тяжёлая пехота создаётся на $NUMBER6% дешевле и на $NUMBER7% быстрее. Вы начинаете с одним военным исследованием в библиотеке.
      <BULLET/>Вы получаете бесплатную тяжёлую пехоту за каждую новую казарму (один юнит — с Античностью, два — с Эпохой пороха и 3 военными исследованиями, три — с Эпохой индустрии и 5 военными исследованиями).
      <BULLET/>Города добывают дополнительно +$NUMBER4 богатства.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE7">
			<STRING>{Египтяне обладают силой Нила.}
         <BULLET/>Вы начинаете с амбаром и получаете его улучшения бесплатно.
         <BULLET/>Лимит торговли пищей +$NUMBER3%.
      <BULLET/>Можно строить $NUMBER2 ферм на город. Фермы приносят +$NUMBER4 богатства.
      <BULLET/>Чудеса стоят на $NUMBER1% меньше, их можно строить на эпоху раньше и по два в каждом городе.
         </STRING>
		</ENTRY>
		<ENTRY name="TRIBE7CTW">
			<STRING>{Египтяне обладают силой Нила.}
         <BULLET/>Вы начинаете с амбаром и получаете его улучшения бесплатно.
         <BULLET/>Лимит торговли пищей +$NUMBER3%.
      <BULLET/>Можно строить $NUMBER2 ферм на город. Фермы приносят +$NUMBER4 богатства.
      <BULLET/>Кампании «Завоевание мира» вы начинаете с бонусной картой «Построить чудо», а на стратегической карте строите чудеса на эпоху раньше.
         </STRING>
		</ENTRY>
		<ENTRY name="TRIBE8">
			<STRING>{Турки обладают силой осады.}
      <BULLET/>Все осадные, артиллерийские и бомбардировочные юниты получают +$NUMBER0 к дальности и +$NUMBER1 к обзору.
         <BULLET/>Бесплатные осадные юниты ($NUMBER3) за каждую новую осадную мастерскую или завод.
      <BULLET/>Горожане на $NUMBER5% дешевле. Захваченные города ассимилируются на $NUMBER2% быстрее.
      <BULLET/>Осадные юниты улучшаются бесплатно. Военные исследования в библиотеке на $NUMBER4% дешевле.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE9">
			<STRING>{Испанцы обладают силой открытий.}
         <BULLET/>Карта открыта с начала игры, и у вас есть дополнительный разведчик. (В играх с «Открытой картой» вы получаете бонусного разведчика.)
         <BULLET/>Линия разведчиков улучшается бесплатно и быстрее применяет способности.
         <BULLET/>До Эпохи индустрии вы получаете бесплатный тяжёлый корабль за каждый построенный док.
      <BULLET/>Вы получаете $NUMBER2 ресурсов из руин и +$NUMBER3 за каждый уровень науки.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE10">
			<STRING>{Французы обладают силой лидерства.}
      <BULLET/>Вы получаете бесплатного генерала за каждый новый форт.
      <BULLET/>Обозы лечат ваши войска. Вы получаете бесплатный обоз за каждую новую осадную мастерскую или завод.
      <BULLET/>Юниты осадной мастерской и завода создаются на $NUMBER3% дешевле и на $NUMBER4% быстрее. Они также быстрее передвигаются.
      <BULLET/>Бесплатная лесопилка и её улучшения. Лесорубы: +$NUMBER5 горожан. Лимит торговли древесиной +$NUMBER7%.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE11">
			<STRING>{Британцы обладают силой империи.}
         <BULLET/>+$NUMBER0% к лимиту торговли. Двойной доход от налогообложения, улучшения налогов на 50% дешевле.
         <BULLET/>Корабли создаются на $NUMBER1% быстрее. Бесплатная рыбацкая лодка за каждый новый док.
      <BULLET/>Улучшения пеших лучников бесплатно. Бесплатные лучники за каждую новую казарму (один в начале, два — со Средневековьем, три — с Эпохой пороха).
      <BULLET/>+$NUMBER5 к дальности фортов и башен.
      <BULLET/>Зенитные юниты и здания создаются на $NUMBER3% дешевле и на $NUMBER4% быстрее.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE12">
			<STRING>{Немцы обладают силой индустрии.}
         <BULLET/>Производственные улучшения амбара, лесопилки и плавильни на $NUMBER7% дешевле и доступны раньше.
      <BULLET/>Города добывают дополнительно +$NUMBER6 пищи, древесины и металла. Бонусы за завершение зданий +$NUMBER5%.
      <BULLET/>Подлодки и брандеры строятся на $NUMBER1% быстрее и на $NUMBER2% дешевле.
         <BULLET/>Авиация создаётся на $NUMBER3% быстрее. Каждая новая авиабаза даёт бесплатные истребители ($NUMBER4).
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE13">
			<STRING>{Русские обладают силой Родины.}
         <BULLET/>Урон от истощения вражеским юнитам на вашей территории увеличен на $NUMBER0%. Улучшения истощения бесплатны.
         <BULLET/>$NATIONALBORDERS0 Вы начинаете с 1 бесплатным гражданским исследованием в библиотеке.
         <BULLET/>Шпионы стоят вдвое дешевле.
         <BULLET/>Кавалерия наносит на +$NUMBER3% больше урона вражеским юнитам снабжения и артиллерии.
      <BULLET/>Добыча с русских зданий достаётся русским, а не разграбившему их врагу. +$NUMBER1% к добыче нефти.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE14">
			<STRING>{Китайцы обладают силой культуры.}
      <BULLET/>Научные исследования в библиотеке на $NUMBER4% дешевле.
      <BULLET/>Улучшения «Траволечение», «Медицина» и «Фармацевтика» бесплатно.
      <BULLET/>Вы начинаете с большим городом. Основанные вами новые города становятся большими.
      <BULLET/>Горожане, караваны и торговцы создаются мгновенно.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE15">
			<STRING>{Японцы обладают силой чести.}
         <BULLET/>Юниты казармы создаются на $NUMBER1% дешевле и на $NUMBER2% быстрее за каждую эпоху и военное исследование.
         <BULLET/>Юниты казармы наносят на $NUMBER0% больше урона зданиям за каждую эпоху и военное исследование.
         <BULLET/>Корабли на $NUMBER3% дешевле, авианосцы создаются на $NUMBER4% быстрее.
      <BULLET/>Фермы на $NUMBER5% дешевле. Фермы и рыбаки добывают на +$NUMBER6% больше ресурсов.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE16">
			<STRING>{Корейцы обладают силой традиций.}
      <BULLET/>Вы начинаете с храмом и получаете улучшения религии бесплатно.
      <BULLET/>В начале у вас дополнительные горожане ($NUMBER1); со следующим городом вы получаете ещё $NUMBER3, а с каждым последующим — $NUMBER5.
      <BULLET/>Ремонт на $NUMBER2% быстрее. Ваши горожане строят и чинят здания под обстрелом без штрафа.
      <BULLET/>Улучшения ополченца, минитмена и партизана бесплатно. Башни на $NUMBER4% дешевле.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE17">
			<STRING>{Монголы обладают силой Орды.}
         <BULLET/>Бесплатная стрелковая конница за каждую новую конюшню или автозавод ($NUMBER5 в начале, $NUMBER3 — с двумя военными исследованиями, $NUMBER7 — с тремя).
      <BULLET/>Конные юниты создаются на $NUMBER0% дешевле и на $NUMBER1% быстрее.
         <BULLET/>+1 пища за каждые $NUMBER4% контролируемой суши мира (умножается на половину числа наций).
      <BULLET/>Истощение ваших юнитов снижено на $NUMBER2%. Исследования «Фураж», «Снабжение» и «Логистика» бесплатно.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE18">
			<STRING>{Ирокезы обладают силой нации.}
         <BULLET/>Бесплатный разведчик за каждую построенную казарму; разведчики получают улучшения бесплатно и могут проходить через леса.
         <BULLET/>Первый построенный сенат бесплатен и строится мгновенно.
         <BULLET/>Лесорубы также добывают по +2 пищи.
         <BULLET/>Военные юниты (включая разведчиков) на дружественной территории невидимы, пока не атакуют. Все юниты лечатся на дружественной территории, когда не двигаются и не атакуют. Юниты казармы имеют +10% здоровья.
         </STRING>
		</ENTRY>
		<ENTRY name="TRIBE19">
			<STRING>{Лакота обладают силой равнин.}
        <BULLET/>Вместо постройки ферм и амбаров вы получаете +$NUMBER0 пищи за каждого горожанина, разведчика и кавалерийский юнит (кроме стоящих в гарнизоне). Фермы и амбары в захваченных вражеских городах мгновенно разрушаются.
        <BULLET/>Границы невидимы для врагов. Можно строить здания где угодно на территории, не принадлежащей вражеской нации.
      <BULLET/>Улучшения стрелковой конницы бесплатны.
        </STRING>
		</ENTRY>
		<ENTRY name="TRIBE20">
			<STRING>{Американцы обладают силой инноваций.}
         <BULLET/>Первое чудо строится мгновенно (кроме «Освоения космоса» и «Суперколлайдера»), если ни одна другая нация не строит то же чудо.
<BULLET/>Формы правления бесплатны. Бесплатные учёные ($NUMBER2) с каждым новым университетом.
         <BULLET/>Авиация и авианосцы на $NUMBER0% дешевле. С Современности — бесплатные бомбардировщики ($NUMBER1) с каждой авиабазой.
      <BULLET/>Улучшения военных наземных юнитов на 25% дешевле. +3 пищи, древесины, металла и богатства за каждый юнит казармы, кроме разведчиков (если он не в гарнизоне).
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE20CTW">
			<STRING>{Американцы обладают силой инноваций.}
         <BULLET/>Формы правления в сенате бесплатны. Бесплатные учёные ($NUMBER2) с каждым новым университетом.
         <BULLET/>Авиация и авианосцы на $NUMBER0% дешевле. Начиная с Современности, бесплатные бомбардировщики ($NUMBER1) с каждой авиабазой (они не повышают стоимость следующих юнитов).
      
      <BULLET/>Улучшения военных юнитов на 20% дешевле. +3 пищи, древесины, металла и богатства за каждый юнит казармы (если он не в гарнизоне).
      <BULLET/>Кампании «Завоевание мира» вы начинаете с бонусной картой «Построить чудо».</STRING>
		</ENTRY>
		<ENTRY name="TRIBE21">
			<STRING>{Индийцы обладают силой величия.}
         <BULLET/>Стоимость зданий не растёт, кроме чудес света, башен, дозорных вышек и фортов, которые дорожают вдвое медленнее, и городов, которые дорожают как обычно.
      <BULLET/>+$NUMBER0 к экономическому радиусу городов.<BULLET/>+$NUMBER1% к доходу караванов.
      <BULLET/>Улучшения боевых слонов бесплатны, а боевые слоны на $NUMBER2% дешевле.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE22">
			<STRING>{Голландцы обладают силой коммерции.}
         <BULLET/>Вы начинаете с бесплатным торговым исследованием в библиотеке. Скидка $NUMBER0% на все последующие торговые исследования.
      <BULLET/>Вы начинаете с рынком и 2 бесплатными торговцами.<BULLET/>За каждые 100 единиц ресурса в казне сверх начального уровня вы получаете +$NUMBER1 к доходу этого ресурса (кроме знаний); этот доход может превышать лимит торговли на 50.
      <BULLET/>Бесплатные лёгкие корабли ($NUMBER2) за каждый построенный док. Улучшения кораблей на 10% дешевле.</STRING>
		</ENTRY>
		<ENTRY name="TRIBE23">
			<STRING>{Персы обладают силой церемоний.}
         <BULLET/>Вы начинаете с бонусом $NUMBER0% пищи.
      <BULLET/>Второй построенный город служит второй столицей. Оба получают бонус границ столицы, и чтобы победить вас, нужно захватить оба.
<BULLET/>Скидка $NUMBER1% на гражданские исследования.
<BULLET/>Улучшения налогообложения бесплатно. <BULLET/>У вас всегда максимально допустимое число караванов.
</STRING>
		</ENTRY>
		<ENTRY name="TRIBE24">
			<STRING>{Румыния обладает силой Карпат.}
         <BULLET/>Урон от истощения вражеским юнитам на вашей территории увеличен на 100%. Улучшения истощения бесплатны.
         <BULLET/>+20% к добыче нефти.
         <BULLET/>Форты и башни на 25% дешевле. Форты строятся на 50% быстрее, дают +3 к национальным границам и получают улучшения бесплатно.
         <BULLET/>Улучшения ополченца, минитмена и партизана бесплатно.
         </STRING>
		</ENTRY>
	</TRIBES>
	<LIBRARY>
		<TECHCATS>
			<ENTRY name="AGETECH">
				<STRING>
					<BULLET/>
{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания.
Чтобы перейти в новую эпоху, нажмите кнопки с римскими цифрами в верхнем ряду библиотеки.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="MILITARY">
				<STRING>
					<BULLET/>
#ICON24 {Военные} исследования увеличивают ваш #ICON20 {лимит населения}. Большинство военных юнитов и зданий требуют военных исследований. Они также снижают стоимость юнитов и их улучшений.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="SCIENCEV">
				<STRING>
					<BULLET/>
#ICON27 {Научные} исследования снижают {стоимость исследований} всех технологий на $NUMBER0% и ускоряют их изучение на $NUMBER1%.
Научные исследования также увеличивают {обзор} всех разведчиков, городов и дозорных вышек и повышают бонус за исследование руин. Большинство экономических улучшений требуют научных исследований.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="SCIENCENV">
				<STRING>
					<BULLET/>
{Научные} исследования снижают {стоимость исследований} всех технологий. Кроме того, ваши разведчики, города и дозорные вышки {видят дальше}, а бонус за исследование руин растёт.  Большинство экономических улучшений требуют научных исследований.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="COMMERCE">
				<STRING>
					<BULLET/>
#ICON26 {Торговые} исследования увеличивают ваш #ICON21 {лимит торговли}, который определяет вашу {эффективность} — максимальную скорость,
с которой вы можете добывать любой ресурс. Они также увеличивают ваш #ICON9 {лимит караванов} — максимальное число торговых путей.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="CIVIC">
				<STRING>
					<BULLET/>
#ICON25 {Гражданские} исследования увеличивают #ICON22 {число городов}, которые вы можете построить, и расширяют ваши
{национальные границы}.
</STRING>
				<TRANSLATION/>
			</ENTRY>
		</TECHCATS>
		<AGES>
			<ENTRY name="AGE0">
				<STRING>
					<BULLET/>
{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания.
В большинстве игр ваша нация начинает в {Древности} почти без технологий и продвигается вперёд, изучая технологии в библиотеке.
</STRING>
			</ENTRY>
			<ENTRY name="AGE1">
				<STRING>
					<BULLET/>
{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания.
Переход в #ICON28 {Античность} открывает новые ресурсы (#ICON4 знания и #ICON5 металл). Также можно строить сенат ради сил формы правления, форты для обороны, конюшни и осадные мастерские для создания мощных новых видов юнитов.
</STRING>
			</ENTRY>
			<ENTRY name="AGE2">
				<STRING>
					<BULLET/>

{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания. Переход в #ICON29 {Средневековье} позволяет вооружить войска более мощным оружием. Также можно создавать обозы для поддержки войск и шпионов для подрывной работы против врагов.
</STRING>
			</ENTRY>
			<ENTRY name="AGE3">
				<STRING>
					<BULLET/>


{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания.
Переход в #ICON30 {Эпоху пороха} открывает мощные пороховые юниты.
</STRING>
			</ENTRY>
			<ENTRY name="AGE4">
				<STRING>
					<BULLET/>
{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания.
Переход в #ICON31 {Эпоху Просвещения} открывает мощные новые юниты с мушкетами и пушками.</STRING>
			</ENTRY>
			<ENTRY name="AGE5">
				<STRING>
					<BULLET/>
{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания.
Переход в #ICON32 {Эпоху индустрии} даёт доступ к новому ресурсу #ICON12 (нефть) и впервые открывает танки и авиацию.</STRING>
			</ENTRY>
			<ENTRY name="AGE6">
				<STRING>
					<BULLET/>
{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания.
Переход в #ICON33 {Современность} даёт доступ к мощным современным юнитам и зданиям, в том числе возможность
исследовать ядерное оружие.
</STRING>
			</ENTRY>
			<ENTRY name="AGE7">
				<STRING>
					<BULLET/>
{Смена эпох} отражает путь вашей нации сквозь историю и открывает новые юниты и здания.
Переход в #ICON34 {Информационную эпоху} выводит вас на вершину информационных технологий: самые мощные юниты и здания игры наконец становятся
доступны.
</STRING>
			</ENTRY>
		</AGES>
		<ENTRY name="TECHS">
			<STRING/>
		</ENTRY>
	</LIBRARY>
	<SETUPWIN>
		<SETUPCHECKS>
			<ENTRY name="SETUPCHECK0">
				<STRING>
{СОХРАНИТЬ В ПРОФИЛЬ}: отметьте, чтобы сохранить профиль. Текущие настройки станут стандартными в следующей игре.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK1">
				<STRING>
{ТУРБО-РЕСУРСЫ}: отметьте, чтобы ускорить сбор ресурсов. Этот вариант для игроков, которые хотят меньше заниматься сбором ресурсов и больше времени уделять другим сторонам игры.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK2">
				<STRING>
{БЕЗ СИЛ НАЦИЙ}: отметьте, чтобы отключить особые способности наций (например, силу Цезаря у римлян).
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK3">
				<STRING>
{БЕЗ УНИКАЛЬНЫХ ОТРЯДОВ}: отметьте, чтобы использовать только стандартный набор юнитов. Ни одна нация не получает уникальных юнитов (например, японских самураев).
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK4">
				<STRING>
{СОВМЕСТНЫЙ ИИ}: компьютерный игрок будет управлять вашей нацией вместе с вами.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK5">
				<STRING>
{ЧАТ НАБЛЮДАТЕЛЕЙ}: если отмечено, наблюдатели могут писать в чат всем игрокам, нажав Shift+ENTER; если нет, наблюдатели не могут писать игрокам во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK6">
				<STRING>
{СВОБОДНАЯ ПАУЗА}: отметьте, чтобы игроки могли прокручивать экран и отдавать приказы во время паузы. В одиночной игре этот режим включён всегда, а в сетевой его нужно выбрать здесь.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK7">
				<STRING>
{ТУРНИР}: отметьте, чтобы скрыть выбор наций игроков до начала игры и их счёт во время игры. Игроки, сдавшиеся раньше, не видят всю карту до конца игры.</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK8">
				<STRING>
{ФИКС. СКОРОСТЬ ИГРЫ}: если скорость зафиксирована, игроки не могут изменить её после начала игры. Этот параметр обязателен для {резервного времени}.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK9">
				<STRING>
{СЛУЧАЙНЫЕ КОМАНДЫ}: игроки не могут сами выбирать союзников по команде — они должны выбрать {«?»}.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK10">
				<STRING>
{СЛУЧАЙНЫЕ НАЦИИ}: игроки не могут выбрать конкретную нацию — они должны выбрать {Случайно}.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK11">
				<STRING>
{ОБЩЕЕ УПРАВЛЕНИЕ КОМАНДОЙ}: все игроки команды могут управлять юнитами любой нации своей команды.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK12">
				<STRING>
          {ТОЛЬКО РЕЙТИНГОВЫЕ}: если отмечено, в списке лобби показываются только рейтинговые игры.
        </STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK13">
				<STRING>
          {ТОЛЬКО БЕЗ РЕЙТИНГА}: если отмечено, в списке лобби показываются только игры без рейтинга.
        </STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK14">
				<STRING>
{БЕЗ ЯДЕРНОГО ОРУЖИЯ}: отметьте, чтобы играть без ядерного оружия. Никто не может строить ядерные ракеты, МБР и перехватчики; крылатые ракеты остаются.
				</STRING>
			</ENTRY>
		</SETUPCHECKS>
		<NAMES>
			<ENTRY name="NAME">
				<STRING>
{ИГРОК}: показывает, кто будет управлять каждой нацией. В сетевой игре хост
может выбрать для каждого места: «Открыто», «Закрыто» или «Компьютер».
</STRING>
			</ENTRY>
			<ENTRY name="NAMEX">
				<STRING>
{ИГРОК}: показывает, кто будет управлять каждой нацией. В сетевой игре хост
может выбрать для каждого места: «Открыто», «Закрыто» или «Компьютер».
</STRING>
			</ENTRY>
			<ENTRY name="NAME0">
				<STRING>
{ЧЕЛОВЕК}: этой нацией будет управлять человек. Если в одиночной игре отметить несколько мест как {Человек},
вы сможете переключаться между двумя и более нациями — просто щёлкните юнит или
здание другой нации с меткой {Человек}, чтобы взять её под контроль.
</STRING>
			</ENTRY>
			<ENTRY name="NAME1">
				<STRING>
{КОМПЬЮТЕР}: этой нацией будет управлять компьютер.
</STRING>
			</ENTRY>
			<ENTRY name="NAME2">
				<STRING>
{КОМПЬЮТЕР (РАШ)}: этой нацией будет управлять компьютер. Он развивается быстро и агрессивно и старается атаковать рано.
</STRING>
			</ENTRY>
			<ENTRY name="NAME3">
				<STRING>
{КОМПЬЮТЕР (БУМ)}: этой нацией будет управлять компьютер. Он предпочитает сначала построить сильную экономику, а уже потом атаковать крупными силами.
</STRING>
			</ENTRY>
			<ENTRY name="NAME4">
				<STRING>
{ОТКРЫТО}: место открыто, и к игре могут присоединиться игроки.
</STRING>
			</ENTRY>
			<ENTRY name="NAME5">
				<STRING>
{ЗАКРЫТО}: место недоступно для присоединения игроков.
</STRING>
			</ENTRY>
			<ENTRY name="NAME6">
				<STRING>
{НЕТ}: убирает этого игрока из игры — у вас будет на одного противника или союзника меньше. Если
вы хотите добавить {больше} наций, увеличьте параметр {Другие нации}.
</STRING>
			</ENTRY>
			<ENTRY name="NAME7">
				<STRING>
{ИСКЛЮЧИТЬ}: удаляет этого игрока из игры.
</STRING>
			</ENTRY>
			<ENTRY name="NAME8">
				<STRING>
{ВСЁ ПОД ЧЕЛОВЕКОМ}: все нации переходят под управление человека. Вы сможете переключаться
между нациями, щёлкая любой юнит или здание нации, которой хотите управлять.
</STRING>
			</ENTRY>
			<ENTRY name="NAME9">
				<STRING>
{ВСЁ ПОД КОМПЬЮТЕРОМ}: все нации переходят под управление компьютера, и вы можете смотреть, как компьютер играет сам с собой.
</STRING>
			</ENTRY>
		</NAMES>
		<HANDICAPS>
			<ENTRY name="HANDICAP">
				<STRING>
{НАВЫК}: нажмите здесь, чтобы задать гандикап для этого игрока. В сетевой игре более
опытные игроки могут повысить свой гандикап, чтобы уравнять команды. Более высокий навык
ускоряет сбор ресурсов у ПРОТИВНИКОВ игрока.
</STRING>
			</ENTRY>
			<ENTRY name="HANDICAPX">
				<STRING>
{НАВЫК}: в сетевой игре более опытные игроки могут повысить свой гандикап,
чтобы уравнять команды. Более высокий навык ускоряет сбор ресурсов у ПРОТИВНИКОВ
игрока.
</STRING>
			</ENTRY>
		</HANDICAPS>
		<WHOS>
			<ENTRY name="WHO">
				<STRING>
{ЦВЕТ}: нажмите здесь, чтобы выбрать цвет игрока. Если два игрока выберут один цвет, они
будут играть совместно, управляя одними и теми же юнитами и зданиями.
</STRING>
			</ENTRY>
			<ENTRY name="WHOX">
				<STRING>
{ЦВЕТ}: показывает цвет этого игрока. Если два игрока выберут один цвет, они
будут играть совместно, управляя одними и теми же юнитами и зданиями.
</STRING>
			</ENTRY>
		</WHOS>
		<GAMESTYLES>
			<ENTRY name="GAMESTYLE">
				<STRING>
{КОМАНДЫ И СОЮЗНИКИ}: нажмите здесь, чтобы выбрать, будут ли нации объединены в команды и как, а также могут ли союзы меняться во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLEX">
				<STRING>
{КОМАНДЫ И СОЮЗНИКИ}: определяет, как нации объединяются в команды и могут ли союзы меняться
во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE0">
				<STRING>
{ДИПЛОМАТИЯ}: нации начинают поодиночке, но могут заключать договоры и союзы.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE1">
				<STRING>
{ВЫЖИВАЕТ СИЛЬНЕЙШИЙ}: каждая нация сама за себя; союзы запрещены.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE2">
				<STRING>
{УБИЙЦА}: рекомендуемый нами формат «Каждый за себя»! Союзы запрещены, И каждой нации назначается
нация-цель: входить можно только на территорию этого врага. Вход на территорию
нации, которая не является вашей целью, наносит тяжёлый урон от истощения. Когда нация выбывает,
нация, которая на неё охотилась, получает цель выбывшей нации.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE3">
				<STRING>
{ВАРВАРЫ У ВОРОТ}: для тех, кто любит, когда на них нападают всей толпой! Группа варварских наций пытается уничтожить
одну обороняющуюся нацию, пока не истечёт время. Варварам можно задать более низкий уровень технологий и ресурсов,
чем у обороняющихся. В одиночной игре вы играете против всех компьютерных игроков; в сетевой игре игроки
могут выбрать любую сторону (команда 1 обороняется, команда 2 атакует).</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE4">
				<STRING>
{КОМАНДЫ ПО 2}: заранее заданные союзы по 2 нации. Игроки не могут сменить сторону во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE5">
				<STRING>{КОМАНДЫ ПО 3}: заранее заданные союзы по 3 нации. Игроки не могут сменить сторону во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE6">
				<STRING>{КОМАНДЫ ПО 4}: заранее заданные союзы по 4 нации. Игроки не могут сменить сторону во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE7">
				<STRING>
{КОМАНДНАЯ ДИПЛОМАТИЯ}: (только сетевая игра)}: заранее заданные команды и несколько нейтральных наций, доступных для союзов. Только
нейтральные нации могут менять союзы во время игры. Каждая команда может дипломатией склонить
нейтральные нации на свою сторону.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE8">
				<STRING>
{СОВМЕСТНАЯ ДИПЛОМАТИЯ}: (только сетевая игра) пары игроков совместно управляют каждой нацией.
Нации начинают поодиночке, но могут заключать союзы.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE9">
				<STRING>
{СОВМЕСТНОЕ ВЫЖИВАНИЕ}: (только сетевая игра) пары игроков совместно управляют каждой нацией, но союзы
между нациями запрещены.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE10">
				<STRING>{СОВМЕСТНЫЕ КОМАНДЫ}: (только сетевая игра) пары игроков совместно управляют каждой нацией, а нации начинают игру в союзах по 2. Игроки не могут сменить сторону во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE11">
				<STRING>
{СВОЯ ДИПЛОМАТИЯ}: настройте команду и совместное управление для каждого игрока отдельно. Так можно создавать
особые ситуации, например неравные команды. Игроки могут свободно заключать и расторгать союзы во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE12">
				<STRING>
{СВОИ КОМАНДЫ}: настройте команду и совместное управление для каждого игрока отдельно. Так можно создавать
особые ситуации, например неравные команды. Игроки не могут сменить сторону во время игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE13">
				<STRING>
{СОХРАНЁННАЯ ИГРА}: восстановить ранее сохранённую игру.
</STRING>
			</ENTRY>
		</GAMESTYLES>
		<GAMERULES>
			<ENTRY name="GAMERULES">
				<STRING>
{ПРАВИЛА}: нажмите здесь, чтобы выбрать, будет ли игра идти по стандартным или особым правилам.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULESX">
				<STRING>
{ПРАВИЛА}: определяет, будет ли игра идти по стандартным или особым правилам.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES0">
				<STRING>
{СТАНДАРТ}: стандартные правила рекомендуются новичкам и игрокам, которые хотят играть в самой распространённой
конфигурации игры. В стандартной игре игрок или команда побеждает, контролируя 70%
территории мира, построив и удерживая на 8 очков чудес больше, чем у противников, или завоевав всех врагов. Врагов можно
уничтожить, захватив и удерживая их столицы.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES1">
				<STRING>
{СВОЯ}: особые правила открывают новые параметры, позволяющие настроить правила игры.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES2">
				<STRING>{БЕЗ РАША}: атаковать нельзя, пока хотя бы один игрок не достигнет Эпохи пороха.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES3">
				<STRING>
{ВНЕЗАПНАЯ СМЕРТЬ}: игроки мгновенно проигрывают, как только захвачен любой их город, и мгновенно побеждают, построив достаточно чудес или взяв под контроль 70% территории мира.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES4">
				<STRING>{БОЙ НАСМЕРТЬ}: игроки начинают с огромным запасом каждого ресурса.
</STRING>
			</ENTRY>
			<!--
      <ENTRY name="GAMERULES5">
        <STRING>{INFINITE RESOURCES}: Players have infinite resources and begin with Gunpowder Age technology.
</STRING>
      </ENTRY>
-->
			<ENTRY name="GAMERULES5">
				<STRING>
{КОЧЕВНИК}: игроки начинают игру без города и разведчика. Силы наций не действуют, пока не построен первый город.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES6">
				<STRING>
{МИРНАЯ ГОНКА ТЕХНОЛОГИЙ}: игроки не могут сражаться; побеждает тот, кто первым достигнет выбранной конечной эпохи или Информационной эпохи.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES7">
				<STRING>
{УБИЙЦА}: рекомендуемый нами формат «Каждый за себя»! Союзы запрещены, И каждой нации назначается
нация-цель: входить можно только на территорию этого врага. Вход на территорию
нации, которая не является вашей целью, наносит тяжёлый урон от истощения. Когда нация выбывает,
нация, которая на неё охотилась, получает цель выбывшей нации.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES8">
				<STRING>
{ВАРВАРЫ У ВОРОТ}: для тех, кто любит, когда на них нападают всей толпой! Группа варварских наций пытается уничтожить
одну обороняющуюся нацию, пока не истечёт время. Варварам можно задать более низкий уровень технологий и
ресурсов, чем у обороняющихся. В сетевой игре команда 1 обороняется, а команда 2 атакует.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES9">
				<STRING>
{БЫСТРАЯ ИГРА}: технологии изучаются быстро, а ресурсы добываются стремительно (как с параметром «Турбо-ресурсы»).
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES10">
				<STRING>{СЦЕНАРИЙ}: выберите пользовательский сетевой сценарий. Каждому [scenarioname] в списке соответствует файл ./scenario/Custom/[scenarioname]/[scenarioname].scx.</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES11">
				<STRING>{БОЙ НАСМЕРТЬ: ИНФО-ЭПОХА}: игроки начинают с огромным запасом каждого ресурса и всеми изученными технологиями. Будущие технологии изучать нельзя, а ядерное оружие строить нельзя.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS0">
				<STRING>{ОЧЕНЬ МЕДЛЕННО}: очень медленная скорость игры для долгих партий.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS1">
				<STRING>{МЕДЛЕННО}: медленная скорость игры.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS3">
				<STRING>{БЫСТРО}: быстрая скорость игры.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS4">
				<STRING>{СВЕРХБЫСТРО} Сверхбыстрая скорость игры.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS2">
				<STRING>{ОБЫЧНО}: обычная скорость игры.</STRING>
			</ENTRY>
		</GAMERULES>
