	<CAT hash="3630095">
		<STRING hash="144179091" hash_i="144254483" needed="1">Caravane permise spre națiuni aliate și pașnice.</STRING>
		<STRING hash="109448645" hash_i="110123043" needed="1">Poți cumpăra și vinde resurse la Piață.</STRING>
		<STRING hash="65524626" hash_i="65503050" needed="1">Unitățile pot fi transportate pe mare.</STRING>
		<STRING hash="47841210" hash_i="47916602" needed="1">Poți coloniza continente noi.</STRING>
		<STRING hash="49944385" hash_i="50071323" needed="1">Câmpul vizual al aliaților e vizibil.</STRING>
		<STRING hash="27256813" hash_i="27332205" needed="1">Vezi granițele inamicilor.</STRING>
		<STRING hash="46656408" hash_i="46642270" needed="1">Întreaga hartă devine explorată.</STRING>
		<STRING hash="182550996" hash_i="182618702" needed="1">Toate unitățile și clădirile de pe teritoriul tău sunt dezvăluite.</STRING>
		<STRING hash="185444026" hash_i="185429888" needed="1">Întreaga hartă dezvăluită, inclusiv toate unitățile și clădirile.</STRING>
		<STRING hash="175867710" hash_i="175853572" needed="1">Rachetele inamice nu vor exploda pe teritoriul tău.</STRING>
		<STRING hash="72570973" hash_i="72638679" needed="1">Ceasul Armaghedonului dat înapoi cu 2.</STRING>
		<STRING hash="199735905" hash_i="214961141" needed="1">Toate resursele produse la rata maximă (#ICON21 Limita de comerț).</STRING>
		<STRING hash="52830534" hash_i="52808958" needed="1">Unitățile sunt produse instantaneu.</STRING>
		<STRING hash="79201232" hash_i="79276624" needed="1">Caravanele pot riposta inamicilor.</STRING>
