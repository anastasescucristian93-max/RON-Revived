	<CAT hash="5045222">
		<STRING hash="2054343" hash_i="2054343" needed="1">Vezi ./scenario/sample_script.bhs pentru documentație suplimentară</STRING>
		<STRING hash="2044028" hash_i="2044028" needed="1">Folosește funcțiile de declanșare (vezi lista selectând Edit-&gt;Insert Trigger Function) pentru a controla evenimentele jocului</STRING>
		<STRING hash="2660675" hash_i="2660675" needed="1">Inserează comenzi care se vor executa când condiția declanșatorului este adevărată și declanșatorul este activat.</STRING>
		<STRING hash="3935950" hash_i="3935950" needed="1">condițiile în care se va activa declanșatorul</STRING>
		<STRING hash="865265" hash_i="865265" needed="1">Folosește Edit-&gt;Insert Trigger Block pentru a adăuga un bloc de declanșator gol.</STRING>
		<STRING hash="858586" hash_i="858586" needed="1">Folosește Edit-&gt;Insert Trigger Function pentru a alege din lista funcțiilor disponibile</STRING>
		<STRING hash="852417" hash_i="852417" needed="1">Adaugă aici declanșatorii și alte comenzi care se vor executa la fiecare cadru al jocului.</STRING>
		<STRING hash="1294078" hash_i="1294078" needed="1">Corpul principal al scriptului.</STRING>
		<STRING hash="3549171" hash_i="3549171" needed="1">Inserează aici comenzile care trebuie executate o singură dată, la încărcarea scriptului.</STRING>
		<STRING hash="1853852" hash_i="1853852" needed="1">Adaugă aici etichetele constante, într-o listă separată prin virgule.</STRING>
	</CAT>
