	<CAT hash="2001345">
		<STRING hash="50981888" hash_i="51543922" needed="1">Limită de populație, asediu, forturi</STRING>
		<STRING hash="46243831" hash_i="48628873" needed="1">Limită de orașe, granițe naționale</STRING>
		<STRING hash="96409525" hash_i="101220031" needed="1">Plafon comercial, clădiri ce sporesc colectarea</STRING>
		<STRING hash="87408647" hash_i="89808329" needed="1">Viteza și costul cercetării, câmp vizual</STRING>
		<STRING hash="4886119" hash_i="5054375" needed="1">AGRESIV</STRING>
		<STRING hash="3720352" hash_i="3761308" needed="1">DEFENSIV</STRING>
		<STRING hash="6966019" hash_i="7456903" needed="1">PE POZIȚIE</STRING>
		<STRING hash="543802" hash_i="657630" needed="1">RAID</STRING>
		<STRING hash="657446" hash_i="750702" needed="1">DEMOLARE</STRING>
		<STRING hash="3451374" hash_i="3539644" needed="1">NU TRAGE</STRING>
		<STRING hash="1533492" hash_i="1617220" needed="1">CULEGERE</STRING>
		<STRING hash="8881582" hash_i="10186100" needed="1">CONSTRUIRE &amp; CULEGERE</STRING>
		<STRING hash="933873" hash_i="947031" needed="1">CONSTRUIRE</STRING>
		<STRING hash="560748" hash_i="514750" needed="1">INACTIV</STRING>
		<STRING hash="4654856" hash_i="6044030" needed="1">MĂIESTRIE AUTO</STRING>
		<STRING hash="6609992" hash_i="8997984" needed="1">MĂIESTRIE MANUALĂ</STRING>
		<STRING hash="6194878" hash_i="6411260" needed="1">DESFĂȘURARE AUTO</STRING>
		<STRING hash="8366798" hash_i="9212466" needed="1">DESFĂȘURARE MANUALĂ</STRING>
		<STRING hash="273987" hash_i="341693" needed="1">Epocă</STRING>
		<STRING hash="699868" hash_i="677362" needed="1">Minusculă</STRING>
		<STRING hash="1146660" hash_i="1124838" needed="1">Mică</STRING>
		<STRING hash="1512996" hash_i="1495790" needed="1">Medie</STRING>
		<STRING hash="3362659" hash_i="3340837" needed="1">Standard</STRING>
		<STRING hash="1005028" hash_i="987628" needed="1">Mare</STRING>
		<STRING hash="553863" hash_i="535565" needed="1">Uriașă</STRING>
		<STRING hash="2690747" hash_i="2739779" needed="1">Gigantică</STRING>
		<STRING hash="180303618" hash_i="180281112" needed="1">Preia puterea națională a acestei națiuni pentru o bătălie.</STRING>
		<STRING hash="183688558" hash_i="186317930" needed="1">Construiește o minune din această epocă în orice teritoriu ocupat.</STRING>
		<STRING hash="194902380" hash_i="194885174" needed="1">Fă orice teritoriu ocupat invulnerabil la atac.</STRING>
		<STRING hash="219355655" hash_i="218356809" needed="1">Distruge apărarea unui teritoriu protejat de bonusul „Fortifică”.</STRING>
		<STRING hash="100842296" hash_i="100820474" needed="1">Începe o bătălie cu tehnologie suplimentară.</STRING>
		<STRING hash="214321010" hash_i="214299568" needed="1">Primești un spor de 5% la producția acestei resurse într-o bătălie.</STRING>
		<STRING hash="78231022" hash_i="78303896" needed="1">Începe o bătălie cu trupe suplimentare.</STRING>
		<STRING hash="200566579" hash_i="200550723" needed="1">Câștigă fără luptă un teritoriu care nu e capitală și nu e fortificat.</STRING>
		<STRING hash="197341710" hash_i="197409416" needed="1">Toate cercetările din următoarea bătălie sunt cu 20% mai rapide și cu 20% mai ieftine.</STRING>
		<STRING hash="314900243" hash_i="314980239" needed="1">Într-o bătălie, bunurile de la Piață se cumpără cu 20% mai ieftin și aduc cu 20% mai mult la vânzare.</STRING>
		<STRING hash="242748025" hash_i="242726449" needed="1">Într-o bătălie, unitățile se vindecă cu 50% mai repede și sunt imune la uzură.</STRING>
		<STRING hash="226046937" hash_i="226029959" needed="1">Într-o bătălie, trupele inamice invadatoare suferă cu 50% mai multe daune din uzură.</STRING>
		<STRING hash="202254843" hash_i="202240705" needed="1">Triburile inamice își pierd puterile naționale pentru o bătălie.</STRING>
		<STRING hash="239345225" hash_i="239331087" needed="1">Triburile inamice nu au niciun beneficiu de la resursele strategice într-o bătălie.</STRING>
		<STRING hash="180183029" hash_i="180167173" needed="1">Folosești puterea națională a inamicului pentru o bătălie.</STRING>
		<STRING hash="486640902" hash_i="496131788" needed="1">Începe o bătălie cu un bonus de +$NUM0 din fiecare resursă.  Cantitatea depinde de performanța ta într-o bătălie cu barbarii.</STRING>
		<STRING hash="226159838" hash_i="226142632" needed="1">Fă orice teritoriu ocupat care nu e capitală invulnerabil la atac.</STRING>
		<STRING hash="207058700" hash_i="207037258" needed="1">Scade cu două niveluri puterea unui teritoriu inamic.</STRING>
		<STRING hash="211089915" hash_i="211068473" needed="1">Scade cu două niveluri puterea unui teritoriu inamic.</STRING>
		<STRING hash="1236480" hash_i="1304186" needed="1">Arenă</STRING>
		<STRING hash="559909775" hash_i="561287125" needed="1">Câștigă fără luptă orice teritoriu care nu e capitală. Teritoriul-țintă trebuie să fie vecin cu națiunea ta și să aibă puterea patru sau mai mică.</STRING>
		<STRING hash="733441215" hash_i="738771179" needed="1">Începe o bătălie cu un bonus de +$NUM0 din fiecare resursă.  Cantitatea depinde de numărul trupelor tale care supraviețuiesc unei bătălii de câmp sau unui scenariu de tactică.</STRING>
		<STRING hash="169090987" hash_i="169075131" needed="1">Primești puterile speciale ale acestei națiuni pentru o bătălie.</STRING>
		<STRING hash="204222049" hash_i="204207911" needed="1">Națiunile inamice își pierd puterile naționale pentru o bătălie.</STRING>
		<STRING hash="249376835" hash_i="249362697" needed="1">Națiunile inamice nu au niciun beneficiu de la resursele strategice într-o bătălie.</STRING>
		<STRING hash="219151950" hash_i="226481378" needed="1">Construiește o minune din această epocă sau dintr-o epocă anterioară în orice teritoriu ocupat.</STRING>
		<STRING hash="254275421" hash_i="254253845" needed="1">Într-o bătălie, unitățile se vindecă cu 100% mai repede și sunt imune la uzură.</STRING>
		<STRING hash="575779819" hash_i="575763379" needed="1">Începe o bătălie cu un bonus de +$NUM0 din fiecare resursă.  Bonusul depinde de performanța ta în bătălia în care l-ai primit.</STRING>
		<STRING hash="230095683" hash_i="230073177" needed="1">Mută o armată în orice teritoriu controlat de tine care nu are armată.</STRING>
		<STRING hash="186897443" hash_i="186876001" needed="1">Înjumătățește puterea teritoriului-capitală al unui inamic.</STRING>
		<STRING hash="85185476" hash_i="85163654" needed="1">Începe o bătălie cu harta explorată.</STRING>
		<STRING hash="122694029" hash_i="122672207" needed="1">Începe o bătălie cu o brigadă de Elefanți de război.</STRING>
		<STRING hash="905809725" hash_i="911448839" needed="1">Începe bătălia cu Generalul Parmenion. Aduce cavalerie suplimentară și mărește atacul cavaleriei din apropiere. Ambuscada durează mai mult și costă mai puțină măiestrie. Cartea poate fi jucată de două ori.</STRING>
		<STRING hash="1406174271" hash_i="1416362133" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește atacul garnizoanei și oferă protecție suplimentară la retranșare.  Se poate retranșa oriunde, de două ori mai repede. Cât timp ai cartea, primești tribut dublu când nu ataci.</STRING>
		<STRING hash="1142817932" hash_i="1135284314" needed="1">Începe o bătălie cu Generalul Ptolemeu.  În raza lui, unitățile de la distanță au rază și câmp vizual mai mari, unitățile de asediu au atac mai mare, iar toate unitățile au apărare mai mare. Cât timp ai cartea, Egiptul nu te va ataca niciodată.</STRING>
		<STRING hash="1226090010" hash_i="1239400894" needed="1">Începe o bătălie cu Generalul Memnon.  E mereu camuflat. Măiestria se reface de două ori mai repede. Trupele din apropiere pot trece prin păduri și primesc un bonus de armură. Poate fi jucată și pe harta strategică pentru a crește un teritoriu cu patru niveluri.</STRING>
		<STRING hash="1861766412" hash_i="1872626344" needed="1">Începe o bătălie cu Generalul Spitamenes și cinci Arcași călare în plus.  Mărește atacul arcașilor călare din apropiere și viteza cavaleriei din apropiere.  Poate fi jucată pe harta strategică pentru a face orice teritoriu inamic care nu e capitală să se revolte și să devină teritoriu barbar.</STRING>
		<STRING hash="1764796540" hash_i="1777216642" needed="1">Începe o bătălie cu Generalul Porus și cu posibilitatea de a construi Elefanți de război.  Oferă un bonus de viteză Elefanților de război din apropiere.  Creează momeli duble. Poate detecta Spionii inamici și unitățile camuflate. Are mai multe puncte de viață decât alți generali speciali. Cât timp ai cartea, poți construi și Elefanți de război.</STRING>
		<STRING hash="197620251" hash_i="197604395" needed="1">Primești informatori la toate clădirile militare inamice pentru o bătălie.</STRING>
		<STRING hash="258044463" hash_i="258023619" needed="1">Împiedică un inamic să primească venit din colonii și resurse rare timp de două ture.</STRING>
		<STRING hash="218900306" hash_i="218885836" needed="1">Inamicul nu poate adopta guverne timp de o bătălie.</STRING>
		<STRING hash="169235689" hash_i="170602355" needed="1">Scade cu doi puterea teritorială a Marii Britanii.</STRING>
		<STRING hash="110883996" hash_i="111066750" needed="1">Ia până la $NUM0 tribut de la orice națiune.</STRING>
		<STRING hash="269122904" hash_i="269101082" needed="1">Începe o bătălie cu o Cazarmă, un Grajd, un Atelier de asediu și 2 tehnologii militare.</STRING>
		<STRING hash="250093675" hash_i="250276429" needed="1">Efectul Templului asupra granițelor, impozitării și vieții orașelor crește cu $NUM0%.</STRING>
		<STRING hash="124066613" hash_i="124916739" needed="1">Începe o bătălie cu $NUM0 cetățeni în plus.</STRING>
		<STRING hash="830691122" hash_i="827478638" needed="1">Dacă e jucată pe harta strategică, poate forța două națiuni să intre în război.  În bătălie, e un Spion cu măiestrie triplă care dezvăluie harta.  Unitățile din raza lui nu pot fi mituite sau împușcate de lunetiști.</STRING>
		<STRING hash="522377667" hash_i="522453059" needed="1">Poate forța o națiune să se alieze cu tine sau să-ți declare război pentru o tură, apoi să revină la starea diplomatică inițială.</STRING>
		<STRING hash="1177422212" hash_i="1167017348" needed="1">Cât timp ai cartea, Austria nu te va ataca niciodată.  Dacă e jucată într-o bătălie, apare ca un Comando cu măiestrie dublă.  E mereu camuflat, începe cu o echipă de $NUM0 comando și le crește viteza de reîncărcare.</STRING>
		<STRING hash="282032819" hash_i="282010313" needed="1">Mută o armată în orice teritoriu controlat de tine care nu are armată.</STRING>
		<STRING hash="184945059" hash_i="186876001" needed="1">Înjumătățește puterea teritoriului-capitală al unui inamic.</STRING>
		<STRING hash="151528129" hash_i="152649187" needed="1">Începe o bătălie cu o brigadă de Elefanți de război.</STRING>
		<STRING hash="1254270684" hash_i="1262129638" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește atacul garnizoanei și oferă protecție suplimentară la retranșare. Se poate retranșa oriunde, de două ori mai repede. Cât timp ai cartea, primești tribut dublu când nu ataci.</STRING>
		<STRING hash="1294930081" hash_i="1286868227" needed="1">Începe o bătălie cu Generalul Ptolemeu. În raza lui, unitățile de la distanță au rază și câmp vizual mai mari, unitățile de asediu au atac mai mare, iar toate unitățile au apărare mai mare. Cât timp ai cartea, egiptenii nu te vor ataca.</STRING>
		<STRING hash="1086523896" hash_i="1096760282" needed="1">Începe o bătălie cu Generalul Memnon. E mereu camuflat. Măiestria se reface de 2x mai repede. Trupele din apropiere primesc un bonus de armură. Poate fi jucată și pe harta strategică pentru a crește un teritoriu cu patru niveluri.</STRING>
		<STRING hash="1895881406" hash_i="1932498458" needed="1">Începe o bătălie cu Generalul Spitamenes și cinci Arcași călare în plus. Mărește atacul Arcașilor călare din apropiere și viteza unităților de cavalerie din apropiere. Poate fi jucată pe harta strategică pentru a face orice teritoriu inamic care nu e capitală să se revolte și să devină teritoriu barbar.</STRING>
		<STRING hash="1698892994" hash_i="1691929482" needed="1">Începe o bătălie cu Generalul Porus. Oferă un bonus de viteză Elefanților de război din apropiere. Creează momeli duble. Poate detecta Spionii inamici și unitățile camuflate. Are mai multe puncte de viață decât alți generali speciali. Cât timp ții cartea în mână, poți construi Elefanți de război.</STRING>
		<STRING hash="197637493" hash_i="197604395" needed="1">Primești Informatori la toate clădirile militare inamice pentru o bătălie.</STRING>
		<STRING hash="295313493" hash_i="300785097" needed="1">Începe o bătălie cu o Cazarmă, un Grajd, un Atelier de asediu și 2 tehnologii militare.</STRING>
		<STRING hash="240660069" hash_i="250276429" needed="1">Efectul Templului asupra Granițelor, Impozitării și vieții Orașelor crește cu $NUM0%.</STRING>
		<STRING hash="120226677" hash_i="124916739" needed="1">Începe o bătălie cu $NUM0 Cetățeni în plus.</STRING>
		<STRING hash="827554776" hash_i="824543798" needed="1">Dacă e jucată pe harta strategică, poate forța două națiuni să intre în război. În bătălie, e un Spion cu măiestrie triplă care dezvăluie harta. Unitățile din raza lui nu pot fi mituite sau împușcate de lunetiști.</STRING>
		<STRING hash="470253243" hash_i="470328635" needed="1">Poate forța o națiune să se alieze cu tine sau să-ți declare război pentru o tură, apoi să revină la starea diplomatică inițială.</STRING>
		<STRING hash="1152478725" hash_i="1160002091" needed="1">Cât timp ai cartea, Austria nu te va ataca niciodată. Dacă e jucată într-o bătălie, apare ca un Comando cu măiestrie dublă. E mereu camuflat, începe cu o echipă de $NUM0 Comando și le crește viteza de reîncărcare.</STRING>
		<STRING hash="667960444" hash_i="667377854" needed="1">Apare în bătălie ca un Comando cu puncte de viață duble, tragere de lunetist și sabotaj rapide. Pe harta strategică, Paoli poate elibera vasalul altei națiuni.</STRING>
		<STRING hash="928036015" hash_i="934141569" needed="1">Începe o bătălie cu Generalul Parmenion. Aduce cavalerie suplimentară și mărește atacul cavaleriei din apropiere. Ambuscada durează mai mult și costă mai puțină măiestrie. Cartea poate fi jucată de două ori.</STRING>
		<STRING hash="872043771" hash_i="878759485" needed="1">Începe o bătălie cu Generalul Parmenion. Aduce cavalerie suplimentară și mărește atacul cavaleriei din apropiere. Ambuscada durează mai mult și costă mai puțină măiestrie. Poate fi jucat de două ori.</STRING>
		<STRING hash="837769135" hash_i="845101017" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește atacul garnizoanei. Se poate retranșa oriunde de 2x mai repede, cu protecție suplimentară. Cât timp îl ai, primești tribut de 2x dacă nu ataci.</STRING>
		<STRING hash="991616727" hash_i="985966701" needed="1">Începe o bătălie cu Generalul Ptolemeu. În raza lui, unitățile de la distanță au rază și vedere mai mari, asediul are atac mai mare, iar toate unitățile au apărare mai mare. Cât timp îl ai, egiptenii nu te atacă.</STRING>
		<STRING hash="807064063" hash_i="816621473" needed="1">Începe o bătălie cu Generalul Memnon. E mereu camuflat. Măiestria se reface de 2x mai repede. Trupele din apropiere primesc un bonus de armură. Jucat pe un teritoriu, îl crește cu 4 niveluri.</STRING>
		<STRING hash="1022441392" hash_i="1039825250" needed="1">Începe o bătălie cu Generalul Spitamenes. Aduce cavalerie suplimentară.  În raza lui crește viteza cavaleriei și atacul Arcașilor călare. Jucat pe un teritoriu inamic care nu e Capitală, îl face barbar.</STRING>
		<STRING hash="819123928" hash_i="821018802" needed="1">Începe o bătălie cu Generalul Porus. Bonus de viteză pentru elefanții din apropiere. Creează momeli de 2x și detectează unitățile camuflate. Are puncte de viață în plus. Cât timp îl ai, poți construi elefanți.</STRING>
		<STRING hash="826830674" hash_i="822840436" needed="1">Începe o bătălie cu Generalul Ptolemeu. În raza lui, unitățile de la distanță au rază și vedere mai mari, asediul are atac mai mare, iar toate unitățile au apărare mai mare. Cât timp îl ai, egiptenii nu atacă.</STRING>
		<STRING hash="754409179" hash_i="766387981" needed="1">Începe o bătălie cu Generalul Memnon. Mereu camuflat. Măiestria se reface de 2x mai repede. Trupele din apropiere primesc un bonus de armură. Jucat pe un teritoriu, îl crește cu 4 niveluri.</STRING>
		<STRING hash="892366155" hash_i="908418295" needed="1">Începe o bătălie cu Generalul Spitamenes. Aduce cavalerie suplimentară. În raza lui crește viteza cavaleriei și atacul Arcașilor călare. Jucat pe un teritoriu inamic care nu e Capitală, îl face barbar.</STRING>
		<STRING hash="794894472" hash_i="796729654" needed="1">Începe o bătălie cu Generalul Porus. Bonus de viteză pentru elefanții din apropiere. Creează momeli de 2x și vede unitățile camuflate. Are puncte de viață în plus. Cât timp îl ai, poți construi elefanți.</STRING>
		<STRING hash="817548040" hash_i="818400638" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește atacul garnizoanei. Se retranșează oriunde de 2x mai repede, cu protecție suplimentară. Cât timp îl ai, primești tribut de 2x dacă nu ataci.</STRING>
		<STRING hash="794282214" hash_i="792286448" needed="1">Începe o bătălie cu Generalul Ptolemeu. În raza lui, unitățile de la distanță trag mai departe, asediul are atac mai mare și toate unitățile au +1 la apărare. Cât timp îl ai, egiptenii nu atacă.</STRING>
		<STRING hash="799667421" hash_i="798152687" needed="1">Începe o bătălie cu Generalul Porus. Bonus de viteză pentru elefanții din apropiere, creează momeli de 2x, vede unitățile camuflate și are puncte de viață în plus. Cât timp îl ai, poți construi elefanți.</STRING>
		<STRING hash="790034629" hash_i="796777309" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește puterea garnizoanei. Se poate retranșa oriunde de 2x mai repede, cu protecție suplimentară. Cât timp îl ai, primești tribut de 2x dacă nu ataci.</STRING>
		<STRING hash="806331907" hash_i="804617201" needed="1">Începe o bătălie cu Generalul Ptolemeu. În raza lui, unitățile de la distanță trag mai departe, asediul are atac mai mare și toate unitățile au +1 la apărare. Cât timp îl ai, egiptenii nu atacă.</STRING>
		<STRING hash="684259234" hash_i="682430816" needed="1">Începe o bătălie cu Generalul Porus. Bonus de viteză pentru elefanții din apropiere, creează momeli de 2x și vede unitățile camuflate. Cât timp îl ai, poți construi elefanți.</STRING>
		<STRING hash="795285610" hash_i="802037508" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește puterea garnizoanei. Se poate retranșa oriunde de 2x mai repede, cu 150% protecție. Cât timp îl ai, primești tribut de 2x dacă nu ataci.</STRING>
		<STRING hash="800124960" hash_i="797957346" needed="1">Începe o bătălie cu Generalul Ptolemeu. În raza lui, unitățile de la distanță trag mai departe, asediul are atac mai mare și toate unitățile au +1 la apărare. Cât timp îl ai, egiptenii nu atacă.</STRING>
		<STRING hash="507941220" hash_i="507283970" needed="1">Dacă e jucat pe harta strategică, poate forța două națiuni să intre în război. În bătălie, e un Spion cu măiestrie triplă care dezvăluie harta.</STRING>
		<STRING hash="779106853" hash_i="786921001" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește puterea garnizoanei. Se poate retranșa oriunde de 2x mai repede, cu 150% protecție. Primești tribut de 2x dacă nu ataci cât timp îl ai.</STRING>
		<STRING hash="755572550" hash_i="755327980" needed="1">Începe o bătălie cu Generalul Ptolemeu. În raza lui, unitățile au +1 la apărare, cele de la distanță trag mai departe, iar asediul are atac mai mare. Egiptenii nu atacă cât timp ai cartea.</STRING>
		<STRING hash="755784580" hash_i="756766928" needed="1">Începe o bătălie cu Generalul Memnon. Mereu camuflat. Măiestria se reface de 2x mai repede. Trupele din apropiere primesc un bonus de armură. Jucat pe un teritoriu, îl crește cu 4 niveluri.</STRING>
		<STRING hash="468751536" hash_i="468826928" needed="1">Poate forța o națiune să se alieze cu tine sau să-ți declare război pentru o tură, apoi să revină la starea diplomatică inițială.</STRING>
		<STRING hash="764984913" hash_i="777150973" needed="1">Austria nu te atacă cât timp îl ai. Apare în bătălie ca un Comando mereu camuflat. Începe cu $NUM0 Comando și le crește viteza de reîncărcare.</STRING>
		<STRING hash="665422940" hash_i="667377854" needed="1">Apare în bătălie ca un Comando cu puncte de viață duble, tragere de lunetist și sabotaj rapide. Pe harta strategică, Paoli poate elibera vasalul altei națiuni.</STRING>
		<STRING hash="935318233" hash_i="941544937" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește puterea garnizoanei. Se poate retranșa oriunde de 2x mai repede, cu 150% protecție. Cât timp ai cartea, primești tribut dublu când nu ataci.</STRING>
		<STRING hash="800469191" hash_i="807059895" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește puterea garnizoanei. Se poate retranșa oriunde de 2x mai repede, cu 150% protecție. Primești tribut de 2x când nu ataci.</STRING>
		<STRING hash="780385625" hash_i="786398675" needed="1">Începe o bătălie cu Generalul Antipatros. Mărește puterea garnizoanei. Se poate retranșa oriunde de 2x mai repede. Cât timp ai cartea, primești tribut dublu când nu ataci.</STRING>
		<STRING hash="908986529" hash_i="909124377" needed="1">Începe o bătălie cu Generalul Ptolemeu. În raza lui, unitățile au +1 la apărare, cele de la distanță trag mai departe, iar unitățile de asediu au atac mai mare. Egiptenii nu atacă cât timp ai cartea.</STRING>
		<STRING hash="855385148" hash_i="855254228" needed="1">Începe o bătălie cu Generalul Ptolemeu. Unitățile din raza lui au +1 la apărare, cele de la distanță trag mai departe, iar unitățile de asediu au +1 la atac. Egiptenii nu atacă cât timp ai cartea.</STRING>
		<STRING hash="817933653" hash_i="819315247" needed="1">Începe o bătălie cu Generalul Memnon. Mereu camuflat. Măiestria se reface de 2x mai repede. Trupele din apropiere primesc un bonus de armură. Joacă-l pe harta strategică pentru a crește un teritoriu cu 4 niveluri.</STRING>
		<STRING hash="996561436" hash_i="1016149664" needed="1">Începe o bătălie cu Generalul Spitamenes. Aduce cavalerie suplimentară. În raza lui crește viteza cavaleriei și atacul Arcașilor călare. Pe harta strategică, face barbar un teritoriu inamic care nu e Capitală.</STRING>
		<STRING hash="747872918" hash_i="740963612" needed="1">Începe o bătălie cu Generalul Porus. Bonus de viteză pentru elefanții din apropiere, creează momeli de 2x și vede unitățile camuflate. Cât timp îl ai, poți construi elefanți.</STRING>
		<STRING hash="919198666" hash_i="938744046" needed="1">Începe o bătălie cu Generalul Spitamenes. Aduce cavalerie suplimentară. În raza lui crește viteza și atacul Arcașilor călare. Pe harta strategică, face barbar un teritoriu inamic care nu e Capitală.</STRING>
		<STRING hash="836423442" hash_i="845194230" needed="1">Începe o bătălie cu Generalul Spitamenes. Aduce cavalerie suplimentară. În raza lui crește viteza și atacul Arcașilor călare. Pe harta strategică, face barbar un teritoriu inamic.</STRING>
		<STRING hash="101261270" hash_i="102548842" needed="1">Începe o bătălie cu $NUM0 Spioni în plus.</STRING>
		<STRING hash="1005393201" hash_i="1003083153" needed="1">Începe o bătălie cu Generalul Memnon. Mereu camuflat. Măiestria se reface de 2x mai repede. Face Mercenarii greci din apropiere la fel de puternici ca Falanga. Joacă-l pe harta strategică pentru a crește un teritoriu cu 4 niveluri.</STRING>
		<STRING hash="859797339" hash_i="878759485" needed="1">Începe o bătălie cu Generalul Parmenion. Aduce Cavalerie suplimentară și mărește atacul Cavaleriei din apropiere. Ambuscada durează mai mult și costă mai puțină măiestrie. Poate fi jucat de două ori.</STRING>
		<STRING hash="756149052" hash_i="755593566" needed="1">Apare în bătălie ca un Comando cu puncte de viață duble, tragere de lunetist și sabotaj rapide. Pe harta strategică, Paoli poate elibera vasalul altei națiuni.</STRING>
	</CAT>
