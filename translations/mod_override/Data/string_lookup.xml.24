	<CAT hash="44397162">
		<STRING hash="34157738" hash_i="34133086" needed="1">Ai câștigat bătălia.</STRING>
		<STRING hash="82012261" hash_i="81987609" needed="1">I-ai stârpit pe mercenari.</STRING>
		<STRING hash="113504005" hash_i="113479353" needed="1">Ai învins toate triburile nomade.</STRING>
		<STRING hash="84115919" hash_i="84091267" needed="1">I-ai stârpit pe mercenari.</STRING>
		<STRING hash="111333699" hash_i="111309047" needed="1">Ai traversat cu succes deșertul!</STRING>
		<STRING hash="29337395" hash_i="29467319" needed="1">Ai unificat Grecia.</STRING>
		<STRING hash="35815269" hash_i="36034993" needed="1">Ai cucerit Egiptul.</STRING>
		<STRING hash="54706888" hash_i="54996578" needed="1">I-ai învins pe Magadha.</STRING>
		<STRING hash="36085555" hash_i="36248479" needed="1">Ai cucerit India.</STRING>
		<STRING hash="51797082" hash_i="52086772" needed="1">I-ai învins pe Maurya.</STRING>
		<STRING hash="48942727" hash_i="50799331" needed="1">L-ai protejat pe Alexandru!</STRING>
		<STRING hash="62405071" hash_i="62752721" needed="1">Ai adunat destul Metal.</STRING>
		<STRING hash="42159644" hash_i="42134992" needed="1">Ai colonizat noi ținuturi.</STRING>
		<STRING hash="43452384" hash_i="43427732" needed="1">Ai câștigat războiul comercial.</STRING>
		<STRING hash="20511596" hash_i="20486944" needed="1">Ai reușit.</STRING>
		<STRING hash="53554556" hash_i="53529904" needed="1">I-ai oprit pe invadatori.</STRING>
		<STRING hash="80249280" hash_i="80224628" needed="1">I-ai stârpit pe mercenari!</STRING>
		<STRING hash="186815686" hash_i="187150976" needed="1">Majoritatea revoltelor s-au potolit. Puterea ta este intactă.</STRING>
		<STRING hash="64785017" hash_i="64769589" needed="1">Franța a răsturnat monarhia.</STRING>
		<STRING hash="44813056" hash_i="44788404" needed="1">Ai traversat deșertul.</STRING>
		<STRING hash="67275366" hash_i="67250714" needed="1">I-ai stârpit pe tâlhari.</STRING>
		<STRING hash="31182624" hash_i="31157972" needed="1">Ai câștigat bătălia.</STRING>
		<STRING hash="31208788" hash_i="31184136" needed="1">Ai câștigat bătălia.</STRING>
		<STRING hash="56459057" hash_i="56434405" needed="1">Ai îndeplinit misiunea.</STRING>
	</CAT>
	<CAT hash="38438024">
		<STRING hash="37310381" hash_i="37285729" needed="1">Ai pierdut bătălia.</STRING>
		<STRING hash="886320487" hash_i="884168747" needed="1">Armatele tale nu au întâmpinat nicio rezistență la ocuparea teritoriului.  Însă băștinașii s-au regrupat și îți asaltează noul avanpost.  Apără-ți capitala până expiră cronometrul ca să câștigi.</STRING>
		<STRING hash="460127993" hash_i="464950815" needed="1">Armata ta se apropie de o armată barbară.  Atacă-i tabăra și distruge-i toate clădirile ca să câștigi.</STRING>
		<STRING hash="699657885" hash_i="699635379" needed="1">Națiunile barbare din această regiune sunt slabe și se vor pleca sigur în fața națiunii tale dacă îți dovedești superioritatea cucerind unul dintre orașele lor.</STRING>
		<STRING hash="782757605" hash_i="781563091" needed="1">În acest teritoriu, mai multe triburi băștinașe se luptă pentru putere.  Folosește-ți abilitățile diplomatice ca să le asmuți unele împotriva altora și să-ți asiguri dominația în zonă.</STRING>
		<STRING hash="1041644836" hash_i="1049167724" needed="1">Un grup de triburi barbare din această regiune s-a unit ca să te distrugă.  Din fericire, ai adus provizii suplimentare, iar barbarii sunt cu o Epocă în urma ta.  Supraviețuiește până expiră cronometrul ca să câștigi.</STRING>
		<STRING hash="34211834" hash_i="34187182" needed="1">Ai pierdut bătălia.</STRING>
		<STRING hash="85798563" hash_i="85776057" needed="1">Mercenarii te-au copleșit.</STRING>
		<STRING hash="174879179" hash_i="174854527" needed="1">Nu ai reușit să învingi toate triburile nomade.</STRING>
		<STRING hash="86459437" hash_i="86436931" needed="1">Mercenarii te-au copleșit.</STRING>
		<STRING hash="450505024" hash_i="450480372" needed="1">Ai pierit în nisipuri, unde oasele tale ar hrăni vulturii, dacă nu le-ar fi și lor prea cald.</STRING>
		<STRING hash="60237741" hash_i="60592993" needed="1">Nu ai reușit să unifici Grecia.</STRING>
		<STRING hash="84636528" hash_i="87379740" needed="1">Nu ai reușit să-l protejezi pe Alexandru!</STRING>
		<STRING hash="67149673" hash_i="67515349" needed="1">Nu ai adunat destul Metal.</STRING>
		<STRING hash="65336844" hash_i="65312192" needed="1">Coloniștii tăi au fost învinși.</STRING>
		<STRING hash="29252721" hash_i="29228069" needed="1">Ai fost învins.</STRING>
		<STRING hash="35405839" hash_i="37285729" needed="1">Ai pierdut bătălia.</STRING>
		<STRING hash="46968490" hash_i="46943838" needed="1">Ai pierdut războiul comercial.</STRING>
		<STRING hash="62200690" hash_i="62176038" needed="1">Poporul tău va muri de foame.</STRING>
		<STRING hash="70563669" hash_i="70541163" needed="1">Invadatorii te-au copleșit.</STRING>
		<STRING hash="37290612" hash_i="37265960" needed="1">Ai murit în nisip.</STRING>
		<STRING hash="70807061" hash_i="70784555" needed="1">Tâlharii te-au copleșit.</STRING>
		<STRING hash="34157738" hash_i="34133086" needed="1">Ai câștigat bătălia.</STRING>
		<STRING hash="40929481" hash_i="40904829" needed="1">Ai pierdut bătălia.</STRING>
		<STRING hash="44917033" hash_i="44892381" needed="1">Ai eșuat în misiune.</STRING>
		<STRING hash="444407072" hash_i="444382420" needed="1">Ai pierit în nisipuri, unde oasele tale ar hrăni vulturii, dacă nu le-ar fi și lor prea cald.</STRING>
		<STRING hash="55704156" hash_i="55679504" needed="1">Ai pierit în nisipuri.</STRING>
		<STRING hash="79414608" hash_i="79392102" needed="1">Mercenarii te-au părăsit.</STRING>
	</CAT>
