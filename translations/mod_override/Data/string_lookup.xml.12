	<CAT hash="30698867">
		<STRING hash="66457806" hash_i="66439508" needed="1">Tenez l'ennemi à distance pendant 15 minutes.</STRING>
		<STRING hash="41980852" hash_i="42056244" needed="1">Capturez la capitale ennemie.</STRING>
		<STRING hash="90105976" hash_i="90090548" needed="1">Recherchez et capturez la capitale ennemie.</STRING>
		<STRING hash="36412767" hash_i="36398297" needed="1">Détruisez l'armée ennemie.</STRING>
		<STRING hash="49582913" hash_i="49658305" needed="1">Capturez une cité barbare.</STRING>
		<STRING hash="51377575" hash_i="51363105" needed="1">Anéantissez les tribus barbares.</STRING>
		<STRING hash="208440775" hash_i="208516167" needed="1">Prenez la capitale ennemie ou remportez la victoire en capturant une partie de territoire.</STRING>
		<STRING hash="164281570" hash_i="164356962" needed="1">Capturez une cité dans chaque nation pour les vaincre.</STRING>
		<STRING hash="59485593" hash_i="59471123" needed="1">Détruisez le campement ennemi.</STRING>
		<STRING hash="37152612" hash_i="37138142" needed="1">Vainquez l'armée d'invasion.</STRING>
		<STRING hash="66307671" hash_i="66289373" needed="1">Repoussez l'ennemi pendant 30 minutes.</STRING>
		<STRING hash="74894997" hash_i="74880527" needed="1">Défendez votre capitale pendant 15 minutes.</STRING>
		<STRING hash="115951391" hash_i="115933093" needed="1">Repoussez l'ennemi jusqu'à la fin du temps imparti.</STRING>
		<STRING hash="119025659" hash_i="120479815" needed="1">Prenez la capitale ennemie en $NUM0 minutes.</STRING>
		<STRING hash="172875505" hash_i="175801469" needed="1">Prenez la capitale ennemie ou résistez pendant $NUM0 minutes.</STRING>
		<STRING hash="137773498" hash_i="139438982" needed="1">Prenez la(les) capitale(s) ennemie(s) en moins de $NUM0 minutes.</STRING>
		<STRING hash="177875231" hash_i="182163563" needed="1">Prenez la(les) capitale(s) ennemie(s) ou résistez pendant $NUM0 minutes.</STRING>
		<STRING hash="178310682" hash_i="178295254" needed="1">Trouvez et prenez la capitale ennemie en moins de 120 minutes.</STRING>
		<STRING hash="275982086" hash_i="273091602" needed="1">Prenez la capitale ennemie ou une grande partie de son territoire en $NUM0 minutes.</STRING>
		<STRING hash="208496370" hash_i="205072638" needed="1">Capturez une ville de chaque nation afin de les vaincre en moins de $NUM0 minutes.</STRING>
		<STRING hash="120889362" hash_i="120874892" needed="1">Triomphez des tribus barbares en moins de 120 minutes.</STRING>
		<STRING hash="184997339" hash_i="185239729" needed="1">Éliminez tous les Généraux ennemis ou contrôlez 70% du territoire.</STRING>
		<STRING hash="28336424" hash_i="28321954" needed="1">Détruisez 25 unités ennemies.</STRING>
		<STRING hash="36451857" hash_i="36527249" needed="1">Capturez toutes les villes ennemies.</STRING>
		<STRING hash="300951086" hash_i="310168264" needed="1">Capturez la/les capitale(s) ennemie(s) en $NUM0 minutes.  Astuce: Utilisez vos Citoyens pour construire une Ville.</STRING>
		<STRING hash="177238943" hash_i="177356807" needed="1">Tuez tous les Généraux ennemis ou capturez 70% du territoire.</STRING>
		<STRING hash="219662756" hash_i="220807570" needed="1">Déplacez Alexandre près du Temple à Tyre ou capturez la capitale ennemie.</STRING>
		<STRING hash="219870870" hash_i="219852572" needed="1">Dépêchez-vous à traverser le désert vers la Tour de Vigie avant que le temps ne soit écoulé.</STRING>
		<STRING hash="149587090" hash_i="149565514" needed="1">Utilisez la force et la diplomatie pour conquérir tous les ennemis.</STRING>
