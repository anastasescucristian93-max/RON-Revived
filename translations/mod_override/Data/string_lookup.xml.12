		<STRING hash="3362659" hash_i="3340837" needed="1">Standard</STRING>
		<STRING hash="1005028" hash_i="987628" needed="1">Grand</STRING>
		<STRING hash="553863" hash_i="535565" needed="1">Immense</STRING>
		<STRING hash="2690747" hash_i="2739779" needed="1">Gigantesque</STRING>
		<STRING hash="180303618" hash_i="180281112" needed="1">Prenez le pouvoir de cette nation le temps d'une bataille.</STRING>
		<STRING hash="183688558" hash_i="186317930" needed="1">Construisez une merveille de cet âge sur un territoire occupé.</STRING>
		<STRING hash="194902380" hash_i="194885174" needed="1">Rendez un territoire occupé invulnérable aux attaques.</STRING>
		<STRING hash="219355655" hash_i="218356809" needed="1">Détruisez les défenses d'un territoire protégé par le bonus « Fortifier ».</STRING>
		<STRING hash="100842296" hash_i="100820474" needed="1">Commencez une bataille avec une technologie supplémentaire.</STRING>
		<STRING hash="214321010" hash_i="214299568" needed="1">Recevez une augmentation de 5 % de la production de cette ressource en une bataille.</STRING>
		<STRING hash="78231022" hash_i="78303896" needed="1">Commencez une bataille avec des troupes supplémentaires.</STRING>
		<STRING hash="200566579" hash_i="200550723" needed="1">Gagnez un territoire sans capitale ni fortification, sans vous battre.</STRING>
		<STRING hash="197341710" hash_i="197409416" needed="1">Toutes les recherches lors de la prochaine bataille sont 20 % plus rapides et 20 % moins chères.</STRING>
		<STRING hash="314900243" hash_i="314980239" needed="1">Les biens du marché vendus le temps d'une bataille sont 20 % moins chers à l'achat et rapportent 20 % de plus.</STRING>
		<STRING hash="242748025" hash_i="242726449" needed="1">Les unités guérissent 50 % plus vite et sont à l'abri des dégâts progressifs le temps d'une bataille.</STRING>
		<STRING hash="226046937" hash_i="226029959" needed="1">L'invasion des troupes ennemies entraîne 50 % de dégâts progressifs supplémentaires le temps d'une bataille.</STRING>
		<STRING hash="202254843" hash_i="202240705" needed="1">Les tribus ennemies sont privées de leur pouvoir national le temps d'une bataille.</STRING>
		<STRING hash="239345225" hash_i="239331087" needed="1">Les tribus ennemies ne profitent pas de leurs ressources stratégiques le temps d'une bataille.</STRING>
		<STRING hash="180183029" hash_i="180167173" needed="1">Prenez le pouvoir de la nation ennemie le temps d'une bataille.</STRING>
		<STRING hash="486640902" hash_i="496131788" needed="1">Commencez une bataille avec un bonus de +$NUM0 de chaque ressource. Cette quantité dépend de vos performances au cours d'une bataille barbare.</STRING>
		<STRING hash="226159838" hash_i="226142632" needed="1">Rendez un territoire occupé et sans capitale invulnérable aux attaques.</STRING>
		<STRING hash="207058700" hash_i="207037258" needed="1">Réduire la puissance territoriale d'un ennemi de deux niveaux.</STRING>
		<STRING hash="211089915" hash_i="211068473" needed="1">Réduire la puissance territoriale d'un ennemi de deux niveaux.</STRING>
		<STRING hash="1236480" hash_i="1304186" needed="1">Arène</STRING>
		<STRING hash="559909775" hash_i="561287125" needed="1">Gagnez un territoire dépourvu de capitale sans combattre. Le territoire visé doit être adjacent au vôtre et avoir une puissance de quatre au maximum.</STRING>
		<STRING hash="733441215" hash_i="738771179" needed="1">Démarrez bataille ac 1 bonus de +$NUM0 de chq resrce, selon le nbre d'hommes survivant à Bataille sur le terrain ou Tactiques.</STRING>
		<STRING hash="169090987" hash_i="169075131" needed="1">Obtenir les pouvoirs spéciaux de cette nation le temps d'une bataille.</STRING>
		<STRING hash="204222049" hash_i="204207911" needed="1">Les nations ennemies sont privées de leur pouvoir national le temps d'une bataille.</STRING>
		<STRING hash="249376835" hash_i="249362697" needed="1">Les nations ennemies ne profitent pas de leurs ressources stratégiques le temps d'une bataille.</STRING>
		<STRING hash="219151950" hash_i="226481378" needed="1">Construisez une merveille de cet âge ou d'un âge antérieur sur un territoire occupé.</STRING>
		<STRING hash="254275421" hash_i="254253845" needed="1">Les unités guérissent 100 % plus vite et sont à l'abri des dégâts progressifs le temps d'une bataille.</STRING>
		<STRING hash="575779819" hash_i="575763379" needed="1">Commencer la bataille avec un bonus de +$NUM0 de chaque ressource.  Le montant du bonus dépend de votre performance dans la bataille où il a été décerné.</STRING>
		<STRING hash="230095683" hash_i="230073177" needed="1">Transportez une armée sur un territoire où il n'y a pas d'armée sous votre contrôle.</STRING>
		<STRING hash="186897443" hash_i="186876001" needed="1">Réduisez la force territoriale de la Capitale d'un ennemi de moitié.</STRING>
		<STRING hash="85185476" hash_i="85163654" needed="1">Commencer une bataille avec la carte decouverte.</STRING>
		<STRING hash="122694029" hash_i="122672207" needed="1">Commencer une bataille avec une brigade d'Éléphants de Guerre.</STRING>
		<STRING hash="905809725" hash_i="911448839" needed="1">Commencer la bataille avec le Général Parmenio. Donne une cavalerie supplémentaire et augmente l'attaque d'une cavalerie à proximité. Les Embuscades durent plus longtemps et demandent moins de points d'énergie. Cette Carte peut être jouée deux fois.</STRING>
		<STRING hash="1406174271" hash_i="1416362133" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force d'attaque des garnisons lorsque placé et donne une protection supplémentaire dans les tranchées.  Peut se retrancher n'importe où et la vitesse de retranchement est doublée. Tant que la Carte est en votre possession, recevez un double Tribut quand aucune attaque n'est effectuée.</STRING>
		<STRING hash="1142817932" hash_i="1135284314" needed="1">Commencer une bataille avec le Général Ptolemy.  Les unités à distance ont une portée accrue et Ligne-de-Mire, les armes de siège ont une attaque accrue, et la défense de toutes les unités est améliorée dans sa zone d'effet. Tant que vous tenez la Carte, Egypte n'attaquera pas.</STRING>
		<STRING hash="1226090010" hash_i="1239400894" needed="1">Commencer une bataille avec le Général Memnon.  Il est toujours camouflé. Double vitesse de régénération d'énergie. Les troupes à proximité peuvent marcher à travers les forêts et obtiennent une armure supplémentaire. Peut aussi être jouée sur la carte stratégique pour améliorer un territoire de quatre niveaux.</STRING>
		<STRING hash="1861766412" hash_i="1872626344" needed="1">Commencer une bataille avec le Général Spitamenes et cinq Archers Montés supplémentaires. Fournit attaque accrue à proximité des Archers de chevaux et une vitesse accrue à proximité de cavalerie. Peut être jouée sur la carte stratégique pour provoquer une révolte dans un territoire ennemi sans capitale et le changer en territoire barbare.</STRING>
		<STRING hash="1764796540" hash_i="1777216642" needed="1">Commencer une bataille avec le Général Porus et la capacité de construire des Éléphants de Guerre.  Donne un Bonus de vitesse aux Éléphants de Guerre à proximité.  Double la création de pièges. Peut détecter les Espions ennemis et les unités camouflées. A plus de points de vie que d'autres Généraux spéciaux. Détenir cette Carte donne aussi la capacité de construire des Éléphants de Guerre.</STRING>
		<STRING hash="197620251" hash_i="197604395" needed="1">Obtenez des Informateurs dans tous les bâtiments militaires ennemis durant une bataille.</STRING>
		<STRING hash="258044463" hash_i="258023619" needed="1">Empêche une armée de percevoir un revenu colonial et les ressources rares pendant deux tours.</STRING>
		<STRING hash="218900306" hash_i="218885836" needed="1">Désactive la possibilité pour les ennemis de mettre en place un gouvernement pour une seule bataille.</STRING>
		<STRING hash="169235689" hash_i="170602355" needed="1">Réduisez la force territoriale de la Grande-Bretagne de deux.</STRING>
		<STRING hash="110883996" hash_i="111066750" needed="1">Prenez jusqu'à $NUM0 de Tribut de chaque nation.</STRING>
		<STRING hash="269122904" hash_i="269101082" needed="1">Commencer une bataille avec une Caserne, une Écurie, une Usine d'armes de Siège, et 2 technologies militaires.</STRING>
		<STRING hash="250093675" hash_i="250276429" needed="1">Le Temple a un impact plus grand de $NUM0% sur les Frontières, la Taxation et les points de vie.</STRING>
		<STRING hash="124066613" hash_i="124916739" needed="1">Commencer une bataille avec $NUM0 Citoyens supplémentaires.</STRING>
		<STRING hash="830691122" hash_i="827478638" needed="1">Peut forcer deux nations à entrer en guerre si jouée sur la carte stratégique.  Dans une bataille, c'est un Espion qui a une énergie triple qui révèle la carte.  Les unités dans sa zone d'effet ne peuvent être soudoyées ni snipées.</STRING>
		<STRING hash="522377667" hash_i="522453059" needed="1">Peut forcer une nation à s'allier avec vous ou à entrer en guerre contre vous pour un tour avant de retourner à l'état diplomatique de base.</STRING>
		<STRING hash="1177422212" hash_i="1167017348" needed="1">Tant que vous la tenez, Austria ne vous attaquera jamais.  Lorsque joué dans une bataille, débute en tant que Commando avec le double d'énergie.  Il est toujours camouflé, débute avec une équipe de $NUM0 Commandos, et augmente leur taux de recharge.</STRING>
		<STRING hash="282032819" hash_i="282010313" needed="1">Transportez une armée sur un territoire que vous contrôlez et qui ne possède pas d'armée.</STRING>
		<STRING hash="184945059" hash_i="186876001" needed="1">Réduisez la force territoriale de la Capitale d'un ennemi de moitié.</STRING>
		<STRING hash="151528129" hash_i="152649187" needed="1">Commencer une bataille avec une brigade d'Éléphants de Guerre.</STRING>
		<STRING hash="1254270684" hash_i="1262129638" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force d'attaque des garnisons lorsque placé et donne une protection supplémentaire dans les tranchées. Peut se retrancher n'importe où et la vitesse de retranchement est doublée. Tant que vous tenez la Carte, recevez un double Tribut quand aucune attaque n'est effectuée.</STRING>
		<STRING hash="1294930081" hash_i="1286868227" needed="1">Commencer une bataille avec le Général Ptolemy. Les unités à distance ont une portée accrue et Ligne-de-Mire, les armes de siège ont une attaque accrue, et la défense de toutes les unités est améliorée dans sa zone d'effet. Tant que vous tenez la Carte, les Égyptiens n'attaqueront pas.</STRING>
		<STRING hash="1086523896" hash_i="1096760282" needed="1">Commencer une bataille avec le Général Memnon. Il est toujours camouflé. 2x en vitesse de régénération de l'énergie. Les troupes à proximité obtiennent une armure supplémentaire. Peut aussi être jouée sur la carte stratégique pour améliorer un territoire de quatre niveaux.</STRING>
		<STRING hash="1895881406" hash_i="1932498458" needed="1">Commencer une bataille avec le Général Spitamenes et cinq Archers Montés supplémentaires. Donne une meilleure attaque aux Archers Montés et une vitesse accrue aux unités de cavalerie à proximité. Peut être jouée sur la carte stratégique pour provoquer une révolte dans un territoire ennemi sans capitale et le changer en territoire barbare.</STRING>
		<STRING hash="1698892994" hash_i="1691929482" needed="1">Commencer une bataille avec le Général Porus. Donne un Bonus de vitesse aux Éléphants de Guerre à proximité. Double la création de pièges. Peut détecter les Espions ennemis et les unités camouflées. A plus de points de vie que d'autres Généraux spéciaux. En tenant cette Carte en main, vous avez la possibilité de former des Éléphants de Guerre.</STRING>
		<STRING hash="197637493" hash_i="197604395" needed="1">Obtenez des Informateurs dans tous les bâtiments militaires ennemis durant une bataille.</STRING>
		<STRING hash="295313493" hash_i="300785097" needed="1">Commencer une bataille avec une Caserne, une Écurie, une Usine d'armes de Siège, et 2 technologies militaires.</STRING>
		<STRING hash="240660069" hash_i="250276429" needed="1">Le Temple a un impact plus grand de $NUM0% sur les Frontières, la Taxation et les points de vie.</STRING>
		<STRING hash="120226677" hash_i="124916739" needed="1">Commencer une bataille avec $NUM0 Citoyens supplémentaires.</STRING>
		<STRING hash="827554776" hash_i="824543798" needed="1">Peut forcer deux nations à entrer en guerre si jouée sur la carte stratégique. Dans une bataille, c'est un Espion qui a une énergie triple qui révèle la carte. Les unités dans sa zone d'effet ne peuvent être soudoyées ni snipées.</STRING>
		<STRING hash="470253243" hash_i="470328635" needed="1">Peut forcer une nation à s'allier avec vous ou à entrer en guerre contre vous pour un tour avant de retourner à l'état diplomatique de base.</STRING>
		<STRING hash="1152478725" hash_i="1160002091" needed="1">Tant que vous la tenez, Austria ne vous attaquera jamais. Lorsque joué dans une bataille, débute en tant que Commando avec le double d'énergie. Il est toujours camouflé, débute avec une équipe de $NUM0 Commandos, et augmente leur taux de recharge.</STRING>
		<STRING hash="667960444" hash_i="667377854" needed="1">Apparaît sur le champ de bataille comme Commando avec doubles points de vie, précision et sabotage rapides. Sur la carte stratégique, Paoli peut libérer le vassal d'une autre nation.</STRING>
		<STRING hash="928036015" hash_i="934141569" needed="1">Commencer une bataille avec le Général Parmenio. Donne une cavalerie supplémentaire et augmente l'attaque d'une cavalerie à proximité. Les Embuscades durent plus longtemps et demandent moins de points d'énergie. Cette Carte peut être jouée deux fois.</STRING>
		<STRING hash="872043771" hash_i="878759485" needed="1">Commencer avec le Général Parmenio. Donne une cavalerie, augmente l'attaque d'une cavalerie proche. Embuscades plus longues et requièrent moins d'énergie. Peut être joué deux fois.</STRING>
		<STRING hash="837769135" hash_i="845101017" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force d'attaque des garnisons. Peut se retrancher n'importe où à 2x en vitesse avec de la protection supplémentaire. Tant que vous la tenez, recevez 2x de Tribut pour ne pas attaquer.</STRING>
		<STRING hash="991616727" hash_i="985966701" needed="1">Commencer une bataille avec le Général Ptolemy. Les unités à distance ont une portée accrue et Ligne-de-Mire, les armes de siège ont une attaque accrue, et la défense de toutes les unités est améliorée dans sa zone d'effet. Tant que vous la tenez, les Égyptiens n'attaqueront pas.</STRING>
		<STRING hash="807064063" hash_i="816621473" needed="1">Commencer une bataille avec le Général Memnon. Il est toujours camouflé. 2x en vitesse de régénération de l'énergie. Les troupes à proximité obtiennent une armure supplémentaire. Puede jugarse en un territorio para mejorarlo 4 niveles.</STRING>
		<STRING hash="1022441392" hash_i="1039825250" needed="1">Commencer une bataille avec le Général Spitamenes. Donne une cavalerie supplémentaire.  Augmente la vitesse de cavalerie et l'attaque des Archers Montés dans la zone d'effet. Jouez sur un territoire non capital de l'ennemi pour le transformer en terre barbare.</STRING>
		<STRING hash="819123928" hash_i="821018802" needed="1">Commencer une bataille avec le Général Porus. Bonus de vitesse pour les éléphants à proximité. Crée 2x pièges and détecte les unités camouflées. A des points de vie supplémentaires. Tant que vous la tenez, vous pouvez former des éléphants.</STRING>
		<STRING hash="826830674" hash_i="822840436" needed="1">Commencer une bataille avec le Général Ptolemy. Les unités à distance ont une portée accrue et Ligne-de-Mire, les armes de siège ont une attaque accrue, et la défense de toutes les unités est améliorée dans sa zone d'effet. Tant que vous la tenez, Égyptiens n'attaquera pas.</STRING>
		<STRING hash="754409179" hash_i="766387981" needed="1">Commencer une bataille avec le Général Memnon. Toujours camouflé. 2x en vitesse de régénération de l'énergie. Les troupes à proximité obtiennent une armure supplémentaire. Peut être jouée sur un territoire pour l'améliorer de 4 niveaux.</STRING>
		<STRING hash="892366155" hash_i="908418295" needed="1">Commencer une bataille avec le Général Spitamenes. Donne une cavalerie supplémentaire. Accroît la vitesse à cheval et l'attaque des Archers Montés dans sa zone d'effet. Utilisez sur un territoire ennemi, Capitale exceptée, pour le transformer en territoire barbare.</STRING>
		<STRING hash="794894472" hash_i="796729654" needed="1">Commencer une bataille avec le Général Porus. Bonus de vitesse pour les éléphants à proximité. Crée 2x pièges and voit les unités camouflées. A des points de vie supplémentaires. Tant que vous la tenez, vous pouvez former des éléphants.</STRING>
		<STRING hash="817548040" hash_i="818400638" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force d'attaque des garnisons. Se retranche n'importe où à 2x avec vitesse et protection supplémentaire. Tant que vous la tenez, recevez 2x de Tribut pour ne pas attaquer.</STRING>
		<STRING hash="794282214" hash_i="792286448" needed="1">Commencer une bataille avec le Général Ptolemy. Les unités à distance tirent plus loin, les armes de siège ont une attaque plus élevée, et toute les unités ont +1 de défense dans sa zone d'effet. Tant que vous la tenez, Égyptiens n'attaquera pas.</STRING>
		<STRING hash="799667421" hash_i="798152687" needed="1">Commencer une bataille avec le Général Porus. Bonus de vitesse pour les éléphants proches, crée 2x leurres, voit les unités camouflées, et a des points de vie supplémentaires. Tant que vous la tenez, vous pouvez former des éléphants.</STRING>
		<STRING hash="790034629" hash_i="796777309" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force des garnisons. Peut se retrancher n'importe où à 2x en vitesse avec de la protection supplémentaire. Tant que vous la tenez, recevez 2x de Tribut pour ne pas attaquer.</STRING>
		<STRING hash="806331907" hash_i="804617201" needed="1">Commencer une bataille avec le Général Ptolemy. Les unités à distance tirent plus loin, les armes de siège ont une attaque plus élevée, et toute les unités ont +1 de défense dans sa zone d'effet. Tant que vous la tenez, Égyptiens n'attaquera pas.</STRING>
		<STRING hash="684259234" hash_i="682430816" needed="1">Commencer une bataille avec le Général Porus. Bonus de vitesse pour les éléphants à proximité, crée 2x leurres, et voit les unités camouflées. Tant que vous la tenez, vous pouvez former des éléphants.</STRING>
		<STRING hash="795285610" hash_i="802037508" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force des garnisons. Peut se retrancher n'importe où à 2x en vitesse avec 150% en protection. Tant que vous la tenez, recevez 2x de Tribut pour ne pas attaquer.</STRING>
		<STRING hash="800124960" hash_i="797957346" needed="1">Commencer une bataille avec le Général Ptolemy. Les unités à distance tirent plus loin, les armes de siège ont une attaque plus élevée, et toute les unités ont +1 de défense dans sa zone d'effet. Tant que vous la tenez, Égyptiens n'attaquera pas.</STRING>
		<STRING hash="507941220" hash_i="507283970" needed="1">Peut forcer deux nations à entrer en guerre si jouée sur la carte stratégique. Dans une bataille, c'est un Espion qui a une énergie triple qui révèle la carte.</STRING>
		<STRING hash="779106853" hash_i="786921001" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force des garnisons. Peut se retrancher n'importe où à 2x en vitesse avec 150% en protection. Obtenez 2x tribut pour ne pas avoir attaqué pendant l'occupation.</STRING>
		<STRING hash="755572550" hash_i="755327980" needed="1">Commencer une bataille avec le Général Ptolemy. Les unités ont +1 en défense dans la zone d'effet, les unités à distance tirent plus loin, et les unités de siège ont une attaque plus élevée. Égyptiens n'attaquera pas tant que la Carte est en main.</STRING>
		<STRING hash="755784580" hash_i="756766928" needed="1">Commencer une bataille avec le Général Memnon. Toujours camouflé. 2x en vitesse de régénération de l'énergie. Les troupes à proximité obtiennent une armure supplémentaire. Quand joué sur un territoire, l'améliore de 4 niveaux.</STRING>
		<STRING hash="468751536" hash_i="468826928" needed="1">Peut forcer une nation à s'allier avec vous ou à entrer en guerre contre vous pour un tour avant de retourner à l'état diplomatique de base.</STRING>
		<STRING hash="764984913" hash_i="777150973" needed="1">Austria ne vous attaquera pas tant que vous l'avez. Apparaît sur le champ de bataille comme un commando toujours camouflé. Il débute avec $NUM0 Commandos, et augmente leur taux de recharge.</STRING>
		<STRING hash="665422940" hash_i="667377854" needed="1">Apparaît sur le champ de bataille comme Commando avec doubles points de vie, précision et sabotage rapides. Sur la carte stratégique, Paoli peut libérer le vassal d'une autre nation.</STRING>
		<STRING hash="935318233" hash_i="941544937" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force des garnisons. Peut se retrancher n'importe où à 2x en vitesse avec 150% en protection. Tant que vous tenez la Carte, recevez un double Tribut quand aucune attaque n'est effectuée.</STRING>
		<STRING hash="800469191" hash_i="807059895" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force des garnisons. Peut se retrancher n'importe où à 2x en vitesse avec 150% en protection. Recevez 2x de Tribut quand aucune attaque n'est effectuée.</STRING>
		<STRING hash="780385625" hash_i="786398675" needed="1">Commencer une bataille avec le Général Antipater. Augmente la force des garnisons. Peut se retrancher n'importe où à 2x en vitesse. Tant que vous tenez la Carte, recevez un double Tribut quand aucune attaque n'est effectuée.</STRING>
		<STRING hash="908986529" hash_i="909124377" needed="1">Commencer une bataille avec le Général Ptolemy. Tandis que les unités à zone d'effet ont +1 en défense, les unités à distance tirent plus loin, et les unités de siège ont des attaques plus puissantes. Égyptiens n'attaquera pas tant que la Carte est en main.</STRING>
		<STRING hash="855385148" hash_i="855254228" needed="1">Commencer une bataille avec le Général Ptolemy. Les unités dans la zone d'effet ont +1 en défense, les unités à distance tirent plus loin, et les unités de siège ont +1 en attaque. Égyptiens n'attaquera pas tant que la Carte est en main.</STRING>
		<STRING hash="817933653" hash_i="819315247" needed="1">Commencer une bataille avec le Général Memnon. Toujours camouflé. 2x en vitesse de régénération de l'énergie. Les troupes à proximité obtiennent une armure supplémentaire. Jouez sur la carte stratégique pour améliorer un territoire de 4 niveaux.</STRING>
		<STRING hash="996561436" hash_i="1016149664" needed="1">Commencer une bataille avec le Général Spitamenes. Ajouter cavalerie supplémentaire. Accroît la vitesse à cheval et l'attaque des Archers Montés dans sa zone d'effet. Sur la carte stratégique, transforme les territoires ennemis sans Capitale en barbares.</STRING>
		<STRING hash="747872918" hash_i="740963612" needed="1">Commencer une bataille avec le Général Porus. Bonus de vitesse pour les éléphants à proximité, crée 2x leurres, et voit les unités camouflées. Tant que vous la tenez, vous pouvez former des éléphants.</STRING>
		<STRING hash="919198666" hash_i="938744046" needed="1">Commencer une bataille avec le Général Spitamenes. Ajouter cavalerie supplémentaire. Accroît la vitesse et l'attaque des Archers Montés dans sa zone d'effet. Sur la carte stratégique, transforme les territoires ennemis sans Capitale en barbares.</STRING>
		<STRING hash="836423442" hash_i="845194230" needed="1">Commencer une bataille avec le Général Spitamenes. Ajouter cavalerie supplémentaire. Accroît la vitesse et l'attaque des Archers Montés dans sa zone d'effet. Sur la carte stratégique, transforme les territoires ennemis en barbares.</STRING>
		<STRING hash="101261270" hash_i="102548842" needed="1">Commencer une bataille avec $NUM0 Espions supplémentaires.</STRING>
		<STRING hash="1005393201" hash_i="1003083153" needed="1">Commencer avec le Général Memnon. Toujours camouflé. Vitesse de régén. énergie : 2x. Merc. Grecs alentours aussi puissants que des Phalanges. Carte strat. : améliorer un territoire de 4 niv.</STRING>
		<STRING hash="859797339" hash_i="878759485" needed="1">Commencer une bataille avec le Général Parmenio. Donne une cavalerie supplémentaire et augmente l'attaque d'une cavalerie à proximité. Les Embuscades durent plus longtemps et demandent moins de points d'énergie. Il peut être joué deux fois.</STRING>
		<STRING hash="756149052" hash_i="755593566" needed="1">Apparaît sur le champ de bataille comme Commando avec doubles points de vie, précision et sabotage rapides. Sur la carte stratégique, Paoli peut libérer le vassal d'une autre nation.</STRING>
	</CAT>
