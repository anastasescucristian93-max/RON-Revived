	<CAT hash="44397162">
		<STRING hash="34157738" hash_i="34133086" needed="1">Vous avez gagné la bataille.</STRING>
		<STRING hash="82012261" hash_i="81987609" needed="1">Vous avez liquidé les mercenaires.</STRING>
		<STRING hash="113504005" hash_i="113479353" needed="1">Vous avez vaincu toutes les tribus nomades.</STRING>
		<STRING hash="84115919" hash_i="84091267" needed="1">Vous avez liquidé les mercenaires.</STRING>
		<STRING hash="111333699" hash_i="111309047" needed="1">Vous avez réussi à traverser le désert!</STRING>
		<STRING hash="29337395" hash_i="29467319" needed="1">Vous avez unifié le Grèce.</STRING>
		<STRING hash="35815269" hash_i="36034993" needed="1">Vous avez conquis Egypte.</STRING>
		<STRING hash="54706888" hash_i="54996578" needed="1">Vous avez vaincu le Magadha.</STRING>
		<STRING hash="36085555" hash_i="36248479" needed="1">Vous avez conquis Inde.</STRING>
		<STRING hash="51797082" hash_i="52086772" needed="1">Vous avez vaincu le Maurya.</STRING>
		<STRING hash="48942727" hash_i="50799331" needed="1">Vous avez protégé Alexandre!</STRING>
		<STRING hash="62405071" hash_i="62752721" needed="1">Vous avez récolté suffisamment de Métal.</STRING>
		<STRING hash="42159644" hash_i="42134992" needed="1">Vous avez colonisé de nouveaux territoires.</STRING>
		<STRING hash="43452384" hash_i="43427732" needed="1">Vous avez gagné la guerre commerciale.</STRING>
		<STRING hash="20511596" hash_i="20486944" needed="1">Vous avez réussi.</STRING>
		<STRING hash="53554556" hash_i="53529904" needed="1">Vous avez arrêté les envahisseurs.</STRING>
		<STRING hash="80249280" hash_i="80224628" needed="1">Vous avez liquidé les mercenaires!</STRING>
		<STRING hash="186815686" hash_i="187150976" needed="1">La plupart des révoltes se sont calmées. Votre puissance est intacte.</STRING>
		<STRING hash="64785017" hash_i="64769589" needed="1">France a renversé la monarchie.</STRING>
		<STRING hash="44813056" hash_i="44788404" needed="1">Vous avez traversé le désert.</STRING>
		<STRING hash="67275366" hash_i="67250714" needed="1">Vous avez liquidé les brigands.</STRING>
		<STRING hash="31182624" hash_i="31157972" needed="1">Vous avez gagné la bataille.</STRING>
		<STRING hash="31208788" hash_i="31184136" needed="1">Vous avez gagné la bataille.</STRING>
		<STRING hash="56459057" hash_i="56434405" needed="1">Vous avez terminé la mission.</STRING>
	</CAT>
	<CAT hash="38438024">
		<STRING hash="37310381" hash_i="37285729" needed="1">Vous avez perdu la bataille.</STRING>
		<STRING hash="886320487" hash_i="884168747" needed="1">Vos armées n'ont rencontré aucune résistance pendant l'invasion. Toutefois, l'ennemi s'est regroupé et attaque votre nouvel avant-poste. Défendez votre capitale jusqu'à la fin du temps imparti pour gagner.</STRING>
		<STRING hash="460127993" hash_i="464950815" needed="1">Votre armée approche une armée barbare. Attaquez leur campement et détruisez tous leurs bâtiments pour gagner.</STRING>
		<STRING hash="699657885" hash_i="699635379" needed="1">Les nations barbares de cette région sont faibles et se soumettront si vous parvenez à leur montrer votre supériorité en capturant une de leurs cités.</STRING>
		<STRING hash="782757605" hash_i="781563091" needed="1">Plusieurs tribus indigènes luttent pour le pouvoir sur ce territoire. Usez de vos compétences diplomatiques pour les monter l'une contre l'autre et assurer ainsi votre prédominance dans la région.</STRING>
		<STRING hash="1041644836" hash_i="1049167724" needed="1">Plusieurs tribus barbares de la région se sont unies pour vous détruire. Heureusement, vous avez emporté des provisions supplémentaires et les barbares sont dans un âge inférieur au vôtre. Pour gagner, restez en vie jusqu'à la fin du temps imparti.</STRING>
		<STRING hash="34211834" hash_i="34187182" needed="1">Vous avez perdu la bataille.</STRING>
		<STRING hash="85798563" hash_i="85776057" needed="1">Les Mercenaires vous ont anéantis.</STRING>
		<STRING hash="174879179" hash_i="174854527" needed="1">Vous n'avez pas réussi à vaincre toutes les tribus nomades.</STRING>
		<STRING hash="86459437" hash_i="86436931" needed="1">Les Mercenaires vous ont anéantis.</STRING>
		<STRING hash="450505024" hash_i="450480372" needed="1">Vous avez péri dans le sable, où vos restes nourriraient les vautours, s'il ne faisait pas trop chaud pour eux aussi.</STRING>
		<STRING hash="60237741" hash_i="60592993" needed="1">Vous n'avez pas réussi à unifier le Grèce.</STRING>
		<STRING hash="84636528" hash_i="87379740" needed="1">Vous n'avez pas réussi à protéger le Alexandre!</STRING>
		<STRING hash="67149673" hash_i="67515349" needed="1">Vous n'avez pas récolté assez de Métal.</STRING>
		<STRING hash="65336844" hash_i="65312192" needed="1">Vos colons ont été vaincus.</STRING>
		<STRING hash="29252721" hash_i="29228069" needed="1">Vous avez été vaincu.</STRING>
		<STRING hash="35405839" hash_i="37285729" needed="1">Vous avez perdu la bataille.</STRING>
		<STRING hash="46968490" hash_i="46943838" needed="1">Vous avez perdu la guerre commerciale.</STRING>
		<STRING hash="62200690" hash_i="62176038" needed="1">Votre peuple va mourir de faim.</STRING>
		<STRING hash="70563669" hash_i="70541163" needed="1">Les envahisseurs vous ont battus.</STRING>
		<STRING hash="37290612" hash_i="37265960" needed="1">Vous êtes mort dans le sable.</STRING>
		<STRING hash="70807061" hash_i="70784555" needed="1">Les brigands vous ont anéantis.</STRING>
		<STRING hash="34157738" hash_i="34133086" needed="1">Vous avez gagné la bataille.</STRING>
		<STRING hash="40929481" hash_i="40904829" needed="1">Vous avez perdu la bataille.</STRING>
		<STRING hash="44917033" hash_i="44892381" needed="1">Vous avez échoué la mission.</STRING>
		<STRING hash="444407072" hash_i="444382420" needed="1">Vous avez péri dans le sable, où vos restes nourriraient les vautours, s'il ne faisait pas trop chaud pour eux aussi.</STRING>
		<STRING hash="55704156" hash_i="55679504" needed="1">Vous avez péri dans le sable.</STRING>
		<STRING hash="79414608" hash_i="79392102" needed="1">Les Mercenaires vous ont abandonné.</STRING>
	</CAT>
