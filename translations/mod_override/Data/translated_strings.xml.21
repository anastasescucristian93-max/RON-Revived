	<STRING hash="105567293" needed="1">Brak miejsca, by kupiec się rozłożył.</STRING>
	<STRING hash="28501024" needed="1">Zwiadowca bezczynny.</STRING>
	<STRING hash="72452796" needed="1">Nie można dotrzeć do celu.</STRING>
	<STRING hash="85957301" needed="1">Brak zasobów na naprawę.</STRING>
	<STRING hash="101070157" needed="1">Nie można znaleźć miasta do handlu.</STRING>
	<STRING hash="218716308" needed="1">Nie można handlować z innymi narodami przed odkryciem „Handlu”</STRING>
	<STRING hash="253317981" needed="1">Szlaki handlowe pełne. Każde miasto może mieć 1 szlak handlowy do każdego celu.</STRING>
	<STRING hash="64627378" needed="1">Nie stać cię na to zaklęcie.</STRING>
	<STRING hash="61327187" needed="1">Brak tu rzadkich zasobów.</STRING>
	<STRING hash="205833409" needed="1">Senator może przekupywać jednostki tylko na przyjaznym terytorium.</STRING>
	<STRING hash="128438183" needed="1">Wrogi szpieg próbuje przekupstwa!</STRING>
	<STRING hash="137050314" needed="1">Wrogi szpieg umieszcza informatora!</STRING>
	<STRING hash="222610845" needed="1">Twoje samoloty się rozbijają, bo nie mają gdzie wylądować!</STRING>
	<STRING hash="35274179" needed="1">Baza lotnicza jest pełna.</STRING>
	<STRING hash="184462060" needed="1">Przed obsadzeniem garnizonu musisz zasymilować miasto.</STRING>
	<STRING hash="195460388" needed="1">Nie można dodać do garnizonu miasta, gdy jest uszkodzone w ponad 90%.</STRING>
	<STRING hash="173128833" needed="1">$UNITTYPE0 nie mieści się w tym budynku: $BUILDINGNAME1</STRING>
	<STRING hash="184135484" needed="1">Nie można obsadzić garnizonu budynku na terytorium wroga</STRING>
	<STRING hash="8536484" needed="1"> o, </STRING>
	<STRING hash="61337025" needed="1"> who : jednostka ma problemy.</STRING>
	<STRING hash="258228452" needed="1">Jednostki wojskowe na terytorium Rosji otrzymują obrażenia od „Rosyjskiej zimy”!</STRING>
	<STRING hash="237300063" needed="1">Jednostki wojskowe na terytorium wroga mogą otrzymywać obrażenia od wyniszczenia!</STRING>
	<STRING hash="235040544" needed="1">Buduj wozy zaopatrzeniowe w fabryce, aby zapobiec wyniszczeniu.</STRING>
	<STRING hash="248760936" needed="1">Buduj wozy zaopatrzeniowe w warsztacie oblężniczym, aby zapobiec wyniszczeniu.</STRING>
	<STRING hash="254202465" needed="1">Jednostki wojskowe mają trzydzieści sekund na opuszczenie terytorium byłego sojusznika.</STRING>
	<STRING hash="253956558" needed="1">Jednostki wojskowe mają trzydzieści sekund na opuszczenie terytorium byłego wroga.</STRING>
	<STRING hash="469176847" needed="1">Jednostki wojskowe na terytorium byłego sojusznika otrzymują ciężkie obrażenia od wyniszczenia! Wypowiedz wojnę przed atakiem.</STRING>
	<STRING hash="468445325" needed="1">Jednostki wojskowe na terytorium byłego wroga otrzymują ciężkie obrażenia od wyniszczenia! Wypowiedz wojnę przed atakiem.</STRING>
	<STRING hash="235037996" needed="1">Jednostki wojskowe na terytorium wroga otrzymują ciężkie obrażenia od wyniszczenia!</STRING>
	<STRING hash="483583171" needed="1">Jednostki wojskowe na terytorium neutralnego narodu otrzymują ciężkie obrażenia od wyniszczenia! Wypowiedz wojnę przed atakiem.</STRING>
	<STRING hash="310442145" needed="1">Jednostki wojskowe na terytorium narodu, który nie jest celem, otrzymują ciężkie obrażenia od wyniszczenia!</STRING>
