	<STRING hash="94567431" needed="1">: Już się tym zajmuję.</STRING>
	<STRING hash="21738191" needed="1">: Super.</STRING>
	<STRING hash="36097099" needed="1">: Jesteś wielki.</STRING>
	<STRING hash="129737840" needed="1">: O to chodzi.</STRING>
