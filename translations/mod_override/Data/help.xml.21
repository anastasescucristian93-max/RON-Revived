	<CONQUESTSPECIALCARDWIN>
		<SPOT>
			<ENTRY name="BONUS_CARD">
				<STRING>Karta bonusowa za umiejętności przyznawana jest za wygranie scenariusza bitwy polowej lub taktycznego. Wielkość premii zależy od tego, ile twoich wojsk przetrwało bitwę.</STRING>
