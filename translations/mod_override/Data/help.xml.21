			</ENTRY>
			<ENTRY name="NUM_PLAYERS">
				<STRING>Kliknij, aby wybrać preferowaną liczbę graczy.</STRING>
			</ENTRY>
			<PULLDOWN_ENTRIES>
				<ENTRY name="TEAM_STYLE0">
					<STRING>{Bez preferencji}: Wybierz tę opcję, jeśli nie zależy ci na tym, jaki styl drużyn zostanie użyty. Im mniej preferencji podasz, tym szybciej możesz zostać dobrany z przeciwnikami.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE1">
					<STRING>{1 na 1}: Wybierz tę opcję, jeśli chcesz grać przeciwko jednemu przeciwnikowi.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE2">
					<STRING>{2 na 2}: Wybierz tę opcję, jeśli chcesz zagrać w grę drużynową z dwoma graczami po każdej stronie.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE3">
					<STRING>{3 na 3}: Wybierz tę opcję, jeśli chcesz zagrać w grę drużynową z trzema graczami po każdej stronie.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE4">
					<STRING>{4 na 4}: Wybierz tę opcję, jeśli chcesz zagrać w grę drużynową z czterema graczami po każdej stronie.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE5">
					<STRING>{Zabójca}: Wybierz tę opcję, jeśli chcesz zagrać w grę Zabójca z co najmniej dwoma graczami, w której każdy gracz otrzymuje nację-cel i jest nagradzany za jej wyeliminowanie.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE6">
					<STRING>{Każdy na każdego}: Wybierz tę opcję, jeśli chcesz zagrać w grę każdy na każdego, w której co najmniej trzy nacje walczą o dominację.</STRING>
				</ENTRY>
				<ENTRY name="TEAM_STYLE7">
					<STRING>{Dyplomacja}: Wybierz tę opcję, jeśli chcesz zagrać w grę Dyplomacja, w której co najmniej trzy nacje rywalizują o dominację, ale mogą negocjować sojusze i traktaty pokojowe.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES0">
					<STRING>{Bez preferencji}: Wybierz tę opcję, jeśli nie zależy ci na tym, jakie zasady gry zostaną użyte. Im mniej preferencji podasz, tym szybciej możesz zostać dobrany z przeciwnikami.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES1">
					<STRING>{Standard}: Wybierz tę opcję, aby grać według standardowych zasad gry. Wygrywasz, podbijając przeciwników, budując cuda lub kontrolując 70% terytorium świata.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES2">
					<STRING>{Standard wojskowy}: Wybierz tę opcję, aby grać według zasad wojskowych. Wygrywasz, podbijając przeciwników lub kontrolując 80% terytorium świata. Zwycięstwo przez cuda jest niedozwolone.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES3">
					<STRING>{Deathmatch}: Wybierz tę opcję, aby zagrać w deathmatch. Gracze zaczynają w Starożytności z ogromnym zapasem każdego surowca.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES4">
					<STRING>{Deathmatch Epoki informacji}: Wybierz tę opcję, aby zagrać w deathmatch w Epoce informacji. Gracze zaczynają ze wszystkimi standardowymi technologiami już zbadanymi i z ogromnym zapasem każdego surowca. Broń jądrowa i technologie przyszłości są niedozwolone.</STRING>
				</ENTRY>
				<ENTRY name="GAME_RULES5">
					<STRING>{Bez szturmu}: Wybierz tę opcję, aby zagrać w grę Bez szturmu. Obowiązują standardowe zasady, ale gracze zaczynają w stanie pokoju i nie mogą się atakować, dopóki ktoś nie osiągnie Epoki prochu.</STRING>
				</ENTRY>
				<ENTRY name="MAPSTYLES0">
					<STRING>Wybierz tę opcję, jeśli nie zależy ci na tym, jaki typ mapy zostanie użyty. Im mniej preferencji podasz, tym szybciej możesz zostać dobrany z przeciwnikami.</STRING>
				</ENTRY>
			</PULLDOWN_ENTRIES>
			<ENTRY name="MAX_RATING">
				<STRING>Kliknij, aby wybrać maksymalny średni ranking przeciwników.</STRING>
			</ENTRY>
			<ENTRY name="MIN_RATING">
				<STRING>Kliknij, aby wybrać minimalny średni ranking przeciwników.</STRING>
			</ENTRY>
		</COMBOBOX>
	</GAMESPYQM>
	<GAMESPYQMINVITE>
		<LISTBOX>
			<ENTRY name="PLAYERS">
				<STRING>Kliknij, aby wybrać gracza z listy dostępnych graczy online. Podwójne kliknięcie zaprosi tego gracza do twojej drużyny i zamknie okno.</STRING>
			</ENTRY>
		</LISTBOX>
		<BUTTON>
			<ENTRY name="INVITE">
				<STRING>Kliknij, aby zaprosić wybranego gracza do swojej drużyny w tej grze.</STRING>
			</ENTRY>
			<ENTRY name="CANCEL">
				<STRING>Kliknij, aby zamknąć to okno i nie zapraszać nikogo do drużyny.</STRING>
			</ENTRY>
		</BUTTON>
	</GAMESPYQMINVITE>
	<GAMESPYCHOICE>
		<BUTTON>
			<ENTRY name="QUICKMATCH">
				<STRING>     Kliknij, aby przygotować rankingowy szybki mecz (zalecane). Zostaniesz automatycznie dobrany z innymi graczami na podstawie preferowanego typu gry i poziomu umiejętności graczy szukających gier.</STRING>
			</ENTRY>
			<ENTRY name="LOBBY">
				<STRING>     Kliknij, aby wejść do poczekalni. W poczekalni możesz założyć grę nierankingową z dowolnymi ustawieniami lub dołączyć do gry założonej przez innego gracza.</STRING>
			</ENTRY>
		</BUTTON>
		<SPOT>
			<ENTRY name="CHOICE_SPOT0">
				<STRING>     Kliknij, aby przygotować szybki mecz (zalecane). Zostaniesz automatycznie dobrany z innymi graczami na podstawie preferowanego typu gry i poziomu umiejętności graczy szukających gier.</STRING>
			</ENTRY>
			<ENTRY name="CHOICE_SPOT1">
				<STRING>     Kliknij, aby wejść do poczekalni. W poczekalni możesz założyć grę z dowolnymi ustawieniami lub dołączyć do gry założonej przez innego gracza.</STRING>
			</ENTRY>
		</SPOT>
	</GAMESPYCHOICE>
	<MAXPROFILELEN>
    18
  </MAXPROFILELEN>
	<CHAT>
		<AWAY>
			<ENTRY>/away (alias /back)</ENTRY>
			<ENTRY>Przełącza status nieobecności. Gracze, którzy napiszą do ciebie bezpośrednio podczas twojej nieobecności, dowiedzą się, że jesteś niedostępny. </ENTRY>
		</AWAY>
		<BROADCAST>
			<ENTRY>/broadcast {wiadomość} (alias /b)</ENTRY>
			<ENTRY>Wysyła wiadomość z pokoju przygotowań na czat kanału poczekalni</ENTRY>
			<ENTRY>Np.: /b Hej wszystkim, dołączcie do mojej gry!</ENTRY>
		</BROADCAST>
		<CHANNEL>
			<ENTRY>/channel {nazwa}  (alias /join)</ENTRY>
			<ENTRY>Ustawia twój bieżący kanał czatu.</ENTRY>
			<ENTRY>Np.: /channel PoczekalniaTurniejowa</ENTRY>
		</CHANNEL>
		<EMOTE>
			<ENTRY>/emote {wiadomość}  (alias /me, /em)</ENTRY>
			<ENTRY>Wysyła na czat wiadomość opisującą czynność.</ENTRY>
			<ENTRY>Np.: /emote macha do wszystkich.</ENTRY>
		</EMOTE>
		<FRIENDS>
			<ENTRY>/friends {polecenie} (alias /f)</ENTRY>
			<ENTRY>Daje dostęp do różnych poleceń zarządzania znajomymi</ENTRY>
			<ENTRY>- list - wyświetla listę wszystkich znajomych (alias l)</ENTRY>
			<ENTRY>- add {nazwa} - dodaje znajomego do listy znajomych (alias a)</ENTRY>
			<ENTRY>- remove {nazwa} - usuwa znajomego (alias r)</ENTRY>
			<ENTRY>- msg {wiadomość} - wysyła wiadomość do wszystkich znajomych (alias m)</ENTRY>
			<ENTRY>Przykłady: /friends list</ENTRY>
			<ENTRY>/f add BHG_Masta</ENTRY>
			<ENTRY>/f m Chcesz zagrać?</ENTRY>
		</FRIENDS>
		<OPTIONS>
			<ENTRY>/options</ENTRY>
			<ENTRY/>
		</OPTIONS>
		<IGNORE>
			<ENTRY>/squelch {użytkownik}  (alias /ignore)</ENTRY>
			<ENTRY>Ignoruj wiadomości od użytkownika</ENTRY>
			<ENTRY>Np.: /squelch BHG_Masta</ENTRY>
		</IGNORE>
		<UNIGNORE>
			<ENTRY>/unsquelch {użytkownik} (alias /unignore)</ENTRY>
			<ENTRY>Zezwól na odbieranie wiadomości od użytkownika</ENTRY>
			<ENTRY>Np.: /unsquelch BHG_Masta</ENTRY>
		</UNIGNORE>
		<WHISPER>
			<ENTRY>/whisper {użytkownik} {wiadomość}  (alias /w  /m  /msg)</ENTRY>
			<ENTRY>Wyślij prywatną wiadomość do użytkownika.</ENTRY>
			<ENTRY>Np.: /w BHG_Masta Chcesz zagrać?</ENTRY>
		</WHISPER>
		<WHO>
			<ENTRY>/who</ENTRY>
			<ENTRY>Wyświetl użytkowników na bieżącym kanale.</ENTRY>
		</WHO>
		<WHOIS>
			<ENTRY>/whois {użytkownik}  (alias /where  /whereis /stats)</ENTRY>
			<ENTRY>Wyświetl status gracza (online/offline), miejsce, w którym przebywa, i to, co robi.</ENTRY>
		</WHOIS>
		<WHOAMI>
			<ENTRY>/whoami</ENTRY>
			<ENTRY>Podaje znane informacje o użytkowniku.</ENTRY>
		</WHOAMI>
		<REJOIN>
			<ENTRY>/rejoin</ENTRY>
			<ENTRY>Ustawia użytkownika tak, aby odbierał tylko czat pokoju przygotowań</ENTRY>
		</REJOIN>
		<TIME>
			<ENTRY>/time</ENTRY>
		</TIME>
		<TEAM>
			<ENTRY>/team [wiadomość] (alias /t)</ENTRY>
			<ENTRY/>
		</TEAM>
		<USERS>
			<ENTRY>/users</ENTRY>
			<ENTRY/>
		</USERS>
		<HELP>
			<ENTRY>POMOC – POLECENIA CZATU:</ENTRY>
			<ENTRY>Oto lista dostępnych poleceń czatu.</ENTRY>
			<ENTRY>Wpisz /help {polecenie}, aby uzyskać pomoc dotyczącą danego polecenia.</ENTRY>
		</HELP>
	</CHAT>
