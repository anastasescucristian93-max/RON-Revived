		<REVEALMAPS>
			<!--Standard-->
			<!--Explored-->
			<!--All Visible-->
			<ENTRY name="REVEALMAP">
				<STRING>
{ODKRYJ MAPĘ}: Kliknij tutaj, aby określić, jaka część mapy jest widoczna na początku gry i czy działania wroga
są widoczne poza polem widzenia twoich jednostek.
</STRING>
			</ENTRY>
			<ENTRY name="REVEALMAPX">
				<STRING>
{ODKRYJ MAPĘ}: Określa, jaka część mapy jest widoczna na początku gry i czy działania
wroga są widoczne poza polem widzenia twoich jednostek.
</STRING>
			</ENTRY>
			<ENTRY name="REVEALMAPXS">
				<STRING>
{ODKRYJ MAPĘ}: Określa, jaka część mapy jest widoczna na początku gry i czy działania
wroga są widoczne poza polem widzenia twoich jednostek. [Nie można zmienić, gdy zasady gry są ustawione na Standard.]
</STRING>
			</ENTRY>
			<ENTRY name="REVEALMAP0">
				<STRING>




{BEZ WIDOKU SOJUSZN.}: Mapa jest na początku niezbadana i trzeba ją odkryć zwiadem, a żeby korzystać z pola widzenia sojuszników, trzeba zbadać w bibliotece 2. poziom nauki. Zmiany na mapie poza polem widzenia twoich jednostek nie są widoczne.




            </STRING>
			</ENTRY>
			<ENTRY name="REVEALMAP1">
				<STRING>{NORMALNIE}: Mapa jest na początku niezbadana i trzeba ją odkryć zwiadem, ale widzisz mapy wszystkich sojuszników. Zmiany na mapie poza polem widzenia twoich i sojuszniczych jednostek nie są widoczne.</STRING>
			</ENTRY>
			<ENTRY name="REVEALMAP2">
				<STRING>{ZBADANA}: Mapa jest na początku w pełni zbadana, więc widzisz ukształtowanie terenu  (oprócz rzadkich surowców i ruin), ale zmiany na mapie poza polem widzenia twoich jednostek nie są widoczne.</STRING>
			</ENTRY>
			<ENTRY name="REVEALMAP3">
				<STRING>
{WSZYSTKO WIDOCZNE}: Mapa jest na początku w pełni zbadana, a wszystkie wrogie jednostki i budynki są w pełni widoczne dla wszystkich graczy.
</STRING>
			</ENTRY>
		</REVEALMAPS>
