				<STRING>Zaznacz to pole, aby grać z turbo-zasobami — narody gromadzą wtedy zasoby znacznie szybciej niż zwykle.</STRING>
			</ENTRY>
			<ENTRY name="NO_NATION_POWERS">
				<STRING>Zaznacz to pole, aby wyłączyć moce narodów.</STRING>
			</ENTRY>
			<ENTRY name="NO_UNIQUE_UNITS">
				<STRING>Zaznacz to pole, aby wyłączyć unikalne jednostki.</STRING>
			</ENTRY>
			<ENTRY name="FREE_PAUSE">
				<STRING>Zaznacz to pole, aby używać wolnej pauzy, która pozwala graczom wstrzymywać grę dowolnie często i wydawać rozkazy podczas pauzy.</STRING>
			</ENTRY>
			<ENTRY name="REQUIRE_RANDOM_NATIONS">
				<STRING>Zaznacz to pole, aby wszyscy gracze musieli wybrać losową nację.</STRING>
			</ENTRY>
			<ENTRY name="SHARE_CONTROL">
				<STRING>Zaznacz to pole, aby gracze z tej samej drużyny mogli kierować nawzajem swoimi jednostkami i budynkami.</STRING>
			</ENTRY>
			<ENTRY name="REQUIRE_RANDOM_TEAMS">
				<STRING>Zaznacz to pole, aby gracze nie mogli wybierać współgraczy: drużyny zostaną wylosowane.</STRING>
			</ENTRY>
		</CHECKBOX>
		<COMBOBOX>
			<ENTRY name="GAME_RULES">
				<STRING>Kliknij, aby wybrać ogólne zasady gry. Jeśli wybierzesz Standard, obowiązują tylko standardowe zasady; w przeciwnym razie po uruchomieniu gry można wybrać dodatkowe zasady.</STRING>
			</ENTRY>
			<ENTRY name="MAP_SIZE">
				<STRING>Kliknij, aby wybrać rozmiar mapy.</STRING>
			</ENTRY>
			<ENTRY name="TEAM_STYLE">
				<STRING>Kliknij, aby wybrać zasady drużyn i sojuszy.</STRING>
			</ENTRY>
			<ENTRY name="MAP_STYLE">
				<STRING>Kliknij, aby wybrać typ mapy.</STRING>
			</ENTRY>
			<ENTRY name="CANNON_TIMES">
				<STRING>Kliknij, aby wybrać zasady czasu buforowego w grze. Czas buforowy pozwala każdemu graczowi na krótko przełączyć grę na bardzo wolną prędkość.</STRING>
			</ENTRY>
			<ENTRY name="MAX_PLAYERS">
				<STRING>Kliknij, aby wybrać maksymalną liczbę graczy, którzy mogą dołączyć do tej gry.</STRING>
			</ENTRY>
			<ENTRY name="GAME_SPEED">
				<STRING>Kliknij, aby wybrać prędkość gry.</STRING>
			</ENTRY>
		</COMBOBOX>
		<EDITBOX>
			<ENTRY name="DESCRIPTION">
				<STRING>Wpisz opis gry, który ją wyróżni i zachęci innych graczy do dołączenia. </STRING>
			</ENTRY>
			<ENTRY name="PASSWORD">
				<STRING>Jeśli chcesz wpuszczać tylko graczy znających określone hasło, wpisz je tutaj. Zostaw to pole puste, aby mógł dołączyć każdy chętny.</STRING>
			</ENTRY>
		</EDITBOX>
		<BUTTON>
			<ENTRY name="CANCEL">
				<STRING>Kliknij, aby anulować i wrócić do poprzedniego menu.</STRING>
			</ENTRY>
			<ENTRY name="CREATE">
				<STRING>Kliknij, aby utworzyć nowy pokój gry dla tej gry.</STRING>
			</ENTRY>
			<ENTRY name="RESET">
				<STRING>Kliknij, aby przywrócić wszystkie ustawienia domyślne.</STRING>
			</ENTRY>
		</BUTTON>
	</GAMESPYCREATE>
	<GAMESPYSTAGING>
		<BUTTON>
			<ENTRY name="LAUNCH">
				<STRING>Kliknij tutaj, aby uruchomić grę.</STRING>
			</ENTRY>
			<ENTRY name="EXIT">
				<STRING>Kliknij, aby anulować tę grę i wrócić do głównej poczekalni.</STRING>
			</ENTRY>
			<ENTRY name="SEND">
				<STRING>Kliknij, aby wysłać wiadomość do innych graczy w tym pokoju.</STRING>
			</ENTRY>
			<ENTRY name="REMOVE">
				<STRING>Kliknij, aby usunąć wybranego znajomego z listy.</STRING>
			</ENTRY>
			<ENTRY name="ADD">
				<STRING>Kliknij, aby dodać kogoś do listy znajomych.</STRING>
			</ENTRY>
			<ENTRY name="BOOT">
				<STRING>Kliknij, aby wyrzucić wybranego gracza z pokoju przygotowań. (Tylko gospodarz)</STRING>
			</ENTRY>
			<ENTRY name="EXIT_CLIENT">
				<STRING>Kliknij, aby opuścić tę grę i wrócić do głównej poczekalni.</STRING>
			</ENTRY>
			<ENTRY name="QUIT">
				<STRING>Kliknij, aby opuścić tę grę i wrócić do głównej poczekalni.</STRING>
			</ENTRY>
			<ENTRY name="TAB_ROOM_CHAT">
				<STRING>Karta „Czat poczekalni” pokazuje toczącą się w poczekalni rozmowę.</STRING>
			</ENTRY>
			<ENTRY name="TAB_STAGING_CHAT">
				<STRING>Karta „Czat gry” pokazuje toczącą się w tym pokoju gry rozmowę.</STRING>
			</ENTRY>
			<ENTRY name="IGNORE_LIST">
				<STRING>Pokazuje listę graczy, których obecnie ignorujesz.</STRING>
			</ENTRY>
		</BUTTON>
		<EDITBOX>
			<ENTRY name="SEND">
				<STRING>Aby porozmawiać z innymi graczami w tym pokoju, wpisz tu wiadomość i kliknij przycisk Wyślij.</STRING>
			</ENTRY>
		</EDITBOX>
		<LISTBOX>
			<ENTRY name="PLAYERS">
				<STRING>Lista graczy w tym pokoju.</STRING>
			</ENTRY>
			<ENTRY name="BUDDYLIST">
				<STRING>Lista twoich obecnych znajomych.</STRING>
			</ENTRY>
		</LISTBOX>
		<CHECKBOX>
			<ENTRY name="REQUIRE_RANDOM_TEAMS">
				<STRING>{WYMAGAJ LOSOWYCH DRUŻYN}: Ta opcja uniemożliwia graczom wybór współgraczy – muszą wybrać {"?"}.</STRING>
			</ENTRY>
			<ENTRY name="FREE_PAUSE">
				<STRING>{WOLNA PAUZA}: Zaznacz to pole, aby gracze mogli przewijać ekran i wydawać rozkazy podczas pauzy. Ta opcja jest zawsze aktywna w grach solo, ale w grach wieloosobowych trzeba ją wybrać tutaj.</STRING>
			</ENTRY>
			<ENTRY name="TURBO_RESOURCES">
				<STRING>{TURBO-ZASOBY}: Zaznacz to pole, aby przyspieszyć zbieranie zasobów. Ta opcja jest dla graczy, którzy wolą mniej skupiać się na zbieraniu zasobów, a więcej na innych elementach gry.</STRING>
			</ENTRY>
			<ENTRY name="TOURNAMENT_PLAY">
				<STRING>{TRYB TURNIEJOWY}: Zaznacz to pole, aby ukryć wybory nacji przed grą i wyniki graczy w trakcie gry. Gracze, którzy wcześnie się poddadzą, nie zobaczą całej mapy aż do końca gry.</STRING>
			</ENTRY>
			<ENTRY name="REQUIRE_RANDOM_NATIONS">
				<STRING>{WYMAGAJ LOSOWYCH NACJI}: Ta opcja uniemożliwia graczom wybór konkretnej nacji – muszą wybrać {Losowo}.</STRING>
			</ENTRY>
		</CHECKBOX>
		<COMBOBOX>
			<ENTRY name="TEAM_STYLE">
				<STRING>{DRUŻYNY I SOJUSZE}: Kliknij tutaj, aby wybrać, czy i jak nacje zostaną podzielone na drużyny – oraz czy sojusze mogą się zmieniać w trakcie gry.</STRING>
			</ENTRY>
			<ENTRY name="MAP_STYLE">
				<STRING>{TYP MAPY}: Kliknij tutaj, aby wybrać typ mapy. Każdy typ mapy daje inny rodzaj gry i inną sytuację strategiczną.</STRING>
			</ENTRY>
			<ENTRY name="MAP_SIZE">
				<STRING>{ROZMIAR MAPY}: Kliknij tutaj, aby wybrać rozmiar mapy. Na mniejszych mapach gry są krótsze; na większych narody później się ze sobą stykają.</STRING>
			</ENTRY>
			<ENTRY name="MAX_PLAYERS">
				<STRING>{MAKS. GRACZY}: Kliknij tutaj, aby ustawić maksymalną liczbę graczy, którzy mogą dołączyć do tej gry.</STRING>
			</ENTRY>
			<ENTRY name="CANNON_TIMES">
				<STRING>{CZAS BUFOROWY}: Kliknij, aby pozwolić każdemu graczowi na krótkie okresy „super zwolnionego tempa” w grze wieloosobowej.</STRING>
			</ENTRY>
			<ENTRY name="GAME_RULES">
				<STRING>{ZASADY}: Kliknij tutaj, aby wybrać, czy gra będzie toczona według standardowych, czy własnych zasad.</STRING>
			</ENTRY>
			<ENTRY name="GAME_SPEED">
				<STRING>{PRĘDKOŚĆ GRY}: Kliknij tutaj, aby ustawić prędkość gry. Bardziej doświadczeni gracze mogą chcieć, by czas w grze płynął szybciej.</STRING>
			</ENTRY>
		</COMBOBOX>
	</GAMESPYSTAGING>
	<TUTORIALWIN>
		<BUTTON>
			<ENTRY name="BOUDICEA">
				<STRING>Kliknij, aby wybrać samouczek 1, który omawia podstawy dla początkujących, np. ruch i walkę. Gracze, którzy nigdy nie grali w strategię czasu rzeczywistego, powinni zacząć tutaj.</STRING>
			</ENTRY>
			<ENTRY name="ALFRED THE GREAT">
				<STRING>Kliknij, aby wybrać samouczek 2, który omawia kolejne zagadnienia dla początkujących, np. tworzenie jednostek i wznoszenie budynków.</STRING>
			</ENTRY>
			<ENTRY name="THE 100 YEARS WAR">
				<STRING>Kliknij, aby wybrać samouczek 3 dla średnio zaawansowanych, omawiający ważne różnice między Rise of Nations a innymi strategiami czasu rzeczywistego. Gracze doświadczeni w innych strategiach czasu rzeczywistego powinni zacząć tutaj.</STRING>
			</ENTRY>
			<ENTRY name="BRITTANIA">
				<STRING>Kliknij, aby wybrać samouczek 4 dla średnio zaawansowanych, omawiający kolejne ważne różnice między Rise of Nations a innymi strategiami czasu rzeczywistego.</STRING>
			</ENTRY>
			<ENTRY name="BATTLE OF BRITAIN">
				<STRING>Kliknij, aby wybrać samouczek 5, w którym ćwiczysz grę jeden na jednego, a komputer podsuwa sugestie i wskazówki.</STRING>
			</ENTRY>
			<ENTRY name="HENRY VIII">
				<STRING>Kliknij, aby wybrać samouczek 6 dla zaawansowanych, omawiający dyplomację i nowoczesną broń.</STRING>
			</ENTRY>
			<ENTRY name="CANCEL">
				<STRING>Kliknij, aby wrócić do menu głównego.</STRING>
			</ENTRY>
			<ENTRY name="START">
				<STRING>Kliknij, aby rozpocząć wybrany samouczek.</STRING>
			</ENTRY>
		</BUTTON>
		<SLIDER>
			<ENTRY name="TIMELINE">
				<STRING/>
			</ENTRY>
		</SLIDER>
	</TUTORIALWIN>
	<SKILLTESTWIN>
		<BUTTON>
			<ENTRY name="SELECTION_BUTTON">
				<STRING>Kliknij, aby wybrać ten test umiejętności.</STRING>
			</ENTRY>
			<ENTRY name="DOWN_ARROW">
				<STRING>Kliknij, aby przewinąć w dół.</STRING>
			</ENTRY>
			<ENTRY name="NUMBER_BUTTON">
				<STRING>Kliknij, aby wybrać ten test umiejętności.</STRING>
			</ENTRY>
			<ENTRY name="UP_ARROW">
				<STRING>Kliknij, aby przewinąć w górę.</STRING>
			</ENTRY>
			<ENTRY name="BACK">
				<STRING>Kliknij, aby wrócić do menu Narzędzia i dodatki.</STRING>
			</ENTRY>
			<ENTRY name="START">
				<STRING>Kliknij, aby rozpocząć wybrany test umiejętności.</STRING>
			</ENTRY>
		</BUTTON>
		<SPOT>
			<ENTRY name="RANKINGS">
				<STRING>To lista najlepszych graczy i ich rekordów w bieżącym scenariuszu.</STRING>
			</ENTRY>
		</SPOT>
	</SKILLTESTWIN>
	<CONQUESTRULESWIN>
		<ENTRY name="CTWRULES">
			<STRING>
				<SPACE/>
<BULLET/>W Podboju świata zaczynasz z jednym terytorium stołecznym i jedną armią. Użyj armii, aby podbić kolejne terytoria. Aby wygrać, podbij cały świat! <SPACE/>
<BULLET/>W każdej turze możesz raz zaatakować niczyje lub wrogie terytorium. <SPACE/>
<BULLET/>Zdobyte terytoria dają premie, w tym daninę, rzadkie surowce i karty bonusowe. <SPACE/>
<BULLET/>Niektóre terytoria mają centra zaopatrzenia. Oprócz armii początkowej dostajesz jedną dodatkową armię za każde kontrolowane centrum zaopatrzenia. <SPACE/>
<BULLET/>W turze armia może zaatakować lub wesprzeć atak. Armia wspierająca automatycznie wysyła posiłki podczas bitwy. Armie mogą też wspierać obronę.<SPACE/>
<BULLET/>Jeśli użyjesz dość armii wspierających, możesz zdobyć terytorium inne niż stołeczne bez walki. Aby „rozgromić” terytorium, musisz mieć o dwie armie więcej niż przeciwnik. Rozgromienie nie liczy się jako twój atak w turze. W turze armia może zaatakować lub wesprzeć atak. Armia wspierająca automatycznie wysyła posiłki podczas scenariusza.<SPACE/>
<BULLET/>Wasale to narody, które dołączyły do twojego imperium, ale zachowały kontrolę nad swoimi zasobami strategicznymi. Nie wystawiają już armii, a twoje armie mogą przechodzić przez ich terytorium. Ich terytoria liczą się jako twoje przy ustalaniu zwycięstwa.</STRING>
		</ENTRY>
		<BUTTON>
			<ENTRY name="CLOSE">
				<STRING>Kliknij, aby zamknąć to okno.</STRING>
			</ENTRY>
			<ENTRY name="MORE">
				<STRING>Kliknij, aby wyświetlić.</STRING>
			</ENTRY>
		</BUTTON>
	</CONQUESTRULESWIN>
	<CONQUESTSETUPWIN>
		<COMBOBOX>
			<ENTRY name="MAP">
				<STRING>Kliknij tutaj, aby wybrać mapę.</STRING>
			</ENTRY>
			<ENTRY name="DIFFICULTY">
				<STRING>Kliknij, aby wybrać poziom trudności. Określa on skuteczność i agresywność graczy komputerowych.</STRING>
			</ENTRY>
		</COMBOBOX>
		<BUTTON>
			<ENTRY name="LOAD">
				<STRING>Kliknij, aby wczytać zapisaną grę Podbój świata.</STRING>
			</ENTRY>
			<ENTRY name="CANCEL">
				<STRING>Kliknij, aby wrócić do poprzedniego menu.</STRING>
			</ENTRY>
			<ENTRY name="START">
				<STRING>Kliknij, aby rozpocząć nową grę Podbój świata.</STRING>
			</ENTRY>
			<ENTRY name="CONTINUE">
				<STRING>Kliknij, aby kontynuować poprzednią grę Podbój świata.</STRING>
			</ENTRY>
			<ENTRY name="NATION_START">
				<STRING>Kliknij, aby rozpocząć nową grę Podbój świata.</STRING>
			</ENTRY>
			<ENTRY name="NATION_CANCEL">
				<STRING>Kliknij, aby wrócić do ekranu wyboru kampanii.</STRING>
			</ENTRY>
		</BUTTON>
		<CHECKBOX>
			<ENTRY name="RANDOM_BONUSES">
				<STRING>Zaznacz, aby losowo rozmieścić na mapie karty bonusowe, daninę i rzadkie surowce.</STRING>
			</ENTRY>
			<ENTRY name="RANDOM_NATIONS">
				<STRING>Zaznacz, aby wylosować pozycje startowe narodów.</STRING>
			</ENTRY>
		</CHECKBOX>
	</CONQUESTSETUPWIN>
	<CONQUESTHELPPOINTERS>
		<ENTRY name="HELP_ARMY">
			<STRING>Kliknij, aby wybrać tę armię. Potem kliknij sąsiednie wrogie terytorium, aby je zaatakować.</STRING>
		</ENTRY>
		<ENTRY name="HELP_START">
			<STRING>Wybrałeś terytorium — kliknij teraz przycisk „Start”, aby rozpocząć atak.</STRING>
		</ENTRY>
		<ENTRY name="HELP_SUPPLY">
			<STRING>Dodatkowe armie zdobędziesz, zajmując terytoria z centrami zaopatrzenia #ICON15.</STRING>
		</ENTRY>
		<ENTRY name="HELP_CAPITAL">
			<STRING>Ta flaga oznacza terytorium stołeczne. Stolice bywają bardzo trudne do zdobycia. Jeśli zdobędziesz stolicę, jej naród zostaje pokonany, a ty automatycznie przejmujesz jego pozostałe terytoria.</STRING>
		</ENTRY>
		<ENTRY name="HELP_DIPLO">
			<STRING>Kliknij przycisk „Dyplomacja”, aby podjąć negocjacje z innymi narodami. Możesz kupować terytoria, zawierać pokój lub sojusze i wypowiadać wojny innym narodom. </STRING>
		</ENTRY>
		<ENTRY name="HELP_CARD">
			<STRING>Kliknij przycisk „Kup kartę bonusową”, aby kupić kartę bonusową. Zobaczysz trzy karty do wyboru.</STRING>
		</ENTRY>
		<ENTRY name="HELP_INFRA">
			<STRING>Każde terytorium kontrolowane przez naród ma liczbę oznaczającą jego siłę. Im wyższa liczba, tym silniejsze terytorium i tym trudniej je zdobyć. Zasadniczo im dłużej terytorium jest utrzymywane, tym wyższa liczba.</STRING>
		</ENTRY>
		<ENTRY name="HELP_BUY_INFRA">
			<STRING>Kliknij przycisk „Kup siłę terytorium”, aby zwiększyć siłę jednego ze swoich terytoriów. </STRING>
		</ENTRY>
		<ENTRY name="HELP_TACTIC_CARD">
			<STRING>Zdobyłeś niebieską taktyczną kartę bonusową. Zagrywaj takie karty na początku bitwy podboju, np. ataku na stolicę, aby zyskać premię. Najedź myszą na kartę, aby zobaczyć premię. Każdą kartę bonusową można zagrać tylko raz.</STRING>
		</ENTRY>
		<ENTRY name="HELP_STRATEGIC_CARD">
			<STRING>Zdobyłeś czerwoną strategiczną kartę bonusową. Kliknij kartę, a potem terytorium, na którym chcesz jej użyć. Najedź myszą na kartę, aby zobaczyć premię. Każdą kartę bonusową można zagrać tylko raz.</STRING>
		</ENTRY>
		<ENTRY name="HELP_BARBARIAN">
			<STRING>Wybrałeś do ataku naród barbarzyński. Aby wygrać scenariusz z barbarzyńcami, możesz musieć spełnić specjalne warunki zwycięstwa. Kliknij przycisk „Start”, aby rozpocząć bitwę.</STRING>
		</ENTRY>
		<ENTRY name="HELP_TRIBUTE">
			<STRING>Liczba daniny pokazuje, ile daniny masz w skarbcu. Daniną możesz kupować karty bonusowe, zwiększać siłę terytoriów i negocjować traktaty. Zwiększysz daninę, podbijając terytoria z ikoną daniny #ICON19 lub kończąc turę bez stoczenia bitwy.</STRING>
		</ENTRY>
		<ENTRY name="HELP_SUPPORT">
			<STRING>Czarne strzałki pokazują, gdzie przyjazna armia może wesprzeć atak. Armie wspierające dostarczają do bitwy obywateli lub posiłki. Jeśli w ataku bierze udział co najmniej o dwie armie więcej niż u obrońców, automatycznie zdobywasz terytorium bez walki. Terytoriów stołecznych nie można rozgromić.</STRING>
		</ENTRY>
		<ENTRY name="HELP_MOVE">
			<STRING>Niebieskie strzałki pokazują, dokąd twoja armia może się przemieścić w obrębie twojego państwa.</STRING>
		</ENTRY>
		<ENTRY name="HELP_RARE_RES">
			<STRING>Niektóre terytoria mają rzadkie surowce. Podczas bitwy podboju otrzymujesz korzyści i dochody ze wszystkich rzadkich surowców na kontrolowanych przez ciebie terytoriach.</STRING>
		</ENTRY>
		<ENTRY name="HELP_WONDER_CARD">
			<STRING>Zdobyłeś kartę bonusową, która pozwala zbudować cud świata! Aby go zbudować, przeciągnij kartę na terytorium, na którym chcesz go wznieść. W bitwie otrzymujesz korzyści ze wszystkich kontrolowanych cudów po zbadaniu $NUM0 technologii cywilnych. Każdą kartę bonusową można zagrać tylko raz.</STRING>
		</ENTRY>
		<ENTRY name="HELP_SPECIAL_GENERAL">
			<STRING/>
		</ENTRY>
		<ENTRY name="HELP_STARTING_ALLY">
			<STRING>$TRIBE0 to twoi sojusznicy. Współpraca na rzecz wspólnych celów może się z czasem opłacić.</STRING>
		</ENTRY>
		<ENTRY name="HELP_COMMANDER"/>
		<ENTRY name="HELP_STARTING_VASSAL">
			<STRING>$TRIBE0 to państwo klienckie. Możesz przechodzić przez ich terytorium i czerpiesz dochód z kontroli nad nimi.</STRING>
		</ENTRY>
		<ENTRY name="HELP_STARTING_VASSAL_PLURAL">
			<STRING>$TRIBE0 to państwo klienckie. Możesz przechodzić przez jego terytorium i czerpiesz dochód z kontroli nad nim.</STRING>
		</ENTRY>
		<ENTRY name="HELP_ESPIONAGE">
			<STRING>Kliknij przycisk Szpiegostwo, aby podjąć próbę szpiegostwa. Możesz to robić raz na turę. Szpiegostwo pozwala przeprowadzać skryte ataki na wroga. Szpiegostwo nie liczy się jako twój jedyny atak w tej turze.</STRING>
		</ENTRY>
	</CONQUESTHELPPOINTERS>
	<CONQUESTWIN>
		<ENTRY name="ENEMY">
			<STRING>Wroga armia<SPACE/>Wrogie armie mogą atakować twoje terytoria i bronić własnych. Pobliskie wrogie armie mogą dostarczać wojska do bitwy.</STRING>
		</ENTRY>
		<ENTRY name="ICON_STRENGTH">
			<STRING>Siła terytorium: $NUM0<SPACE/>Terytoria zyskują siłę z każdą epoką, przez którą utrzymuje je ten sam naród. Terytoria o większej sile trudniej zaatakować. Siłę terytorium można też zwiększyć za daninę.</STRING>
		</ENTRY>
		<ENTRY name="ICON_WONDER">
			<STRING>#ICON16 Cud<SPACE/>$WONDERNAME0<SPACE/>$WONDERDESC1</STRING>
		</ENTRY>
		<ENTRY name="ICON_BONUS">
			<STRING>#ICON17 Karta bonusowa<SPACE/>#BONUSCARDNAME0<SPACE/>Podbijaj terytoria, aby zdobywać karty bonusowe. Karty bonusowe pomagają rozwijać naród lub zwiększają szanse w następnej bitwie.</STRING>
		</ENTRY>
		<ENTRY name="ICON_RARE">
			<STRING>#ICON18 Rzadki surowiec<SPACE/>$RARERESNAME0<LINE/>$RARERESINCOME1<SPACE/>$RAREDESC2<SPACE/>Podczas bitwy podboju otrzymujesz korzyści i dochody ze wszystkich rzadkich surowców na kontrolowanych przez ciebie terytoriach.</STRING>
		</ENTRY>
		<ENTRY name="ICON_TRIBUTE">
			<STRING>#ICON19 Danina: $NUMBER0<SPACE/>Daninę zyskujesz, podbijając terytorium. Służy do kupowania kart bonusowych, zwiększania siły terytoriów i zawierania umów dyplomatycznych.</STRING>
		</ENTRY>
		<ENTRY name="ICON_SUPPLY">
			<STRING>#ICON15 Centrum zaopatrzenia<SPACE/>Centra zaopatrzenia pozwalają narodowi utrzymywać dodatkowe armie. Naród może mieć jedną armię na każde kontrolowane centrum zaopatrzenia.</STRING>
		</ENTRY>
		<ENTRY name="ICON_NUKE">
			<STRING>#ICON109 Pocisk nuklearny<SPACE/>Przekręć klucz i kliknij duży czerwony przycisk, aby wystrzelić pociski. Uważaj: wróg zapewne odpowie odpaleniem swoich. Więcej pocisków nuklearnych kupisz w lewym górnym rogu interfejsu.</STRING>
		</ENTRY>
		<ENTRY name="ARMY">
			<STRING>Armia<SPACE/>Kliknij, aby wybrać.<SPACE/>Armie służą do atakowania sąsiednich terytoriów lub obrony własnych. W turze może atakować tylko jedna armia. Pobliskie armie mogą dostarczać wojska do bitwy.</STRING>
		</ENTRY>
		<ENTRY name="ARMY_UNAVAIL">
			<STRING>Armia<SPACE/>Nowej armii nie można przemieścić.<SPACE/>Armie służą do atakowania sąsiednich terytoriów lub obrony własnych. W turze może atakować tylko jedna armia. Pobliskie armie mogą dostarczać wojska do bitwy.</STRING>
		</ENTRY>
		<ENTRY name="ARROW_ATTACK">
			<STRING>Strzałka ataku<SPACE/>Zielone strzałki pokazują terytoria, które można zaatakować.</STRING>
		</ENTRY>
		<ENTRY name="ARROW_MOVE">
			<STRING>Strzałka ruchu<SPACE/>Niebieskie strzałki pokazują, dokąd twoja armia może się przemieścić w obrębie twojego państwa.</STRING>
		</ENTRY>
		<ENTRY name="ARROW_SUPPORT">
			<STRING>Strzałka wsparcia<SPACE/>Czarne strzałki pokazują, kiedy przyjazna armia może wesprzeć atak. </STRING>
		</ENTRY>
		<ENTRY name="BATTLE_INFO">
			<STRING>{Raport twojego doradcy}
<LINE/>
<LEFT/>[Atak z: $COUNTRY0 na: $COUNTRY1]         
      </STRING>
		</ENTRY>
	</CONQUESTWIN>
	<CONQUESTIFACE>
		<BUTTON>
			<ENTRY name="START_BUTTON">
				<STRING>Rozpocznij bitwę<SPACE/>Kliknij, aby rozpocząć scenariusz z obecnie atakującą armią.</STRING>
			</ENTRY>
			<ENTRY name="BONUS_CARDS">
				<STRING>Karty bonusowe<SPACE/>Podbijaj nowe terytoria, aby zdobywać karty bonusowe.</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES">
				<STRING>Rzadkie surowce<SPACE/>Podbijaj nowe terytoria, aby zdobywać nowe rzadkie surowce.</STRING>
			</ENTRY>
			<ENTRY name="DIPLO_BUTTON">
				<STRING>Dyplomacja<SPACE/>Kliknij, aby podjąć dyplomację z innymi narodami.</STRING>
			</ENTRY>
			<ENTRY name="CENTER_BUTTON">
				<STRING>Wyśrodkuj mapę<SPACE/>Kliknij, aby wyśrodkować widok na stolicy twojego narodu.</STRING>
			</ENTRY>
			<ENTRY name="WONDERS">
				<STRING>Cuda<SPACE/>Zagrywaj karty bonusowe budowy cudu lub podbijaj terytoria z cudami, aby dodać je do swojego imperium.</STRING>
			</ENTRY>
			<ENTRY name="WONDER_SCROLLBUT1"/>
			<ENTRY name="WONDER_SCROLLBUT2"/>
			<ENTRY name="TRIBUTE_BUTTON">
				<STRING>Danina: $NUM0<SPACE/>Daninę zyskujesz, podbijając terytorium. Używaj jej do kupowania kart bonusowych, zwiększania siły terytoriów i zawierania umów dyplomatycznych.</STRING>
			</ENTRY>
			<ENTRY name="ARROW_RIGHT"/>
			<ENTRY name="RESOURCE_SCROLLBUT2"/>
			<ENTRY name="RESOURCE_SCROLLBUT1"/>
			<ENTRY name="BUILD_BUTTON">
				<STRING>Zwiększ siłę terytorium<SPACE/>Kliknij, aby zwiększyć siłę terytorium, co daje dodatkowe miasta i budynki w bitwach obronnych.<SPACE/>Potrzeba więcej daniny.</STRING>
			</ENTRY>
			<ENTRY name="RANDOM_CARD">
				<STRING>Kup kartę bonusową<SPACE/>Danina: {$NUM0}<SPACE/>Kliknij, aby kupić jedną kartę bonusową. Dostaniesz trzy karty do wyboru.<SPACE/>Potrzeba więcej daniny.</STRING>
			</ENTRY>
			<ENTRY name="FOOD">
				<STRING>Dochód z rzadkich surowców<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Ten dochód pochodzi z rzadkich surowców na kontrolowanych przez ciebie terytoriach. Surowce te dają premie i dochód podczas bitew podboju.</STRING>
			</ENTRY>
			<ENTRY name="TIMBER">
				<STRING>Dochód z rzadkich surowców<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Ten dochód pochodzi z rzadkich surowców na terytoriach, które kontrolujesz. Surowce te dają premie i dochód podczas bitew podboju.</STRING>
			</ENTRY>
			<ENTRY name="WEALTH">
				<STRING>Dochód z rzadkich surowców<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Ten dochód pochodzi z rzadkich surowców na terytoriach, które kontrolujesz. Surowce te dają premie i dochód podczas bitew podboju.</STRING>
			</ENTRY>
			<ENTRY name="METAL">
				<STRING>Dochód z rzadkich surowców<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Ten dochód pochodzi z rzadkich surowców na terytoriach, które kontrolujesz. Surowce te dają premie i dochód podczas bitew podboju.</STRING>
			</ENTRY>
			<ENTRY name="KNOWLEDGE">
				<STRING>Dochód z rzadkich surowców<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Ten dochód pochodzi z rzadkich surowców na terytoriach, które kontrolujesz. Surowce te dają premie i dochód podczas bitew podboju.</STRING>
			</ENTRY>
			<ENTRY name="OIL">
				<STRING>Dochód z rzadkich surowców<SPACE/>$RARERESNAME0: +$NUM0<SPACE/>Ten dochód pochodzi z rzadkich surowców na terytoriach, które kontrolujesz. Surowce te dają premie i dochód podczas bitew podboju.</STRING>
			</ENTRY>
			<ENTRY name="ARROW_LEFT"/>
			<ENTRY name="STATUS_BUTTON">
				<STRING>Stan świata<SPACE/>Kliknij, aby wyświetlić statystyki i informacje o obecnym stanie świata.</STRING>
			</ENTRY>
			<ENTRY name="NEWS_BUTTON">
				<STRING>Wydarzenia światowe<SPACE/>Kliknij, aby wyświetlić wydarzenia na świecie z ostatniej tury.</STRING>
			</ENTRY>
			<ENTRY name="RULES_BUTTON">
				<STRING>Zasady<SPACE/>Kliknij, aby wyświetlić zasady Podboju świata.</STRING>
			</ENTRY>
			<ENTRY name="OPTIONS_BUTTON">
				<STRING>Opcje<SPACE/>Kliknij, aby wyświetlić opcje gry Podbój świata.</STRING>
			</ENTRY>
			<ENTRY name="ARROW_LEFT">
				<STRING>Kliknij, aby wyświetlić dodatkowe karty bonusowe.</STRING>
			</ENTRY>
			<ENTRY name="ARROW_RIGHT">
				<STRING>Kliknij, aby wyświetlić dodatkowe karty bonusowe.</STRING>
			</ENTRY>
			<ENTRY name="WONDER_SCROLLBUT2">
				<STRING>Kliknij, aby wyświetlić dodatkowe cuda świata.</STRING>
			</ENTRY>
			<ENTRY name="WONDER_SCROLLBUT1">
				<STRING>Kliknij, aby wyświetlić dodatkowe cuda świata.</STRING>
			</ENTRY>
			<ENTRY name="RESOURCE_SCROLLBUT2">
				<STRING>Kliknij, aby wyświetlić dodatkowe rzadkie surowce.</STRING>
			</ENTRY>
			<ENTRY name="RESOURCE_SCROLLBUT1">
				<STRING>Kliknij, aby wyświetlić dodatkowe rzadkie surowce.</STRING>
			</ENTRY>
			<ENTRY name="NUKE_KEY">
				<STRING>Klucz startowy<SPACE/>Kliknij, aby przekręcić klucz i odblokować przycisk startu. Przed odpaleniem trzeba przekręcić klucz.</STRING>
			</ENTRY>
			<ENTRY name="NUKE_LAUNCH">
				<STRING>Przycisk startu atomowego<SPACE/>Po przekręceniu klucza startowego kliknij, aby wystrzelić pociski nuklearne. Pamiętaj, że wróg w odwecie też wystrzeli swoje.</STRING>
			</ENTRY>
			<ENTRY name="BUY_NUKE">
				<STRING>Kup pocisk nuklearny<SPACE/>Kliknij, aby kupić pocisk nuklearny za $NUM0 daniny.</STRING>
			</ENTRY>
			<ENTRY name="ESPIONAGE">
				<STRING>Misje szpiegowskie<SPACE/>Kliknij, aby prowadzić szpiegostwo przeciw wrogowi. Ta opcja jest dostępna tylko wtedy, gdy nie toczysz z nim wojny.</STRING>
			</ENTRY>
			<ENTRY name="INCOME">
				<STRING>Dochód z przemysłu<SPACE/>Dochód wynika z łącznej siły wszystkich terytoriów narodu.</STRING>
			</ENTRY>
			<ENTRY name="OPP_INCOME">
				<STRING>Dochód wroga z przemysłu<SPACE/>Dochód wynika z łącznej siły wszystkich terytoriów narodu.</STRING>
			</ENTRY>
		</BUTTON>
		<ENTRY name="STRATEGIC_CARD">
			<STRING>Kliknij tę kartę strategiczną i upuść ją na terytorium, aby użyć jej premii.<SPACE/>Dostępne miejsca są podświetlone.</STRING>
		</ENTRY>
		<ENTRY name="STRATEGIC_CARD_DISABLED">
			<STRING>Obecnie nie możesz zagrywać kart strategicznych.</STRING>
		</ENTRY>
		<ENTRY name="TACTICAL_CARD">
			<STRING>Kartę taktyczną można zagrać, aby zyskać premie w bitwie.<SPACE/>Na początku scenariusza zostaniesz poproszony o zagranie taktycznych kart bonusowych.</STRING>
		</ENTRY>
		<SPOT>
			<ENTRY name="DEFCON">
				<STRING>Wskaźnik DEFCON<SPACE/>Obecny poziom DEFCON to $NUM0. Im niższy poziom, tym większe ryzyko światowej wojny termojądrowej.</STRING>
			</ENTRY>
			<ENTRY name="NUM_NUKES">
				<STRING>Arsenał nuklearny<SPACE/>Masz obecnie pociski nuklearne: $NUM0.</STRING>
			</ENTRY>
			<ENTRY name="NUM_NUKES_SINGULAR">
				<STRING>Arsenał nuklearny<SPACE/>Masz obecnie pociski nuklearne: $NUM0.</STRING>
			</ENTRY>
			<ENTRY name="OPP_NUM_NUKES">
				<STRING>Arsenał nuklearny<SPACE/>Twój wróg ma obecnie pociski nuklearne: $NUM0.</STRING>
			</ENTRY>
			<ENTRY name="OPP_NUM_NUKES_SINGULAR">
				<STRING>Arsenał nuklearny<SPACE/>Twój wróg ma obecnie pociski nuklearne: $NUM0.</STRING>
			</ENTRY>
			<ENTRY name="NUKE_TURNS">
				<STRING>Tury do odpalenia pocisków: $NUM0<SPACE/>Twoje pociski i pociski wroga zostaną wystrzelone za $NUM1 tur(y).</STRING>
			</ENTRY>
		</SPOT>
	</CONQUESTIFACE>
