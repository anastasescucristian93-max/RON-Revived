			</ENTRY>
		</BUTTON>
		<COMBOBOX><ENTRY name="COMBO-VISIBILITY"><STRING>Brak tekstu dla PUBLISHWIN/COMBOBOX/COMBO-VISIBILITY w help.xml!</STRING></ENTRY></COMBOBOX></PUBLISHWIN>
	<PUBLISHINGWIN>
		<BUTTON>
			<ENTRY name="BTN-OK">
				<STRING>Powrót do menedżera modów.</STRING>
			</ENTRY>
		</BUTTON>
	</PUBLISHINGWIN>
</ROOT>