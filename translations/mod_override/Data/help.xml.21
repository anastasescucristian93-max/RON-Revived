<!-- edited with XML Spy v4.4 U (http://www.xmlspy.com) by Scott Lewis (Big Huge Games) --><!-- edited with XMLSPY v5 rel. 2 U (http://www.xmlspy.com) by Mark Sobota (Big Huge Games) --><!-- LOCALIZATION: STRING elements--><!-- LOCALIZATION: MAXPROFILELEN is an integer value that limits the # of characters allowed in the profile name.  Changing it to a string value will cause errors.--><ROOT>
	<TRIBES>
		<ENTRY name="TRIBE">
			<STRING>{NACJA}: Kliknij tutaj, aby wybrać nację, którą zagrasz. W grze jednoosobowej możesz też wybrać nację dla każdego gracza komputerowego.</STRING>
		</ENTRY>
		<ENTRY name="TRIBEX">
			<STRING>{NACJA}: Pokazuje, którą nacją pokieruje ten gracz.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOM">
			<STRING>{LOSOWA NACJA}: Nacja zostanie wylosowana na początku gry. Przeciwnicy nie poznają jej, dopóki nie natkną się na nią na mapie.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMOFFENSIVE">
			<STRING>{LOSOWA NACJA OFENSYWNA}: Nacja zostanie wylosowana na początku gry. Przeciwnicy nie poznają jej, dopóki nie natkną się na nią na mapie. Wylosowana nacja będzie miała dobre zdolności ofensywne.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMDEFENSIVE">
			<STRING>{LOSOWA NACJA DEFENSYWNA}: Nacja zostanie wylosowana na początku gry. Przeciwnicy nie poznają jej, dopóki nie natkną się na nią na mapie. Wylosowana nacja będzie dobrze nadawać się do obrony. </STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMECONOMIC">
			<STRING>{LOSOWA NACJA GOSPODARCZA}: Nacja zostanie wylosowana na początku gry. Przeciwnicy nie poznają jej, dopóki nie natkną się na nią na mapie. Wylosowana nacja będzie miała duży potencjał gospodarczy.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMXPACK">
			<STRING>{LOSOWA NACJA Z X-PACKA}: Nacja zostanie wylosowana na początku gry. Przeciwnicy nie poznają jej, dopóki nie natkną się na nią na mapie. Zostanie wybrana jedna z nowych nacji z X-Packa.</STRING>
		</ENTRY>
		<ENTRY name="TRIBERANDOMCTW">
			<STRING>{LOSOWA NACJA}: Nacja zostanie wylosowana na początku gry. </STRING>
		</ENTRY>
		<ENTRY name="TRIBE0">
			<STRING>{Aztekowie mają Moc Ofiary.}
        <BULLET/>Zyskujesz $NUMBER0 zasobów premii na epokę, gdy jednostki z koszar, stajni i przystani zabiją wroga (maksymalnie $NUMBER3).
        <BULLET/>Łupy z wrogich budynków większe o $NUMBER1%.
      <BULLET/>Zaczynasz z jednym badaniem wojskowym w bibliotece.
      <BULLET/>Otrzymujesz darmową lekką piechotę za każde nowe koszary (jeden oddział na starcie, dwa z Epoką klasyczną i badaniem wojskowym, trzy z Epoką prochu i 3 badaniami wojskowymi).
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE1">
			<STRING>{Majowie mają Moc Architektury.}
         <BULLET/>Miasta, wieże, forty itp. wystrzeliwują dodatkowe strzały/pociski – także miasta bez garnizonu.
         <BULLET/>Budynki są o $NUMBER2% wytrzymalsze, a wszystkie poza cudami budują się o $NUMBER3% szybciej.
         <BULLET/>Budynki kosztują o $NUMBER0% mniej drewna (oprócz cudów i budynków wojskowych).
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE2">
			<STRING>{Inkowie mają Moc Złota.}
      <BULLET/>Kopalnie dają bogactwo oprócz metalu.
      <BULLET/>Limit handlu bogactwem +$NUMBER0%.
      <BULLET/>Gdy wróg zabije twoją jednostkę, otrzymujesz zwrot $NUMBER1% jej kosztu.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE3">
			<STRING>{Bantu mają Moc Migracji.}
         <BULLET/>+$NUMBER1 do limitu miast (wymaga co najmniej jednego badania cywilnego), a miasta są o $NUMBER5% tańsze.
      <BULLET/>+$NUMBER2% do limitu populacji. Możesz przekroczyć maksymalny limit o $NUMBER3%.
      <BULLET/>Jednostki z koszar i obywatele poruszają się o $NUMBER4% szybciej.
      <BULLET/>Ulepszenia jednostek nie wymagają badań wojskowych.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE4">
			<STRING>{Nubijczycy mają Moc Handlu.}
         <BULLET/>Kupcy na twoim terytorium zbierają + $NUMBER0% zasobów bazowych. Widzisz rzadkie surowce na swoim terytorium.
      <BULLET/>+$NUMBER1 do limitu karawan.
      <BULLET/>Zaczynasz z targiem i zawsze handlujesz zasobami z premią cenową +$NUMBER4/-$NUMBER4.
      <BULLET/>Kupcy, karawany i targi są o $NUMBER2% tańsze i mają o $NUMBER3% więcej punktów życia.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE5">
			<STRING>{Grecy mają Moc Filozofii.}
         <BULLET/>Badania w bibliotece o $NUMBER1% tańsze (poza wiedzą) i o $NUMBER0% szybsze.
      <BULLET/>Możesz budować uniwersytety i zbierać wiedzę od początku gry.
      <BULLET/>Biblioteki i uniwersytety o $NUMBER4% tańsze.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE6">
			<STRING>{Rzymianie mają Moc Cezara.}
         <BULLET/>Forty są o $NUMBER3% tańsze, budują się o $NUMBER8% szybciej, poszerzają granice państwa o +$NUMBER2 i dostają darmowe ulepszenia.
      <BULLET/>Ciężka piechota powstaje o $NUMBER6% taniej i o $NUMBER7% szybciej. Zaczynasz z jednym badaniem wojskowym w bibliotece.
      <BULLET/>Otrzymujesz darmową ciężką piechotę za każde nowe koszary (jeden oddział z Epoką klasyczną, dwa z Epoką prochu i 3 badaniami wojskowymi, trzy z Epoką przemysłową i 5 badaniami wojskowymi).
      <BULLET/>Miasta zbierają dodatkowe +$NUMBER4 bogactwa.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE7">
			<STRING>{Egipcjanie mają Moc Nilu.}
         <BULLET/>Zaczynasz ze spichlerzem i dostajesz jego ulepszenia za darmo.
         <BULLET/>Limit handlu żywnością +$NUMBER3%.
      <BULLET/>Możesz zbudować $NUMBER2 farm na miasto. Farmy dają +$NUMBER4 bogactwa.
      <BULLET/>Cuda kosztują o $NUMBER1% mniej, można je budować epokę wcześniej i po dwa na miasto.
         </STRING>
		</ENTRY>
		<ENTRY name="TRIBE7CTW">
			<STRING>{Egipcjanie mają Moc Nilu.}
         <BULLET/>Zaczynasz ze spichlerzem i dostajesz jego ulepszenia za darmo.
         <BULLET/>Limit handlu żywnością +$NUMBER3%.
      <BULLET/>Możesz zbudować $NUMBER2 farm na miasto. Farmy dają +$NUMBER4 bogactwa.
      <BULLET/>Zaczynasz kampanie Podbój świata z kartą premii Buduj cud i budujesz cuda epokę wcześniej na mapie strategicznej.
         </STRING>
		</ENTRY>
		<ENTRY name="TRIBE8">
			<STRING>{Turcy mają Moc Oblężenia.}
      <BULLET/>Wszystkie jednostki oblężnicze, artyleryjskie i bombardujące mają +$NUMBER0 do zasięgu i +$NUMBER1 do pola widzenia.
         <BULLET/>Otrzymujesz $NUMBER3 darmowe jednostki oblężnicze za każdy nowy warsztat oblężniczy lub fabrykę.
      <BULLET/>Obywatele o $NUMBER5% tańsi. Zdobyte miasta są asymilowane o $NUMBER2% szybciej.
      <BULLET/>Jednostki oblężnicze ulepszane za darmo. Badania wojskowe w bibliotece o $NUMBER4% tańsze.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE9">
			<STRING>{Hiszpanie mają Moc Odkryć.}
         <BULLET/>Mapa jest odkryta od początku i zaczynasz z dodatkowym zwiadowcą. (W grach z „Odkrytą mapą” dostajesz dodatkowego zwiadowcę).
         <BULLET/>Linia zwiadowców jest ulepszana za darmo i szybciej używa umiejętności.
         <BULLET/>Do Epoki przemysłowej otrzymujesz darmowy ciężki okręt za każdą ukończoną przystań.
      <BULLET/>Zyskujesz $NUMBER2 zasobów z ruin i +$NUMBER3 za każdy poziom nauki.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE10">
			<STRING>{Francuzi mają Moc Przywództwa.}
      <BULLET/>Otrzymujesz darmowego generała za każdy nowo zbudowany fort.
      <BULLET/>Wozy zaopatrzeniowe leczą twoje wojska. Otrzymujesz darmowy wóz zaopatrzeniowy za każdy nowy warsztat oblężniczy lub fabrykę.
      <BULLET/>Jednostki z warsztatu oblężniczego i fabryki są o $NUMBER3% tańsze i powstają o $NUMBER4% szybciej. Poruszają się też szybciej.
      <BULLET/>Darmowy tartak i jego ulepszenia. Obozy drwali: +$NUMBER5 obywateli. Limit handlu drewnem +$NUMBER7%.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE11">
			<STRING>{Brytyjczycy mają Moc Imperium.}
         <BULLET/>+$NUMBER0% do limitu handlu. Podwójny dochód z Opodatkowania, a ulepszenia podatkowe są o 50% tańsze.
         <BULLET/>Okręty powstają o $NUMBER1% szybciej. Otrzymujesz darmową łódź rybacką za każdą nową przystań.
      <BULLET/>Darmowe ulepszenia łuczników pieszych. Otrzymujesz darmowych łuczników za każde nowe koszary (jeden oddział na starcie, dwa ze Średniowieczem, trzy z Epoką prochu).
      <BULLET/>+$NUMBER5 do zasięgu fortów i wież.
      <BULLET/>Jednostki i budynki przeciwlotnicze powstają o $NUMBER3% taniej i o $NUMBER4% szybciej.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE12">
			<STRING>{Niemcy mają Moc Przemysłu.}
         <BULLET/>Ulepszenia produkcji spichlerza, tartaku i huty są o $NUMBER7% tańsze i dostępne wcześniej.
      <BULLET/>Miasta zbierają dodatkowe +$NUMBER6 żywności, drewna i metalu. Premie za ukończenie budynków +$NUMBER5%.
      <BULLET/>Okręty podwodne i brandery budowane o $NUMBER1% szybciej i o $NUMBER2% taniej.
         <BULLET/>Jednostki lotnicze powstają o $NUMBER3% szybciej. Każda nowa baza lotnicza daje $NUMBER4 darmowe myśliwce.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE13">
			<STRING>{Rosjanie mają Moc Ojczyzny.}
         <BULLET/>Obrażenia od wyniszczenia dla wrogich jednostek na twoim terytorium większe o $NUMBER0%. Ulepszenia wyniszczenia są darmowe.
         <BULLET/>$NATIONALBORDERS0 Zaczynasz z 1 darmowym badaniem cywilnym w bibliotece.
         <BULLET/>Szpiedzy kosztują połowę ceny.
         <BULLET/>Kawaleria zadaje +$NUMBER3% obrażeń wrogim jednostkom zaopatrzenia i artylerii.
      <BULLET/>Łupy z rosyjskich budynków trafiają do Rosjan, a nie do wroga, który je złupił. +$NUMBER1% do wydobycia ropy.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE14">
			<STRING>{Chińczycy mają Moc Kultury.}
      <BULLET/>Badania naukowe w bibliotece o $NUMBER4% tańsze.
      <BULLET/>Darmowe ulepszenia Zielarstwo, Medycyna i Farmaceutyki.
      <BULLET/>Zaczynasz z dużym miastem. Nowo założone miasta stają się dużymi miastami.
      <BULLET/>Obywatele, karawany i kupcy powstają natychmiast.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE15">
			<STRING>{Japończycy mają Moc Honoru.}
         <BULLET/>Jednostki z koszar powstają o $NUMBER1% taniej i o $NUMBER2% szybciej za każdą epokę i badanie wojskowe.
         <BULLET/>Jednostki z koszar zadają o $NUMBER0% więcej obrażeń budynkom za każdą epokę i badanie wojskowe.
         <BULLET/>Okręty są o $NUMBER3% tańsze, a lotniskowce powstają o $NUMBER4% szybciej.
      <BULLET/>Farmy są o $NUMBER5% tańsze. Farmy i rybacy wytwarzają +$NUMBER6% zasobów.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE16">
			<STRING>{Koreańczycy mają Moc Tradycji.}
      <BULLET/>Zaczynasz ze świątynią i dostajesz ulepszenia religijne za darmo.
      <BULLET/>Zaczynasz z dodatkowymi obywatelami ($NUMBER1), otrzymujesz $NUMBER3 przy budowie następnego miasta i $NUMBER5 przy każdym kolejnym.
      <BULLET/>Naprawa jest o $NUMBER2% szybsza. Twoi obywatele mogą budować i naprawiać budynki pod ostrzałem bez kary.
      <BULLET/>Darmowe ulepszenia Milicja, Minuteman i Partyzant. Wieże o $NUMBER4% tańsze.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE17">
			<STRING>{Mongołowie mają Moc Hordy.}
         <BULLET/>Otrzymujesz darmową kawalerię dystansową za każdą nową stajnię lub fabrykę pojazdów ($NUMBER5 na starcie, $NUMBER3 z dwoma badaniami wojskowymi, $NUMBER7 z trzema badaniami wojskowymi).
      <BULLET/>Jednostki konne powstają o $NUMBER0% taniej i o $NUMBER1% szybciej.
         <BULLET/>Otrzymujesz +1 żywności za każde $NUMBER4% kontrolowanego lądu świata (razy połowa liczby nacji).
      <BULLET/>Wyniszczenie twoich jednostek zmniejszone o $NUMBER2%. Badania Furażowanie/Zaopatrzenie/Logistyka za darmo.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE18">
			<STRING>{Irokezi mają Moc Narodu.}
         <BULLET/>Otrzymujesz jednego darmowego zwiadowcę za każde zbudowane koszary; zwiadowcy dostają darmowe ulepszenia i mogą przechodzić przez lasy.
         <BULLET/>Pierwszy senat jest darmowy i powstaje natychmiast.
         <BULLET/>Drwale zbierają też po +2 żywności.
         <BULLET/>Jednostki wojskowe (w tym zwiadowcy) na przyjaznym terytorium są ukryte, gdy nie atakują. Wszystkie jednostki leczą się, gdy nie poruszają się ani nie atakują na przyjaznym terytorium. Jednostki z koszar mają +10% punktów życia.
         </STRING>
		</ENTRY>
		<ENTRY name="TRIBE19">
			<STRING>{Lakota mają Moc Równin.}
        <BULLET/>Zamiast budować farmy i spichlerze, otrzymujesz +$NUMBER0 żywności za każdego obywatela, zwiadowcę i jednostkę kawalerii (poza garnizonem). Farmy i spichlerze w zdobytych wrogich miastach są natychmiast niszczone.
        <BULLET/>Granice są niewidoczne dla wrogów. Możesz budować w dowolnym miejscu terytorium, które nie należy do wrogiej nacji.
      <BULLET/>Ulepszenia kawalerii dystansowej są darmowe.
        </STRING>
		</ENTRY>
		<ENTRY name="TRIBE20">
			<STRING>{Amerykanie mają Moc Innowacji.}
         <BULLET/>Pierwszy cud powstaje natychmiast (oprócz Programu kosmicznego i Superzderzacza), jeśli żadna inna nacja go nie buduje.
<BULLET/>Ustroje są darmowe. Otrzymujesz $NUMBER2 darmowych uczonych przy każdym nowym uniwersytecie.
         <BULLET/>Samoloty i lotniskowce są o $NUMBER0% tańsze. Od Epoki nowoczesnej otrzymujesz $NUMBER1 darmowe bombowce przy każdej bazie lotniczej.
      <BULLET/>Ulepszenia wojskowych jednostek lądowych o 25% tańsze. Otrzymujesz +3 żywności, drewna, metalu i bogactwa za każdą jednostkę z koszar oprócz zwiadowców (poza garnizonem).
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE20CTW">
			<STRING>{Amerykanie mają Moc Innowacji.}
         <BULLET/>Ustroje w senacie są darmowe. Otrzymujesz $NUMBER2 darmowych uczonych przy każdym nowym uniwersytecie.
         <BULLET/>Samoloty i lotniskowce są o $NUMBER0% tańsze. Od Epoki nowoczesnej otrzymujesz $NUMBER1 darmowe bombowce przy każdej bazie lotniczej (nie podnoszą one kosztu kolejnych).

      <BULLET/>Ulepszenia jednostek wojskowych o 20% tańsze. Otrzymujesz +3 żywności, drewna, metalu i bogactwa za każdą jednostkę z koszar (poza garnizonem).
      <BULLET/>Zaczynasz kampanie Podbój świata z kartą premii Buduj cud.</STRING>
		</ENTRY>
		<ENTRY name="TRIBE21">
			<STRING>{Hindusi mają Moc Majestatu.}
         <BULLET/>Koszt budynków nie rośnie, z wyjątkiem cudów, wież, strażnic i fortów, które drożeją o połowę wolniej, oraz miast, które drożeją normalnie.
      <BULLET/>+$NUMBER0 do promienia gospodarczego miast.<BULLET/>+$NUMBER1% dochodu z karawan.
      <BULLET/>Ulepszenia słoni bojowych są darmowe, a słonie bojowe są o $NUMBER2% tańsze.
      </STRING>
		</ENTRY>
		<ENTRY name="TRIBE22">
			<STRING>{Holendrzy mają Moc Handlu.}
         <BULLET/>Zaczynasz z darmową technologią handlową w bibliotece. Wszystkie kolejne technologie handlowe są o $NUMBER0% tańsze.
      <BULLET/>Zaczynasz z targiem i 2 darmowymi kupcami.<BULLET/>Za każde 100 jednostek zasobu w skarbcu ponad poziom startowy otrzymujesz +$NUMBER1 dochodu z tego zasobu (oprócz wiedzy); ten dochód może przekroczyć limit handlu o 50.
      <BULLET/>Otrzymujesz $NUMBER2 darmowe lekkie okręty za każdą ukończoną przystań. Ulepszenia okrętów są o 10% tańsze.</STRING>
		</ENTRY>
		<ENTRY name="TRIBE23">
			<STRING>{Persowie mają Moc Ceremonii.}
         <BULLET/>Zaczynasz z premią $NUMBER0% żywności.
      <BULLET/>Drugie zbudowane miasto działa jak druga stolica. Obie dostają premię stolicy do granic i obie muszą zostać zdobyte, by cię wyeliminować.
<BULLET/>Badania cywilne o $NUMBER1% tańsze.
<BULLET/>Darmowe ulepszenia Opodatkowania. <BULLET/>Zawsze masz maksymalną dozwoloną liczbę karawan.
</STRING>
		</ENTRY>
		<ENTRY name="TRIBE24">
			<STRING>{Rumunia ma Moc Karpat.}
         <BULLET/>Obrażenia od wyniszczenia dla wrogich jednostek na twoim terytorium większe o 100%. Ulepszenia wyniszczenia są darmowe.
         <BULLET/>+20% do wydobycia ropy.
         <BULLET/>Forty i wieże o 25% tańsze. Forty budują się o 50% szybciej, dają +3 do granic państwa i mają darmowe ulepszenia.
         <BULLET/>Darmowe ulepszenia do Milicji, Minutemana i Partyzanta.
         </STRING>
		</ENTRY>
	</TRIBES>
	<LIBRARY>
		<TECHCATS>
			<ENTRY name="AGETECH">
				<STRING>
					<BULLET/>
Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki.
Aby awansować do kolejnej epoki, kliknij przyciski z cyframi rzymskimi w górnym rzędzie biblioteki.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="MILITARY">
				<STRING>
					<BULLET/>
Badania #ICON24 {wojskowe} zwiększają twój #ICON20 {limit populacji}. Większość jednostek i budynków wojskowych wymaga badań wojskowych. Obniżają one też koszt jednostek i ich ulepszeń.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="SCIENCEV">
				<STRING>
					<BULLET/>
Badania #ICON27 {naukowe} obniżają {koszt badań} wszystkich technologii o $NUMBER0% i skracają czas ich badania o $NUMBER1%.
Badania naukowe zwiększają też {pole widzenia} wszystkich zwiadowców, miast i strażnic oraz premię za eksplorację ruin. Większość ulepszeń gospodarczych wymaga badań naukowych.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="SCIENCENV">
				<STRING>
					<BULLET/>
Badania {naukowe} obniżają {koszt badań} wszystkich technologii. Pozwalają też twoim zwiadowcom, miastom i strażnicom {widzieć dalej} i zwiększają premię za eksplorację ruin.  Większość ulepszeń gospodarczych wymaga badań naukowych.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="COMMERCE">
				<STRING>
					<BULLET/>
#ICON26 {Technologie handlowe} zwiększają twój #ICON21 {limit handlu}, który określa twoją {wydajność} – maksymalne tempo,
w jakim możesz zbierać każdy zasób. Zwiększają też twój #ICON9 {limit karawan}, czyli maksymalną liczbę szlaków handlowych.
</STRING>
				<TRANSLATION/>
			</ENTRY>
			<ENTRY name="CIVIC">
				<STRING>
					<BULLET/>
Badania #ICON25 {cywilne} zwiększają dozwoloną #ICON22 {liczbę miast} i poszerzają
{granice państwa}.
</STRING>
				<TRANSLATION/>
			</ENTRY>
		</TECHCATS>
		<AGES>
			<ENTRY name="AGE0">
				<STRING>
					<BULLET/>
Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki.
W większości gier twoja nacja zaczyna w {Starożytności} z niewielką wiedzą technologiczną i musi iść naprzód, badając technologie w bibliotece.
</STRING>
			</ENTRY>
			<ENTRY name="AGE1">
				<STRING>
					<BULLET/>
Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki.
Awans do #ICON28 {Epoki klasycznej} udostępnia nowe zasoby (#ICON4 wiedzę i #ICON5 metal). Pozwala też zbudować senat dający moce ustroju, forty do obrony oraz stajnie i warsztaty oblężnicze, w których powstają potężne nowe rodzaje jednostek.
</STRING>
			</ENTRY>
			<ENTRY name="AGE2">
				<STRING>
					<BULLET/>

Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki. Awans do #ICON29 {Średniowiecza} pozwala uzbroić wojska w potężniejszą broń. Pozwala też tworzyć wozy zaopatrzeniowe wspierające wojska i szpiegów do działań przeciw wrogom.
</STRING>
			</ENTRY>
			<ENTRY name="AGE3">
				<STRING>
					<BULLET/>


Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki.
Awans do #ICON30 {Epoki prochu} udostępnia potężne jednostki z bronią palną.
</STRING>
			</ENTRY>
			<ENTRY name="AGE4">
				<STRING>
					<BULLET/>
Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki.
Awans do #ICON31 {Oświecenia} udostępnia potężne nowe jednostki z muszkietami i armatami.</STRING>
			</ENTRY>
			<ENTRY name="AGE5">
				<STRING>
					<BULLET/>
Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki.
Awans do #ICON32 {Epoki przemysłowej} daje dostęp do nowego zasobu #ICON12 (ropy) i po raz pierwszy udostępnia czołgi i samoloty.</STRING>
			</ENTRY>
			<ENTRY name="AGE6">
				<STRING>
					<BULLET/>
Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki.
Awans do #ICON33 {Epoki nowoczesnej} daje dostęp do potężnych nowoczesnych jednostek i budynków, w tym możliwość
badania broni jądrowej.
</STRING>
			</ENTRY>
			<ENTRY name="AGE7">
				<STRING>
					<BULLET/>
Awans do kolejnej {epoki} oznacza postęp twojej nacji w historii; udostępnia nowe jednostki i budynki.
Awans do #ICON34 {Epoki informacji} prowadzi cię na szczyt technologii informacyjnej – najpotężniejsze jednostki i budynki w grze stają się wreszcie
dostępne.
</STRING>
			</ENTRY>
		</AGES>
		<ENTRY name="TECHS">
			<STRING/>
		</ENTRY>
	</LIBRARY>
	<SETUPWIN>
		<SETUPCHECKS>
			<ENTRY name="SETUPCHECK0">
				<STRING>
{ZAPISZ W PROFILU}: Zaznacz to pole, aby zapisać swój profil. Obecne ustawienia staną się domyślne przy następnej grze.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK1">
				<STRING>
{TURBO-ZASOBY}: Zaznacz to pole, aby przyspieszyć zbieranie zasobów. Ta opcja jest dla graczy, którzy wolą mniej skupiać się na zbieraniu zasobów, a więcej na innych elementach gry.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK2">
				<STRING>
{BEZ MOCY NACJI}: Zaznacz to pole, aby wyłączyć specjalne zdolności nacji (takie jak Moc Cezara Rzymian).
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK3">
				<STRING>
{BEZ UNIKALNYCH JEDNOSTEK}: Zaznacz to pole, aby używać tylko standardowego zestawu jednostek. Żadna nacja nie otrzyma unikalnych jednostek (takich jak japońscy samuraje).
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK4">
				<STRING>
{KOOPERACYJNE SI}: Gracz komputerowy będzie kierował twoją nacją razem z tobą.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK5">
				<STRING>
{CZAT OBSERWATORÓW}: Gdy to pole jest zaznaczone, obserwatorzy mogą pisać do wszystkich graczy po naciśnięciu Shift+ENTER; gdy nie jest, obserwatorzy nie mogą pisać do graczy w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK6">
				<STRING>
{WOLNA PAUZA}: Zaznacz to pole, aby gracze mogli przewijać ekran i wydawać rozkazy podczas pauzy. Ta opcja jest zawsze aktywna w grach solo, ale w grach wieloosobowych trzeba ją wybrać tutaj.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK7">
				<STRING>
{TRYB TURNIEJOWY}: Zaznacz to pole, aby ukryć wybory nacji przed grą i wyniki graczy w trakcie gry. Gracze, którzy wcześnie się poddadzą, nie zobaczą całej mapy aż do końca gry.</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK8">
				<STRING>
{ZABLOKUJ PRĘDKOŚĆ GRY}: Jeśli prędkość gry jest zablokowana, gracze nie mogą jej zmienić po rozpoczęciu gry. Ta opcja jest wymagana dla {czasu buforowego}.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK9">
				<STRING>
{WYMAGAJ LOSOWYCH DRUŻYN}: Ta opcja uniemożliwia graczom wybór współgraczy – muszą wybrać {"?"}.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK10">
				<STRING>
{WYMAGAJ LOSOWYCH NACJI}: Ta opcja uniemożliwia graczom wybór konkretnej nacji – muszą wybrać {Losowo}.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK11">
				<STRING>
{WSPÓLNA KONTROLA DRUŻYNY}: Pozwala wszystkim graczom w drużynie kierować jednostkami każdej nacji tej drużyny.
</STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK12">
				<STRING>
          {TYLKO RANKINGOWE}: Gdy to pole jest zaznaczone, w przeglądarce poczekalni pojawią się tylko gry rankingowe.
        </STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK13">
				<STRING>
          {TYLKO BEZ RANKINGU}: Gdy to pole jest zaznaczone, w przeglądarce poczekalni pojawią się tylko gry bez rankingu.
        </STRING>
			</ENTRY>
			<ENTRY name="SETUPCHECK14">
				<STRING>
{BEZ BRONI NUKLEARNEJ}: Zaznacz to pole, aby grać bez broni nuklearnej. Nikt nie może budować pocisków nuklearnych, ICBM ani pocisków przechwytujących; pociski manewrujące zostają.
				</STRING>
			</ENTRY>
		</SETUPCHECKS>
		<NAMES>
			<ENTRY name="NAME">
				<STRING>
{GRACZ}: Pokazuje, kto pokieruje każdą nacją. W grze wieloosobowej gospodarz
może ustawić każde miejsce jako Otwarte, Zamknięte lub Komputer.
</STRING>
			</ENTRY>
			<ENTRY name="NAMEX">
				<STRING>
{GRACZ}: Pokazuje, kto pokieruje każdą nacją. W grze wieloosobowej gospodarz
może ustawić każde miejsce jako Otwarte, Zamknięte lub Komputer.
</STRING>
			</ENTRY>
			<ENTRY name="NAME0">
				<STRING>
{CZŁOWIEK}: Tą nacją pokieruje człowiek. Jeśli w grze solo ustawisz kilka miejsc na {Człowiek},
będziesz mógł przełączać się między kierowaniem dwiema lub więcej nacjami – wystarczy kliknąć jednostkę lub
budynek innej nacji typu {Człowiek}, aby przejąć nad nią kontrolę.
</STRING>
			</ENTRY>
			<ENTRY name="NAME1">
				<STRING>
{KOMPUTER}: Tą nacją pokieruje gracz komputerowy.
</STRING>
			</ENTRY>
			<ENTRY name="NAME2">
				<STRING>
{KOMPUTER (rush)}: Tą nacją pokieruje gracz komputerowy. Będzie budował szybko i agresywnie oraz spróbuje zaatakować wcześnie.
</STRING>
			</ENTRY>
			<ENTRY name="NAME3">
				<STRING>
{KOMPUTER (boom)}: Tą nacją pokieruje gracz komputerowy. Przed atakiem w pełnej sile skupi się na zbudowaniu silnej gospodarki.
</STRING>
			</ENTRY>
			<ENTRY name="NAME4">
				<STRING>
{OTWARTE}: To miejsce jest otwarte – gracze mogą dołączyć do gry.
</STRING>
			</ENTRY>
			<ENTRY name="NAME5">
				<STRING>
{ZAMKNIĘTE}: To miejsce jest niedostępne – gracze nie mogą przez nie dołączyć do gry.
</STRING>
			</ENTRY>
			<ENTRY name="NAME6">
				<STRING>
{BRAK}: Usuwa tego gracza z gry – zagrasz z jednym przeciwnikiem lub sojusznikiem mniej. Jeśli
chcesz dodać {więcej} nacji do gry, zwiększ ustawienie {Inne nacje}.
</STRING>
			</ENTRY>
			<ENTRY name="NAME7">
				<STRING>
{WYRZUĆ GRACZA}: Usuwa tego gracza-człowieka z gry.
</STRING>
			</ENTRY>
			<ENTRY name="NAME8">
				<STRING>
{WSZYSTKO: CZŁOWIEK}: Oddaje wszystkie nacje pod kontrolę człowieka. Możesz przełączać się
między nacjami, klikając dowolną jednostkę lub budynek nacji, którą chcesz kierować.
</STRING>
			</ENTRY>
			<ENTRY name="NAME9">
				<STRING>
{WSZYSTKO: KOMPUTER}: Oddaje wszystkie nacje pod kontrolę komputera, więc możesz oglądać, jak komputer gra sam ze sobą.
</STRING>
			</ENTRY>
		</NAMES>
		<HANDICAPS>
			<ENTRY name="HANDICAP">
				<STRING>
{POZIOM}: Kliknij tutaj, aby ustawić handicap tego gracza. W grze wieloosobowej bardziej
doświadczeni gracze mogą zwiększyć swój handicap, aby wyrównać drużyny. Wyższy poziom
przyspiesza zbieranie zasobów przez PRZECIWNIKÓW gracza.
</STRING>
			</ENTRY>
			<ENTRY name="HANDICAPX">
				<STRING>
{POZIOM}: W grze wieloosobowej bardziej doświadczeni gracze mogą zwiększyć swój handicap,
aby wyrównać drużyny. Wyższy poziom przyspiesza zbieranie zasobów przez PRZECIWNIKÓW
gracza.
</STRING>
			</ENTRY>
		</HANDICAPS>
		<WHOS>
			<ENTRY name="WHO">
				<STRING>
{KOLOR}: Kliknij tutaj, aby wybrać kolor gracza. Jeśli dwóch graczy wybierze ten sam kolor,
zagrają kooperacyjnie, wspólnie kierując tymi samymi jednostkami i budynkami.
</STRING>
			</ENTRY>
			<ENTRY name="WHOX">
				<STRING>
{KOLOR}: Pokazuje kolor tego gracza. Jeśli dwóch graczy wybierze ten sam kolor,
zagrają kooperacyjnie, wspólnie kierując tymi samymi jednostkami i budynkami.
</STRING>
			</ENTRY>
		</WHOS>
		<GAMESTYLES>
			<ENTRY name="GAMESTYLE">
				<STRING>
{DRUŻYNY I SOJUSZE}: Kliknij tutaj, aby wybrać, czy i jak nacje zostaną podzielone na drużyny – oraz czy sojusze mogą się zmieniać w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLEX">
				<STRING>
{DRUŻYNY I SOJUSZE}: Określa, jak nacje są dzielone na drużyny i czy sojusze mogą się zmieniać
w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE0">
				<STRING>
{DYPLOMACJA}: Nacje zaczynają samotnie, ale mogą zawierać traktaty i sojusze.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE1">
				<STRING>
{PRZETRWAJĄ NAJSILNIEJSI}: Każda nacja walczy sama za siebie; sojusze są niedozwolone.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE2">
				<STRING>
{ZABÓJCA}: Nasz zalecany tryb „każdy na każdego”! Sojusze są niedozwolone, A KAŻDA nacja dostaje
wyznaczoną nację-cel i może wkraczać tylko na terytorium tego wroga. Wejście na terytorium
nacji, która nie jest twoim celem, powoduje dotkliwe wyniszczenie. Gdy nacja zostanie wyeliminowana,
nacja, która na nią polowała, przejmuje cel wyeliminowanej nacji.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE3">
				<STRING>
{BARBARZYŃCY U BRAM}: Świetne dla tych, którzy lubią, gdy wszyscy rzucają się na nich! Grupa barbarzyńskich nacji próbuje zniszczyć
jedną broniącą się nację, zanim skończy się czas. Barbarzyńskie nacje mogą otrzymać niższy poziom technologii i zasobów
niż obrońcy. W grze solo grasz przeciwko wszystkim graczom komputerowym; w grze wieloosobowej gracze
mogą wybrać dowolną stronę (Drużyna 1 się broni, Drużyna 2 atakuje).</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE4">
				<STRING>
{DRUŻYNY PO 2}: Z góry ustalone sojusze po 2 nacje. Gracze nie mogą zmienić przynależności w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE5">
				<STRING>{DRUŻYNY PO 3}: Z góry ustalone sojusze po 3 nacje. Gracze nie mogą zmienić przynależności w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE6">
				<STRING>{DRUŻYNY PO 4}: Z góry ustalone sojusze po 4 nacje. Gracze nie mogą zmienić przynależności w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE7">
				<STRING>
{DYPLOMACJA DRUŻYNOWA}: (tylko gra wieloosobowa)}: Z góry ustalone drużyny oraz kilka neutralnych nacji, z którymi można zawrzeć sojusz. Tylko
neutralne nacje mogą zmieniać sojusze w trakcie gry. Każda drużyna może próbować przeciągnąć neutralne nacje
na swoją stronę za pomocą dyplomacji.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE8">
				<STRING>
{DYPLOMACJA KOOPERACYJNA}: (tylko gra wieloosobowa) Pary graczy wspólnie kierują każdą nacją.
Nacje zaczynają samotnie, ale mogą zawierać sojusze.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE9">
				<STRING>
{PRZETRWANIE KOOPERACYJNE}: (tylko gra wieloosobowa) Pary graczy wspólnie kierują każdą nacją, ale
sojusze między nacjami są niedozwolone.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE10">
				<STRING>{DRUŻYNY KOOPERACYJNE}: (tylko gra wieloosobowa) Pary graczy wspólnie kierują każdą nacją, a nacje zaczynają grę jako sojusznicy w drużynach po 2 nacje. Gracze nie mogą zmienić przynależności w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE11">
				<STRING>
{WŁASNA DYPLOMACJA}: Indywidualnie ustal drużynę i ustawienia kooperacji każdego gracza. Pozwala to tworzyć
własne sytuacje, np. nierówne drużyny. Gracze mogą swobodnie zawierać i zrywać sojusze w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE12">
				<STRING>
{WŁASNE DRUŻYNY}: Indywidualnie ustal drużynę i ustawienia kooperacji każdego gracza. Pozwala to tworzyć
własne sytuacje, np. nierówne drużyny. Gracze nie mogą zmienić przynależności w trakcie gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMESTYLE13">
				<STRING>
{ZAPISANA GRA}: Wczytaj wcześniej zapisaną grę.
</STRING>
			</ENTRY>
		</GAMESTYLES>
		<GAMERULES>
			<ENTRY name="GAMERULES">
				<STRING>
{ZASADY}: Kliknij tutaj, aby wybrać, czy gra będzie toczona według standardowych, czy własnych zasad.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULESX">
				<STRING>
{ZASADY}: Określa, czy gra będzie toczona według standardowych, czy własnych zasad.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES0">
				<STRING>
{STANDARD}: Standardowe zasady są zalecane dla nowych graczy i tych, którzy chcą grać w najczęstszej
konfiguracji gry. W grze standardowej gracz lub drużyna wygrywa, kontrolując 70%
terytorium świata, budując i utrzymując o 8 punktów cudów więcej niż przeciwnicy albo podbijając wszystkich wrogów. Wrogów można
wyeliminować, zdobywając i utrzymując ich stolice.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES1">
				<STRING>
{WŁASNE}: Własne zasady włączają nowe opcje, które pozwalają dostosować zasady gry.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES2">
				<STRING>{BEZ SZTURMU}: Ataki są niedozwolone, dopóki co najmniej jeden gracz nie osiągnie Epoki prochu.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES3">
				<STRING>
{NAGŁA ŚMIERĆ}: Gracze przegrywają natychmiast, gdy którekolwiek z ich miast zostanie zdobyte, i wygrywają natychmiast, budując dość cudów lub kontrolując 70% terytorium świata.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES4">
				<STRING>{DEATHMATCH}: Gracze zaczynają z ogromnym zapasem każdego zasobu.
</STRING>
			</ENTRY>
			<!--
      <ENTRY name="GAMERULES5">
        <STRING>{INFINITE RESOURCES}: Players have infinite resources and begin with Gunpowder Age technology.
</STRING>
      </ENTRY>
-->
			<ENTRY name="GAMERULES5">
				<STRING>
{KOCZOWNIK}: Gracze nie zaczynają gry z miastem ani zwiadowcą. Moce nacji działają dopiero po zbudowaniu pierwszego miasta.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES6">
				<STRING>
{POKOJOWY WYŚCIG TECHNOLOGII}: Gracze nie mogą walczyć; wygrywa ten, kto pierwszy osiągnie wybraną epokę końcową lub Epokę informacji.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES7">
				<STRING>
{ZABÓJCA}: Nasz zalecany tryb „każdy na każdego”! Sojusze są niedozwolone, A KAŻDA nacja dostaje
wyznaczoną nację-cel i może wkraczać tylko na terytorium tego wroga. Wejście na terytorium
nacji, która nie jest twoim celem, powoduje dotkliwe wyniszczenie. Gdy nacja zostanie wyeliminowana,
nacja, która na nią polowała, przejmuje cel wyeliminowanej nacji.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES8">
				<STRING>
{BARBARZYŃCY U BRAM}: Świetne dla tych, którzy lubią, gdy wszyscy rzucają się na nich! Grupa barbarzyńskich nacji próbuje zniszczyć
jedną broniącą się nację, zanim skończy się czas. Barbarzyńskie nacje mogą otrzymać niższy poziom technologii i zasobów
niż obrońcy. W grach wieloosobowych Drużyna 1 się broni, a Drużyna 2 atakuje.
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES9">
				<STRING>
{SZYBKA GRA}: Technologie można badać szybko, a zasoby powstają w szybkim tempie (jak przy włączonych Turbo-zasobach).
</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES10">
				<STRING>{SCENARIUSZ}: Wybierz własny scenariusz wieloosobowy. Każdej pozycji [scenarioname] na liście odpowiada plik ./scenario/Custom/[scenarioname]/[scenarioname].scx.</STRING>
			</ENTRY>
			<ENTRY name="GAMERULES11">
				<STRING>{DEATHMATCH EPOKI INFORMACJI}: Gracze zaczynają z ogromnym zapasem każdego zasobu i wszystkimi zbadanymi technologiami. Nie można badać technologii przyszłości ani budować broni jądrowej.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS0">
				<STRING>{BARDZO WOLNO}: Ustawia bardzo wolną prędkość gry – na dłuższe rozgrywki.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS1">
				<STRING>{WOLNO}: Ustawia wolną prędkość gry.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS3">
				<STRING>{SZYBKO}: Ustawia szybką prędkość gry.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS4">
				<STRING>{BARDZO SZYBKO} Ustawia bardzo szybką prędkość gry.</STRING>
			</ENTRY>
			<ENTRY name="GAMESPEEDS2">
				<STRING>{NORMALNIE}: Ustawia normalną prędkość gry.</STRING>
			</ENTRY>
		</GAMERULES>
		<CANNONTIMES>
			<ENTRY name="CANNONTIME">
				<STRING>
{CZAS BUFOROWY}: Kliknij, aby pozwolić każdemu graczowi na krótkie okresy „super zwolnionego tempa” w grze wieloosobowej.
</STRING>
			</ENTRY>
			<ENTRY name="CANNONTIMEX">
				<STRING>
{CZAS BUFOROWY}: Określa, jak często każdy gracz może włączyć na krótko „super zwolnione tempo” w grze wieloosobowej.
</STRING>
			</ENTRY>
			<ENTRY name="CANNONTIME0">
				<STRING>
{BRAK}: „Super zwolnione tempo” jest niedozwolone.
</STRING>
			</ENTRY>
			<ENTRY name="CANNONTIME1">
				<STRING>
{1 CZAS BUFOROWY}: Każdy gracz może raz użyć 15-sekundowego „super zwolnionego tempa”.
</STRING>
			</ENTRY>
			<ENTRY name="CANNONTIME2">
				<STRING>
{2 CZASY BUFOROWE}: Każdy gracz może dwa razy użyć 15-sekundowego „super zwolnionego tempa”.
</STRING>
			</ENTRY>
			<ENTRY name="CANNONTIME3">
				<STRING>
{4 CZASY BUFOROWE}: Każdy gracz może cztery razy użyć 15-sekundowego „super zwolnionego tempa”.
</STRING>
			</ENTRY>
			<ENTRY name="CANNONTIME4">
				<STRING>
{8 CZASÓW BUFOROWYCH}: Każdy gracz może osiem razy użyć 15-sekundowego „super zwolnionego tempa”.
</STRING>
			</ENTRY>
		</CANNONTIMES>
		<RUSHRULES>
			<ENTRY name="RUSHRULES">
				<STRING>
{ZASADY RUSHU}: Kliknij, aby określić, czy i kiedy dozwolony jest „rush” (wczesny atak).
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULESX">
				<STRING>
{ZASADY RUSHU}: Określa, czy i kiedy dozwolony jest „rush” (wczesny atak).
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULESXS">
				<STRING>
{ZASADY RUSHU}: Określa, czy i kiedy dozwolony jest „rush” (wczesny atak). [Nie można zmienić, gdy zasady gry są ustawione na Standard.]
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES0">
				<STRING>
{STANDARD}: Standardowe zasady rushu oznaczają, że gracze mogą atakować się nawzajem w dowolnym momencie.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES1">
				<STRING>
{POKÓJ DO EPOKI KLASYCZNEJ}: Gracze nie mogą się atakować, dopóki co najmniej jeden z nich nie osiągnie Epoki klasycznej.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES2">
				<STRING>
{POKÓJ DO ŚREDNIOWIECZA}: Gracze nie mogą się atakować, dopóki co najmniej jeden z nich nie osiągnie Średniowiecza.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES3">
				<STRING>
{POKÓJ DO EPOKI PROCHU}: Gracze nie mogą się atakować, dopóki co najmniej jeden z nich nie osiągnie Epoki prochu.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES4">
				<STRING>
{POKÓJ DO OŚWIECENIA}: Gracze nie mogą się atakować, dopóki co najmniej jeden z nich nie osiągnie Oświecenia.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES5">
				<STRING>
{POKÓJ DO EPOKI PRZEMYSŁOWEJ}: Gracze nie mogą się atakować, dopóki co najmniej jeden z nich nie osiągnie Epoki przemysłowej.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES6">
				<STRING>
{POKÓJ DO EPOKI NOWOCZESNEJ}: Gracze nie mogą się atakować, dopóki co najmniej jeden z nich nie osiągnie Epoki nowoczesnej.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES7">
				<STRING>
{POKÓJ DO EPOKI INFORMACJI}: Gracze nie mogą się atakować, dopóki co najmniej jeden z nich nie osiągnie Epoki informacji.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES8">
				<STRING>
{BEZ PRZEMOCY}: Gracze nigdy nie mogą się atakować.
</STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES9">
				<STRING>{POKÓJ PRZEZ PIERWSZE 2 MIN}: Gracze nie mogą się atakować przez pierwsze 2 minuty.    </STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES10">
				<STRING>{POKÓJ PRZEZ PIERWSZE 5 MINUT}: Gracze nie mogą się atakować przez pierwsze 5 minut.    </STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES11">
				<STRING>{POKÓJ PRZEZ PIERWSZE 10 MINUT}: Gracze nie mogą się atakować przez pierwsze 10 minut.   </STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES12">
				<STRING>{POKÓJ PRZEZ PIERWSZE 15 MINUT}: Gracze nie mogą się atakować przez pierwsze 15 minut.   </STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES13">
				<STRING>{POKÓJ PRZEZ PIERWSZE 20 MINUT}: Gracze nie mogą się atakować przez pierwsze 20 minut.   </STRING>
			</ENTRY>
			<ENTRY name="RUSHRULES14">
				<STRING>{POKÓJ PRZEZ PIERWSZE 30 MINUT}: Gracze nie mogą się atakować przez pierwsze 30 minut.   </STRING>
			</ENTRY>
		</RUSHRULES>
		<MAPSTYLES>
			<ENTRY name="MAPSTYLE">
				<STRING>
{TYP MAPY}: Kliknij tutaj, aby wybrać typ mapy, na której zagrasz. Każdy typ mapy daje inny rodzaj
gry i inną sytuację strategiczną.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLEX">
				<STRING>
{TYP MAPY}: Typ mapy, na której toczy się gra. Każdy typ mapy daje inny rodzaj
gry i inną sytuację strategiczną.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE0">
				<STRING>
{LOSOWO}: Wybiera losowy typ mapy na początku gry. Wylosowany typ nie będzie Nowym Światem ani Potęgami kolonialnymi. 
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE1">
				<STRING>
{LOSOWA MAPA LĄDOWA}: Wybiera losowy typ mapy na początku gry. Zawsze zostanie wybrana „mapa
lądowa”, więc wszyscy gracze zaczną na tym samym lądzie i choć na mapie może być woda, żaden ląd nie będzie oddzielony wodą.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE2">
				<STRING>
{LOSOWA MAPA MORSKA}: Wybiera losowy typ mapy na początku gry. Zawsze zostanie wybrana „mapa
morska”, więc przynajmniej część lądów będzie oddzielona morzem (pozycje startowe graczy mogą, ale nie muszą być oddzielone morzem). Wylosowany typ nie będzie Potęgami kolonialnymi.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE3">
				<STRING>
{TAJNA LOSOWA}: Wybiera losowy typ mapy na początku gry. Typ mapy pozostanie ukryty przez całą grę i można go odkryć tylko przez eksplorację.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE4">
				<STRING>
{TAJNA LOSOWA MAPA LĄDOWA}: Wybiera losowy typ mapy na początku gry. Zawsze zostanie wybrana „mapa
lądowa”, więc wszyscy gracze zaczną na tym samym lądzie. Typ mapy pozostanie ukryty przez całą grę i można go odkryć tylko przez eksplorację.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE5">
				<STRING>
{TAJNA LOSOWA MAPA MORSKA}: Wybiera losowy typ mapy na początku gry. Zawsze zostanie wybrana „mapa
morska”, więc przynajmniej część graczy będzie oddzielona morzem. Typ mapy pozostanie ukryty przez całą grę i można go odkryć tylko przez eksplorację.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE6">
				<STRING>
{STARY ŚWIAT}: Jeden ogromny kontynent dla wszystkich. Rzeki, lasy i góry stawiają wyzwania taktyczne.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE7">
				<STRING>

{WIELKA SAHARA}: Pustynna mapa lądowa. Drzewa rosną tylko w kilku oazach, ale w Epoce przemysłowej znajdziesz mnóstwo ropy.

          </STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE8">
				<STRING>
{PUSZCZA AMAZOŃSKA}: Mnóstwo zasobów i ruin ukrytych w labiryncie tropikalnych rzek i polan w dżungli.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE9">
				<STRING>{HIMALAJE}: Mapa lądowa z wieloma górami i przełęczami w środku oraz lasami na obrzeżach.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE10">
				<STRING>{MESA PŁD.-ZACH.}: Pustynna mapa lądowa z wieloma klifami i płaskowyżami. Walcz o wzgórza!
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE11">
				<STRING>{AFRYKAŃSKI WODOPÓJ}: Wszystkie rzadkie surowce leżą wokół samotnego wodopoju w środku mapy. Udanych łowów!
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE12">
				<STRING>
{MORZE ŚRÓDZIEMNE}: Ląd otaczający centralne morze z małą wyspą.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE13">
				<STRING>
{AUSTRALIJSKI INTERIOR}: Surowa pustynia lub bujna dżungla – otoczona oceanem pełnym ryb.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE14">
				<STRING>{WIELKIE JEZIORA}: Żyzna mapa lądowa pełna dużych jezior, przydatnych do łowienia ryb, działań flot i przerzucania armii.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE15">
				<STRING>
{WALCZĄCE KRÓLESTWA}: Jeden duży kontynent dla wszystkich, otoczony archipelagiem. Kontynent jest wydłużony jak Japonia.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE16">
				<STRING>{NOWY ŚWIAT}: Każda nacja dostaje ciasną wyspę i musi eksploatować bogaty ląd stały.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE17">
				<STRING>
{POTĘGI KOLONIALNE}: Dwa duże kontynenty, a wszyscy gracze na jednym! Uwaga}: w grach z Dyplomacją drużynową wszyscy
neutralni gracze komputerowi trafiają na drugi kontynent.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE18">
				<STRING>
{INDIE WSCHODNIE}: Mnóstwo wysp, mnóstwo zasobów. Zabierz flotę.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE19">
				<STRING>
{WSCHÓD I ZACHÓD}: Każda drużyna dzieli własny duży kontynent.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE20">
				<STRING>
{POTĘGA ATLANTYCKA}: Każda nacja dostaje własny ląd; graczy dzieli wielki ocean.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE21">
				<STRING>
{DELTA NILU}: Gracze stają naprzeciw siebie po dwóch stronach wielkiej rzeki.
</STRING>
			</ENTRY>
			<ENTRY name="MAPSTYLE22">
				<STRING>
{WYSPY BRYTYJSKIE}: Nacje zaczynają na wyspach różnej wielkości, które mogą, ale nie muszą odcinać je od sojuszników. Gdy przyjdzie czas wierceń za ropą, będziesz musiał budować platformy na morzu.</STRING>
			</ENTRY>
		</MAPSTYLES>
		<TEAMS>
			<ENTRY name="TEAM">
				<STRING>
{DRUŻYNA}: Kliknij tutaj, aby dołączyć do drużyny. Jeśli co najmniej dwóch graczy zaczyna w tej samej drużynie,
rozpoczną grę jako sojusznicy. Gracze, którzy wybiorą {?}, zostaną przydzieleni do losowej drużyny
na początku gry.
</STRING>
			</ENTRY>
			<ENTRY name="TEAMX">
				<STRING>
{DRUŻYNA}: Pokazuje, w której drużynie będzie ten gracz. Jeśli co najmniej dwóch graczy zaczyna w tej samej drużynie,
rozpoczną grę jako sojusznicy. Gracze, którzy wybiorą {?}, zostaną przydzieleni do losowej drużyny
na początku gry.
</STRING>
			</ENTRY>
		</TEAMS>
		<SIZES>
			<ENTRY name="SIZE">
				<STRING>
{ROZMIAR MAPY}: Kliknij tutaj, aby wybrać rozmiar mapy. Mniejsze mapy dają krótsze gry; większe opóźniają
pierwszy kontakt między nacjami.
</STRING>
			</ENTRY>
			<ENTRY name="SIZEX">
				<STRING>
{ROZMIAR MAPY}: Określa rozmiar mapy. Mniejsze mapy dają krótsze gry; większe opóźniają
pierwszy kontakt między nacjami.
</STRING>
			</ENTRY>
			<ENTRY name="SIZE0">
				<STRING>






Mapy {Malutkie} nadają się do gier dwuosobowych z szybkim kontaktem.






            <!--Tiny-->
				</STRING>
			</ENTRY>
			<ENTRY name="SIZE1">
				<STRING>






Mapy {Arena} zapewniają zacięte starcia dwóch graczy: gracze są blisko siebie, więc walka jest szybka i zażarta. 






            <!--Small-->
				</STRING>
			</ENTRY>
			<ENTRY name="SIZE2">
				<STRING>






Mapy {Małe} nadają się do gier dla dwóch i trzech graczy.






            <!--Medium-->
				</STRING>
			</ENTRY>
			<ENTRY name="SIZE3">
				<STRING>






Mapy {Standard} nadają się do gier czteroosobowych.






            <!--Standard-->
				</STRING>
			</ENTRY>
			<ENTRY name="SIZE4">
				<STRING>






Mapy {Duże} nadają się do gier dla pięciu i sześciu graczy.






            <!--Large-->
				</STRING>
			</ENTRY>
			<ENTRY name="SIZE5">
				<STRING>






Mapy {Ogromne} nadają się do gier dla siedmiu i ośmiu graczy.






            <!--Huge-->
				</STRING>
			</ENTRY>
			<ENTRY name="SIZE6">
				<STRING>






Mapy {Gigantyczne} nadają się dla dużej liczby graczy i wtedy, gdy pierwszy kontakt ma nastąpić późno. Uważamy też, że mają najfajniejszą nazwę.






            <!--Big Huge-->
				</STRING>
			</ENTRY>
		</SIZES>
		<DIFFICULTIES>
			<ENTRY name="DIFFICULTY">
				<STRING>
{TRUDNOŚĆ}: Kliknij tutaj, aby wybrać poziom trudności. Określa on wydajność i agresywność graczy komputerowych.
</STRING>
			</ENTRY>
			<ENTRY name="DIFFICULTYX">
				<STRING>
{TRUDNOŚĆ}: Określa wydajność i agresywność graczy komputerowych.
</STRING>
			</ENTRY>
			<ENTRY name="DIFFICULTY0">
				<STRING>
Na poziomie {Bardzo łatwy} nacje komputerowe grają wolno i nieefektywnie; atakują tylko z rzadka. W grze solo zbierasz też zasoby znacznie szybciej niż komputer. To dobry poziom, gdy dopiero uczysz się gry.
            </STRING>
			</ENTRY>
			<ENTRY name="DIFFICULTY1">
				<STRING>

Na poziomie {Łatwy} nacje komputerowe grają wolno i nieefektywnie. Atakują czasem, ale rzadko dużymi siłami. W grze solo zbierasz też zasoby nieco szybciej niż komputer. Dobry poziom, jeśli jesteś nowym graczem, ale znasz już podstawy.

            </STRING>
			</ENTRY>
			<ENTRY name="DIFFICULTY2">
				<STRING>
Na poziomie {Średni} nacje komputerowe czasem zachowują się agresywnie i atakują małymi armiami, ale nie grają z maksymalną wydajnością. Ani ty, ani komputer nie dostajecie żadnej premii do zasobów. Dobry poziom dla średnio zaawansowanych graczy lub zaawansowanych początkujących.
            </STRING>
			</ENTRY>
			<ENTRY name="DIFFICULTY3">
				<STRING>

Na poziomie {Trudny} grasz z komputerem na równych warunkach. Nacje komputerowe grają wydajnie i agresywnie, atakując sporymi armiami. Dobry poziom dla bardziej zaawansowanych graczy, którzy szukają „uczciwej gry”.

            </STRING>
			</ENTRY>
			<ENTRY name="DIFFICULTY4">
				<STRING>
Na poziomie {Trudniejszy} nacje komputerowe grają z brutalną wydajnością i atakują ogromnymi armiami. Nie „oszukują” wprost, ale dostają znaczną premię do zbierania zasobów, więc uważaj! Dobry poziom dla zaawansowanych graczy szukających prawdziwego wyzwania.
</STRING>
			</ENTRY>
			<ENTRY name="DIFFICULTY5">
				<STRING>
Na poziomie {Bardzo trudny} nacje komputerowe nie tylko grają najlepiej, jak potrafią, ale też dostają ogromną premię do zbierania zasobów. Sparingpartner dla graczy turniejowych – albo dla szaleńców. 
</STRING>
			</ENTRY>
		</DIFFICULTIES>
		<STARTINGTOWNS>
			<ENTRY name="STARTINGTOWN">
				<STRING>
{START Z}: Kliknij tutaj, aby ustawić, z iloma budynkami każda nacja zaczyna grę.
</STRING>
			</ENTRY>
			<ENTRY name="STARTINGTOWNX">
				<STRING>
{START Z}: Określa, z iloma budynkami każda nacja zaczyna grę.
</STRING>
			</ENTRY>
			<ENTRY name="STARTINGTOWNXS">
				<STRING>
{START Z}: Określa, z iloma budynkami każda nacja zaczyna grę. [Nie można zmienić, gdy zasady gry są ustawione na Standard.]
</STRING>
			</ENTRY>
			<ENTRY name="STARTINGTOWN0">
				<STRING>
{KOCZOWNIK}: Nacje zaczynają tylko z kilkoma obywatelami i muszą same zbudować pierwsze miasta.
</STRING>
			</ENTRY>
			<ENTRY name="STARTINGTOWN1">
				<STRING>
{TYLKO CENTRUM MIASTA}: Nacje zaczynają z samym miastem, kilkoma obywatelami i zwiadowcą.
</STRING>
			</ENTRY>
			<ENTRY name="STARTINGTOWN2">
				<STRING>
{MAŁE MIASTECZKO}: Nacje zaczynają z miastem i kilkoma budynkami, a także z obywatelami i zwiadowcą.
</STRING>
			</ENTRY>
			<ENTRY name="STARTINGTOWN3">
				<STRING>
{DUŻE MIASTECZKO}: Nacje zaczynają z dobrze rozwiniętym miastem, a także z obywatelami i zwiadowcą.
</STRING>
			</ENTRY>
		</STARTINGTOWNS>
		<RESOURCES>
			<ENTRY name="RESOURCES">
				<STRING>
{ZASOBY}: Kliknij tutaj, aby wybrać ilość każdego podstawowego zasobu na początku gry (oraz ilość
otrzymywaną po odkryciu każdego nowego rodzaju zasobu).
</STRING>
			</ENTRY>
			<ENTRY name="RESOURCESX">
				<STRING>
{ZASOBY}: Określa ilość każdego podstawowego zasobu, z jaką gracze zaczynają grę (oraz ilość
otrzymywaną po odkryciu każdego nowego rodzaju zasobu).
</STRING>
			</ENTRY>
			<ENTRY name="RESOURCESXS">
				<STRING>
{ZASOBY}: Określa ilość każdego podstawowego zasobu, z jaką gracze zaczynają grę (oraz ilość
otrzymywaną po odkryciu każdego nowego rodzaju zasobu). [Nie można zmienić, gdy zasady gry są ustawione na Standard.]
</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES0">
				<STRING>






Nacje zaczynają grę z bardzo małą ilością zasobów (połową standardowej).






            <!--Low-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES1">
				<STRING>






Nacje zaczynają grę ze standardową ilością zasobów.






            <!--Standard-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES2">
				<STRING>






Nacje zaczynają grę z podwójną ilością zasobów.






            <!--x2-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES3">
				<STRING>






Nacje zaczynają grę z potrójną ilością zasobów.






            <!--x3-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES4">
				<STRING>






Nacje zaczynają grę z pięciokrotną ilością zasobów.






            <!--x5-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES5">
				<STRING>






Nacje zaczynają grę z dziesięciokrotną ilością zasobów.






            <!--x10-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES6">
				<STRING>






Nacje zaczynają grę z dwudziestokrotną ilością zasobów.






            <!--x20-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES7">
				<STRING>






Nacje zaczynają grę ze stukrotną ilością zasobów.






            <!--Deathmatch-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES8">
				<STRING>






Nacje zaczynają grę z nieskończonymi zasobami – twoje zasoby nigdy się nie wyczerpią!






            <!--Infinite-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES9">
				<STRING>






Nacje zaczynają grę z małą, ale zmienną ilością zasobów. Poszczególne zasoby mogą startować z różnych poziomów (np. każdy
zaczyna z większą ilością drewna niż żywności), ale każdy gracz zaczyna z tą samą ilością.






            <!--Low Variable-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES10">
				<STRING>






Nacje zaczynają grę z umiarkowaną, zmienną ilością zasobów. Poszczególne zasoby mogą startować z różnych poziomów (np. każdy
zaczyna z większą ilością bogactwa niż żywności), ale każdy gracz zaczyna z tą samą ilością.






            <!--Medium Variable-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES11">
				<STRING>






Nacje zaczynają grę z dużą, zmienną ilością zasobów. Poszczególne zasoby mogą startować z różnych poziomów (np. każdy
zaczyna z większą ilością bogactwa niż żywności), ale każdy gracz zaczyna z tą samą ilością.






            <!--High Variable-->
				</STRING>
			</ENTRY>
			<ENTRY name="RESOURCES12">
				<STRING>






Nacje zaczynają grę z losowym ustawieniem zasobów! W niektórych grach zasoby mogą startować z różnych
poziomów (np. każdy zaczyna z większą ilością bogactwa niż żywności), ale każdy gracz zaczyna z tą samą ilością.





            <!--Random-->
				</STRING>
			</ENTRY>
		</RESOURCES>
