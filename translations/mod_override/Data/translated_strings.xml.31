	<STRING hash="224950315" needed="1">$GOODTYPE0 Ticaret Sınırı: Kütüphanede Ticaret araştırın.</STRING>
	<STRING hash="47953289" needed="1">*** Birim üret: </STRING>
	<STRING hash="8584083" needed="1">x</STRING>
