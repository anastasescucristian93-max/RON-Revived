	<STRING hash="44453362" needed="1">Bina DOLU.</STRING>
	<STRING hash="531963064" needed="1">Tek tuşla birden fazla bina yerle bir edilemez; yerle bir etme emrini yalnızca tek bir bina seçiliyken verebilirsiniz.</STRING>
	<STRING hash="121483893" needed="1">Bina zaten yerle bir ediliyor.</STRING>
	<STRING hash="132974658" needed="1">Kendi başkentinizi yerle bir edemezsiniz.</STRING>
	<STRING hash="321633133" needed="1">Başka bir oyuncunun başkentini, o oyuncu yenilmeden yerle bir edemezsiniz.</STRING>
	<STRING hash="329441696" needed="1">Şehri yerle bir etmeden önce şehirdeki tüm sivil binaları yerle bir etmelisiniz.</STRING>
	<STRING hash="204879201" needed="1">Bir şehirde aynı anda yalnızca bir bina yerle bir edilebilir.</STRING>
	<STRING hash="67369331" needed="1">Kendi kasabalarınıza rüşvet veremezsiniz.</STRING>
	<STRING hash="186672233" needed="1">Yalnızca oyundan düşen takım arkadaşının kasabalarına rüşvet verilebilir.</STRING>
	<STRING hash="204913027" needed="1">Düşman kasabası sizin topraklarınızda değilse rüşvet verilemez.</STRING>
	<STRING hash="81014728" needed="1">Kendi binanıza rüşvet veremezsiniz.</STRING>
	<STRING hash="193920197" needed="1">Yalnızca oyundan düşen takım arkadaşının binalarına rüşvet verilebilir.</STRING>
	<STRING hash="193398731" needed="1">Yalnızca dost topraklardaki binalara rüşvet verilebilir.</STRING>
	<STRING hash="62419324" needed="1">Kendi biriminize rüşvet veremezsiniz.</STRING>
	<STRING hash="186054341" needed="1">Yalnızca oyundan düşen takım arkadaşının birimlerine rüşvet verilebilir.</STRING>
	<STRING hash="81494999" needed="1">Muhbir zaten yerleştirildi.</STRING>
	<STRING hash="104175745" needed="1">Yetenek müttefikleri hedef alamaz.</STRING>
	<STRING hash="108139597" needed="1">Yetenek düşmanları hedef alamaz.</STRING>
	<STRING hash="188417536" needed="1">Yetenek kendi birimlerinizi/binalarınızı hedef alamaz.</STRING>
	<STRING hash="98445725" needed="1">Yetenek birimleri hedef alamaz.</STRING>
	<STRING hash="122784319" needed="1">Yetenek binaları hedef alamaz.</STRING>
	<STRING hash="210314054" needed="1">Senatör yalnızca dost topraklardaki birimlere rüşvet verebilir.</STRING>
	<STRING hash="184967835" needed="1">Yalnızca dost topraklarda siper kazılabilir.</STRING>
	<STRING hash="130528073" needed="1">Yetenek için uygun olmayan hedef.</STRING>
	<STRING hash="58959433" needed="1">Zaten araştırılıyor.</STRING>
	<STRING hash="473436097" needed="1">Her Üniversite yalnızca 7 âlim barındırabilir; daha fazla Âlim üretmek için yeni bir şehirde başka bir Üniversite inşa edin.</STRING>
	<STRING hash="231434891" needed="1">Binanın kuyruğu dolu; sürekli olarak bir birim kuyruğa alınıyor.</STRING>
