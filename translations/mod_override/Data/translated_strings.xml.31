	<STRING hash="107977199" needed="1">: $NUMBER0 $GOODTYPE0 talep ediyor!</STRING>
	<STRING hash="197201483" needed="1">Anlaşma iptal edildi; her ulusa yalnızca bir müttefik izni var.</STRING>
	<STRING hash="43955513" needed="1">: Teklifi KABUL EDİYOR!</STRING>
	<STRING hash="170695467" needed="1">$DUBYA0 ile $SADDAM1 savaşa girdi.</STRING>
	<STRING hash="197391428" needed="1">$DUBYA0 ile $SADDAM1 ittifaklarını bozdu.</STRING>
