	<CAT hash="44397162">
		<STRING hash="34157738" hash_i="34133086" needed="1">Você venceu a batalha.</STRING>
		<STRING hash="82012261" hash_i="81987609" needed="1">Você erradicou os mercenários.</STRING>
		<STRING hash="113504005" hash_i="113479353" needed="1">Você derrotou todas as tribos nômades.</STRING>
		<STRING hash="84115919" hash_i="84091267" needed="1">Você erradicou os mercenários.</STRING>
		<STRING hash="111333699" hash_i="111309047" needed="1">Você atravessou o deserto com sucesso!</STRING>
		<STRING hash="29337395" hash_i="29467319" needed="1">Você unificou a Grécia.</STRING>
		<STRING hash="35815269" hash_i="36034993" needed="1">Você conquistou o Egito.</STRING>
		<STRING hash="54706888" hash_i="54996578" needed="1">Você derrotou Magadha.</STRING>
		<STRING hash="36085555" hash_i="36248479" needed="1">Você conquistou a Índia.</STRING>
		<STRING hash="51797082" hash_i="52086772" needed="1">Você derrotou os Maurya.</STRING>
		<STRING hash="48942727" hash_i="50799331" needed="1">Você protegeu Alexandre!</STRING>
		<STRING hash="62405071" hash_i="62752721" needed="1">Você coletou Metal suficiente.</STRING>
		<STRING hash="42159644" hash_i="42134992" needed="1">Você colonizou novas terras.</STRING>
		<STRING hash="43452384" hash_i="43427732" needed="1">Você venceu a guerra comercial.</STRING>
		<STRING hash="20511596" hash_i="20486944" needed="1">Você conseguiu.</STRING>
		<STRING hash="53554556" hash_i="53529904" needed="1">Você deteve os invasores.</STRING>
		<STRING hash="80249280" hash_i="80224628" needed="1">Você erradicou os mercenários!</STRING>
		<STRING hash="186815686" hash_i="187150976" needed="1">A maioria das revoltas se acalmou. Seu poder está intacto.</STRING>
		<STRING hash="64785017" hash_i="64769589" needed="1">A França derrubou a monarquia.</STRING>
		<STRING hash="44813056" hash_i="44788404" needed="1">Você atravessou o deserto.</STRING>
		<STRING hash="67275366" hash_i="67250714" needed="1">Você erradicou os bandoleiros.</STRING>
		<STRING hash="31182624" hash_i="31157972" needed="1">Você venceu a batalha.</STRING>
		<STRING hash="31208788" hash_i="31184136" needed="1">Você venceu a batalha.</STRING>
		<STRING hash="56459057" hash_i="56434405" needed="1">Você concluiu a missão.</STRING>
	</CAT>
	<CAT hash="38438024">
		<STRING hash="37310381" hash_i="37285729" needed="1">Você perdeu a batalha.</STRING>
		<STRING hash="886320487" hash_i="884168747" needed="1">Seus exércitos não encontraram resistência ao tomar o território.  Porém, os nativos se reagruparam e estão atacando seu novo posto avançado.  Defenda sua capital até o cronômetro acabar para vencer.</STRING>
		<STRING hash="460127993" hash_i="464950815" needed="1">Seu exército está se aproximando de um exército bárbaro.  Ataque o acampamento dele e destrua todos os edifícios para vencer.</STRING>
		<STRING hash="699657885" hash_i="699635379" needed="1">As nações bárbaras desta região são fracas e certamente se curvarão à sua nação se você provar sua superioridade capturando uma das cidades delas.</STRING>
		<STRING hash="782757605" hash_i="781563091" needed="1">Há várias tribos nativas neste território disputando o poder.  Use sua habilidade diplomática para jogá-las umas contra as outras e garantir seu domínio na região.</STRING>
		<STRING hash="1041644836" hash_i="1049167724" needed="1">Um grupo de tribos bárbaras desta região se uniu para destruí-lo.  Felizmente você trouxe suprimentos extras e os bárbaros estão uma idade atrás de você.  Sobreviva até o cronômetro acabar para vencer.</STRING>
		<STRING hash="34211834" hash_i="34187182" needed="1">Você perdeu a batalha.</STRING>
		<STRING hash="85798563" hash_i="85776057" needed="1">Os mercenários esmagaram você.</STRING>
		<STRING hash="174879179" hash_i="174854527" needed="1">Você não conseguiu derrotar todas as tribos nômades.</STRING>
		<STRING hash="86459437" hash_i="86436931" needed="1">Os mercenários esmagaram você.</STRING>
		<STRING hash="450505024" hash_i="450480372" needed="1">Você pereceu nas areias, onde seus ossos alimentariam os abutres, se não fizesse calor demais até para eles.</STRING>
		<STRING hash="60237741" hash_i="60592993" needed="1">Você não conseguiu unificar a Grécia.</STRING>
		<STRING hash="84636528" hash_i="87379740" needed="1">Você não conseguiu proteger Alexandre!</STRING>
		<STRING hash="67149673" hash_i="67515349" needed="1">Você não coletou Metal suficiente.</STRING>
		<STRING hash="65336844" hash_i="65312192" needed="1">Seus colonos foram derrotados.</STRING>
		<STRING hash="29252721" hash_i="29228069" needed="1">Você foi derrotado.</STRING>
		<STRING hash="35405839" hash_i="37285729" needed="1">Você perdeu a batalha.</STRING>
		<STRING hash="46968490" hash_i="46943838" needed="1">Você perdeu a guerra comercial.</STRING>
		<STRING hash="62200690" hash_i="62176038" needed="1">Seu povo vai morrer de fome.</STRING>
		<STRING hash="70563669" hash_i="70541163" needed="1">Os invasores esmagaram você.</STRING>
		<STRING hash="37290612" hash_i="37265960" needed="1">Você morreu na areia.</STRING>
		<STRING hash="70807061" hash_i="70784555" needed="1">Os bandoleiros esmagaram você.</STRING>
		<STRING hash="34157738" hash_i="34133086" needed="1">Você venceu a batalha.</STRING>
		<STRING hash="40929481" hash_i="40904829" needed="1">Você perdeu a batalha.</STRING>
		<STRING hash="44917033" hash_i="44892381" needed="1">Você fracassou na missão.</STRING>
		<STRING hash="444407072" hash_i="444382420" needed="1">Você pereceu nas areias, onde seus ossos alimentariam os abutres, se não fizesse calor demais até para eles.</STRING>
		<STRING hash="55704156" hash_i="55679504" needed="1">Você pereceu nas areias.</STRING>
		<STRING hash="79414608" hash_i="79392102" needed="1">Os mercenários abandonaram você.</STRING>
