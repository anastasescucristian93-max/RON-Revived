	<STRING hash="39821188" needed="1">damage +100</STRING>
	<STRING hash="53536475" needed="1">damage o=5 -100</STRING>
	<STRING hash="86011521" needed="1">damage o=5 shaggy +100</STRING>
	<STRING hash="194301129" needed="1">Use "move" para mover uma unidade ou a seleção</STRING>
