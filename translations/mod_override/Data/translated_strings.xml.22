	<STRING hash="195219748" needed="1">Use "victory [who]" para fazer uma nação vencer.</STRING>
	<STRING hash="193906556" needed="1">Use "defeat [who]" para fazer uma nação perder.</STRING>
	<STRING hash="212146638" needed="1">Use "resource" para ver e alterar os recursos de um jogador</STRING>
	<STRING hash="208434807" needed="1">( resource [who] [goodtype | all] [+|-][quantidade] )</STRING>
	<STRING hash="43222472" needed="1">resource all</STRING>
	<STRING hash="97663183" needed="1">resource red wealth +100</STRING>
	<STRING hash="68527503" needed="1">resource all -1000</STRING>
	<STRING hash="202722417" needed="1">Use "tech" para definir e ver as tecnologias de um jogador</STRING>
	<STRING hash="208201775" needed="1">( tech [who] [techname | all] [ (on | off | show) ] )</STRING>
	<STRING hash="39337513" needed="1">tech all on</STRING>
	<STRING hash="91726012" needed="1">tech The-Art-Of-War off</STRING>
	<STRING hash="99661967" needed="1">tech Shaggy Phalanx show</STRING>
	<STRING hash="19690481" needed="1">tubs</STRING>
	<STRING hash="104197756" needed="1">Use "die" para matar objetos</STRING>
	<STRING hash="109703030" needed="1">( die [o[,who] | select] )</STRING>
