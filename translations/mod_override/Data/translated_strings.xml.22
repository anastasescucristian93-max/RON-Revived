	<STRING hash="23875992" needed="1">anim 5</STRING>
	<STRING hash="150691081" needed="1">Use "damage" para ajustar o dano de</STRING>
	<STRING hash="197440664" needed="1">( damage [o[,who] | select] [+|-]dano )</STRING>
