	<STRING hash="54535231" needed="1">RĂZBOIUL ESTE ACUM PERMIS!</STRING>
	<STRING hash="38153451" needed="1">: Declară RĂZBOI!</STRING>
	<STRING hash="69240020" needed="1">$PLAYERNAME0 a fost învins.</STRING>
	<STRING hash="211971800" needed="1">+$NUMBER0 $GOODTYPE0 primit de la $PRESIDENTRONALDREAGAN1!</STRING>
	<STRING hash="338088966" needed="1">CAPITALA ta a fost cucerită! Vei pierde dacă nu o recucerești imediat!</STRING>
	<STRING hash="399913440" needed="1">CAPITALA ALIATULUI tău a fost cucerită! Va pierde dacă nu o recucerește imediat!</STRING>
	<STRING hash="45064070" needed="1">CAPITALA recucerită!</STRING>
	<STRING hash="73115379" needed="1">CAPITALA ALIATULUI recucerită!</STRING>
	<STRING hash="23815266" needed="1">: Vin.</STRING>
	<STRING hash="48269080" needed="1">: Ajung imediat.</STRING>
	<STRING hash="33268271" needed="1">: Sunt pe drum.</STRING>
	<STRING hash="103839296" needed="1">: Încerc să trimit ajutor.</STRING>
	<STRING hash="153964929" needed="1">: Retrag toate propunerile financiare.</STRING>
	<STRING hash="70434154" needed="1">: Retrag toate ofertele.</STRING>
	<STRING hash="236089175" needed="1">E prea devreme după ruperea alianței ca să declari război!</STRING>
	<STRING hash="52730010" needed="1">: ANULEZ alianța!</STRING>
	<STRING hash="51728128" needed="1">Pace semnată cu </STRING>
	<STRING hash="61016481" needed="1">Alianță jurată cu </STRING>
	<STRING hash="60922386" needed="1">Înțelegere încheiată cu </STRING>
	<STRING hash="8592038" needed="1">!</STRING>
	<STRING hash="78230190" needed="1">: Ne retragem oferta!</STRING>
	<STRING hash="316235377" needed="1">: Fiindcă nu ne ajuți împotriva dușmanilor noștri, alianța noastră nu mai există!</STRING>
	<STRING hash="72268075" needed="1">: RESPINGEM oferta ta!</STRING>
	<STRING hash="190808123" needed="1">Nu ai destul $GOODTYPE0 ca să declari război!</STRING>
	<STRING hash="266580525" needed="1">Înțelegere anulată; națiunile nu pot declara război aliaților actuali.</STRING>
	<STRING hash="42995522" needed="1">: Propun PACE!</STRING>
	<STRING hash="53546364" needed="1">: Propun ALIANȚĂ!</STRING>
	<STRING hash="130161514" needed="1">: Atac comun asupra lui $MISTERBADGUY0</STRING>
	<STRING hash="102071411" needed="1">: Oferă $NUMBER0 $GOODTYPE0!</STRING>
	<STRING hash="120001171" needed="1">: Îți dă $NUMBER0 $GOODTYPE0!</STRING>
	<STRING hash="107977199" needed="1">: Cere $NUMBER0 $GOODTYPE0!</STRING>
	<STRING hash="197201483" needed="1">Înțelegere anulată; un singur aliat permis pentru fiecare națiune.</STRING>
	<STRING hash="43955513" needed="1">: ACCEPTĂ oferta!</STRING>
	<STRING hash="170695467" needed="1">$DUBYA0 și $SADDAM1 au intrat în război.</STRING>
	<STRING hash="197391428" needed="1">$DUBYA0 și $SADDAM1 și-au rupt alianța.</STRING>
	<STRING hash="164018811" needed="1">$DUBYA0 și $SADDAM1 au făcut pace.</STRING>
	<STRING hash="192896700" needed="1">$DUBYA0 și $SADDAM1 au încheiat o alianță.</STRING>
	<STRING hash="112799023" needed="1">Război declarat lui $KINGGEORGE0!</STRING>
	<STRING hash="149995189" needed="1">Alianță anulată cu $YOURDADDY0!</STRING>
	<STRING hash="178673067" needed="1">Embargo nuclear! Piață închisă pentru $TIMERVALUE0!</STRING>
	<STRING hash="224950315" needed="1">Plafon comercial $GOODTYPE0: cercetează Comerț la Bibliotecă.</STRING>
	<STRING hash="47953289" needed="1">*** Creează unitate: </STRING>
	<STRING hash="8584083" needed="1">x</STRING>
	<STRING hash="51778658" needed="1">*** Îmbunătățire unitate: </STRING>
	<STRING hash="38253037" needed="1">*** Întemeiază oraș</STRING>
	<STRING hash="50650814" needed="1">*** Clădire nouă: </STRING>
	<STRING hash="38779613" needed="1">*** Cercetare: </STRING>
	<STRING hash="47565665" needed="1">PRODUCȚIE PRIORITARĂ </STRING>
	<STRING hash="21188621" needed="1">PRODUCȚIE </STRING>
	<STRING hash="23489735" needed="1">ECONOMISEȘTE PT. </STRING>
	<STRING hash="10023785" needed="1">) </STRING>
	<STRING hash="91742678" needed="1">Niciun cetățean liber/la adunat</STRING>
	<STRING hash="174844414" needed="1">INTERZIS: niciun cetățean liber/la adunat</STRING>
	<STRING hash="184765405" needed="1">INTERZIS: niciun loc în orașul desemnat</STRING>
	<STRING hash="44368989" needed="1">Nu s-a putut pune în coadă!</STRING>
	<STRING hash="248310032" needed="1">Ha! Nu vom trata niciodată cu tine cât timp ne pângărești capitala!</STRING>
	<STRING hash="289778051" needed="1">Pfui! Nu vom trata niciodată cu tine cât timp aliatul tău ne pângărește capitala!</STRING>
	<STRING hash="220019791" needed="1">Națiunea ta arogantă trebuie zdrobită înainte să fie prea târziu!</STRING>
	<STRING hash="250359174" needed="1">Națiunea ta e jalnică și slabă. Poate te voi zdrobi mai târziu.</STRING>
	<STRING hash="247885119" needed="1">Națiunea ta e primitivă. Poate ar trebui să-mi trimiți niște tribut.</STRING>
	<STRING hash="234990205" needed="1">Așa-zisa ta națiune mă face să râd. Nu însemni nimic pentru mine.</STRING>
	<STRING hash="245737799" needed="1">Poate cândva, în viitor, mă voi îndura să am de-a face cu tine.</STRING>
	<STRING hash="258179323" needed="1">Obiceiurile tale primitive mă intrigă. S-ar putea să te las în viață. Sau poate nu.</STRING>
	<STRING hash="330002204" needed="1">Ești la fel de important ca o muscă ce bâzâie--dar și muștele trebuie strivite cândva.</STRING>
	<STRING hash="260993248" needed="1">Râd de grămăjoara de colibe pe care le numești orașe. Adio.</STRING>
	<STRING hash="211281564" needed="1">Nu-mi place cum arăți. Stai departe de teritoriul meu.</STRING>
	<STRING hash="229560917" needed="1">Națiunea ta pare războinică și nesăbuită. Nu te juca cu mine.</STRING>
	<STRING hash="221605964" needed="1">Cu siguranță nu ai nevoie de ajutorul nostru, iar noi nu avem nevoie de al tău.</STRING>
	<STRING hash="257558997" needed="1">O politică de dezinteres reciproc a fost mereu calea mea preferată.</STRING>
	<STRING hash="236917199" needed="1">Mă feresc de orice națiune aflată sub comanda alteia. Stai departe.</STRING>
	<STRING hash="318091568" needed="1">Să nu crezi că, fiindcă părem slabi, te poți juca cu noi. Ferește-te de puterea noastră!</STRING>
	<STRING hash="244158573" needed="1">Națiunea ta e foarte măreață, dar noi preferăm status quo-ul. Pleacă!</STRING>
	<STRING hash="222211144" needed="1">Ne așteptăm la aceste daruri dacă vrei să păstrăm alianța.</STRING>
	<STRING hash="193202396" needed="1">Plătește tribut gloriei națiunii mele sau vei fi distrus!</STRING>
	<STRING hash="186918665" needed="1">M-am săturat de națiunea ta firavă: plătește sau mori!</STRING>
	<STRING hash="187498554" needed="1">Națiunea ta e nevrednică--trimite tribut, altfel vezi tu!</STRING>
	<STRING hash="439518922" needed="1">E timpul să-mi dovedești cât valorezi. Trimite-mi tribut și, dacă nu mă nemulțumește, te voi lăsa în viață.</STRING>
	<STRING hash="291098527" needed="1">E timpul să alegi: plătești ca să trăiești sau înfrunți distrugerea totală.</STRING>
	<STRING hash="369326810" needed="1">Un tribut rezonabil îți va garanta existența. Refuzul înseamnă moarte.</STRING>
	<STRING hash="278578729" needed="1">Nu ești decât o povară pentru măreția noastră; trebuie să plătești tribut.</STRING>
	<STRING hash="414527915" needed="1">Încă așteptăm darurile cuvenite rangului nostru înalt. De ce nu ne-ai plătit?</STRING>
	<STRING hash="302680724" needed="1">Fiindcă ai ignorat condițiile mele generoase, te voi strivi sub talpă!</STRING>
	<STRING hash="354652995" needed="1">Ce? Refuzi să plătești chiar și un tribut atât de mărunt? Atunci pregătește-te de război!</STRING>
	<STRING hash="377440436" needed="1">Nu cerem tribut în glumă! Fiindcă refuzi să plătești, urmarea este războiul.</STRING>
	<STRING hash="277820511" needed="1">Crezi că blufăm? Nebunule; refuzul de a plăti înseamnă că suntem în război!</STRING>
	<STRING hash="463492904" needed="1">Considerăm refuzul tău de a ne satisface cererile foarte rezonabile un act de război. Pregătește-te!</STRING>
	<STRING hash="342541890" needed="1">Ți-am oferit o cale pașnică; tu ai ales calea conflictului. Prea bine!</STRING>
	<STRING hash="407427012" needed="1">Credeam că cererile noastre erau destul de rezonabile. Ce ciudat că ai ales în schimb moartea!</STRING>
	<STRING hash="191136850" needed="1">Națiunea ta e jalnică. Privește cum o zdrobesc!</STRING>
	<STRING hash="228483664" needed="1">E timpul ca națiunea ta slabă să fie adăugată puternicului meu imperiu!</STRING>
	<STRING hash="243845754" needed="1">Voi dansa o horă când oștile mele vor defila prin capitala ta!</STRING>
	<STRING hash="268566524" needed="1">Existența ta îmi provoacă nesfârșită neliniște. E timpul să-i pun capăt.</STRING>
	<STRING hash="522559363" needed="1">Vine o vreme când o națiune puternică trebuie să-și exercite dreptul de a-i anexa pe cei slabi. Acum ne vom exercita acest drept.</STRING>
	<STRING hash="241167866" needed="1">Nu văd absolut niciun motiv să te las să mai exiști.</STRING>
	<STRING hash="435676947" needed="1">Declarăm prin prezenta că între jalnica ta națiune și puternica noastră națiune există stare de război.</STRING>
	<STRING hash="354802453" needed="1">Provocările tale continue nu pot rămâne nepedepsite. Națiunea ta trebuie nimicită!</STRING>
	<STRING hash="186741968" needed="1">Ești o amenințare pentru planurile mele de a stăpâni lumea!</STRING>
	<STRING hash="180928184" needed="1">Nu am încredere în tine, așa că trebuie să te distrug!</STRING>
	<STRING hash="195301813" needed="1">Nu pot lăsa națiunea ta să devină și mai puternică!</STRING>
	<STRING hash="251073950" needed="1">Chiar dacă poate cauza noastră e pierdută, trebuie să te distrugem sau să murim încercând.</STRING>
	<STRING hash="372618115" needed="1">Poate e prea târziu, dar cineva trebuie să te oprească...cauza libertății nu trebuie să șovăie!</STRING>
	<STRING hash="423862338" needed="1">Declarăm prin prezenta că între națiunea ta războinică și a noastră există stare de război.</STRING>
	<STRING hash="415533303" needed="1">Știm că plănuiești să ne trădezi și să ne zdrobești, așa că nu avem de ales decât să lovim primii!</STRING>
	<STRING hash="204288097" needed="1">Eu și numeroșii mei aliați și prieteni te vom distruge acum!</STRING>
	<STRING hash="199487055" needed="1">E timpul ca drumurile noastre să se despartă.</STRING>
	<STRING hash="106065578" needed="1">Hei! Ieși de pe teritoriul meu!</STRING>
	<STRING hash="213350911" needed="1">Mi-ai încălcat granițele, retrage-te imediat!</STRING>
	<STRING hash="211600226" needed="1">Părăsește imediat teritoriul meu sau suportă consecințele!</STRING>
	<STRING hash="420757302" needed="1">Poate nu știi că unitățile tale au rătăcit pe teritoriul meu. Te rog să le retragi.</STRING>
	<STRING hash="297541391" needed="1">Granițele națiunii noastre nu vor fi pângărite de unii ca tine! Retrage-te!</STRING>
	<STRING hash="457477476" needed="1">Dacă trupele tale nu sunt retrase imediat, nu voi avea de ales decât să iau măsuri drastice.</STRING>
	<STRING hash="287462266" needed="1">Am făcut tot posibilul să-ți respectăm granițele. Te rog să le respecți pe ale noastre.</STRING>
	<STRING hash="304720331" needed="1">Nebunule! Vrei să începi un război? Retrage-te de pe teritoriul meu...ACUM.</STRING>
	<STRING hash="306018123" needed="1">Mulțumesc, dar am deja un aliat excelent și nu am nevoie de altul.</STRING>
	<STRING hash="165404144" needed="1">Nu ne vom ataca niciodată propriii aliați!</STRING>
	<STRING hash="371893960" needed="1">Cu siguranță nu-ți voi face voia dacă nu-mi propui măcar pace!</STRING>
	<STRING hash="212028527" needed="1">Vistieria noastră e goală și nu-ți putem satisface cererile.</STRING>
	<STRING hash="280968714" needed="1">Am face bucuroși pace cu tine, dar nu ne permitem prețul tău.</STRING>
	<STRING hash="299283342" needed="1">Nu avem fonduri suficiente acum. Poate dacă ne mai dai timp?</STRING>
	<STRING hash="423622191" needed="1">Ne dorim pacea, desigur...doar că prețul e prea mare. Ai accepta o cerere mai mică?</STRING>
	<STRING hash="498392901" needed="1">Ne va lua foarte mult timp să strângem plata pe care o dorești. Chiar vrei să aștepți atât pentru pace?</STRING>
	<STRING hash="282650302" needed="1">E o ofertă bună...dar nu grozavă. Îți vom da un răspuns mai târziu.</STRING>
	<STRING hash="268092967" needed="1">Națiunea noastră e săracă și slabă și nu-ți poate satisface cererile exorbitante.</STRING>
	<STRING hash="231748353" needed="1">Îmi cer scuze, dar suma pe care o ceri e imposibil de mare.</STRING>
	<STRING hash="205161217" needed="1">Vai, pur și simplu nu avem resursele pentru asta.</STRING>
	<STRING hash="199175990" needed="1">Ceri prea mult. Nu ne permitem asta.</STRING>
	<STRING hash="227788432" needed="1">Nu am nicio obiecție, în afară de lipsa resurselor suficiente.</STRING>
	<STRING hash="327793229" needed="1">Ne vei stoarce de tot! Mă tem că nu avem destule resurse să te ajutăm.</STRING>
	<STRING hash="172729291" needed="1">Suntem prea săraci ca să satisfacem o asemenea cerere.</STRING>
	<STRING hash="334269085" needed="1">Chiar e situația atât de gravă? Nu avem nici pe departe atâtea resurse.</STRING>
	<STRING hash="428337814" needed="1">Fie îți merge foarte bine, fie foarte rău, dar nu putem aduna o asemenea plată.</STRING>
	<STRING hash="232693381" needed="1">Mă tem că nu avem atât. Te-ai mulțumi cu mai puțin?</STRING>
	<STRING hash="189456783" needed="1">M-ai mai trădat o dată. Pot să am încredere în tine acum? </STRING>
	<STRING hash="183834793" needed="1">M-ai înșelat în trecut. </STRING>
	<STRING hash="187007983" needed="1">Te căiești acum pentru trădarea de altădată? </STRING>
	<STRING hash="148509465" needed="1">Nu iert ușor trădarea. </STRING>
	<STRING hash="249542032" needed="1">Mă tem că propunerile tale sunt rostite cu o limbă dulce, dar vicleană. </STRING>
	<STRING hash="427667416" needed="1">Trebuie să recunoști că experiențele noastre de până acum cu tine au fost departe de a fi mulțumitoare. </STRING>
	<STRING hash="228448189" needed="1">Cine trădează o dată, trădează mereu. Cum să am încredere în tine? </STRING>
	<STRING hash="320175427" needed="1">Aș fi nebun să am încredere în tine...dar, pentru prețul potrivit, pot fi nebun. </STRING>
	<STRING hash="331042648" needed="1">Trădările tale trecute nu sunt uitate. Să nu-ți treacă prin cap să mă înșeli a doua oară! </STRING>
	<STRING hash="183983037" needed="1">Reputația ta proastă te precede. </STRING>
	<STRING hash="214826819" needed="1">Nu te-ai ținut de cuvânt în înțelegerile cu alții. </STRING>
	<STRING hash="222445914" needed="1">Nu suntem orbi la trecutul tău plin de trădări. </STRING>
	<STRING hash="453306320" needed="1">Știu că e periculos să am încredere în tine, dar pe mine nu m-ai înșelat niciodată, așa că s-ar putea să risc. </STRING>
	<STRING hash="210577694" needed="1">Să nu-ți treacă prin cap să mă înșeli cum i-ai înșelat pe atâția alții. </STRING>
	<STRING hash="235479593" needed="1">Vom fi atenți la tine și la înclinația ta spre trădare. </STRING>
	<STRING hash="336994428" needed="1">Ți-ai trădat aliații în trecut. Ai grijă: noi suntem făcuți dintr-un aluat mai tare. </STRING>
	<STRING hash="72357580" needed="1">Nu chiar destul. </STRING>
	<STRING hash="48598985" needed="1">Hmmmm... Aproape. </STRING>
	<STRING hash="223618339" needed="1">Dacă ai putea să mai adaugi doar puțin... </STRING>
	<STRING hash="74343247" needed="1">Te apropii. </STRING>
	<STRING hash="178837069" needed="1">E o ofertă bună, dar nu grozavă. </STRING>
	<STRING hash="142195800" needed="1">Aproape asta aveam în minte. </STRING>
	<STRING hash="267373152" needed="1">Dacă te mai străduiești puțin, sunt sigur că ajungem la o înțelegere. </STRING>
	<STRING hash="172952292" needed="1">Mai dă-mi cam $NUMBER0 $GOODNAME0.</STRING>
	<STRING hash="177155763" needed="1">M-ai insultat pentru ultima oară!</STRING>
	<STRING hash="180302484" needed="1">M-am săturat de cererile tale meschine!</STRING>
	<STRING hash="258334769" needed="1">Mă iei drept prost? Aceste insulte nu mai pot rămâne fără răspuns!</STRING>
	<STRING hash="296119734" needed="1">Vrei să ne distrugi din interior, dar nu te voi lăsa. Vom învinge!</STRING>
	<STRING hash="295561722" needed="1">S-a mers prea departe. Cererile tale ridicole ne-au adus la război!</STRING>
	<STRING hash="237401838" needed="1">Crezi că suntem supușii tăi, de îndrăznești să ne impui astfel de biruri? Nebunule!</STRING>
	<STRING hash="278153570" needed="1">Această insultă nu poate fi îndurată. Jalnica ta națiune trebuie nimicită!</STRING>
	<STRING hash="243093180" needed="1">Accept bucuros pacea cu tine, dar nu mă pot angaja într-o alianță.</STRING>
	<STRING hash="293397138" needed="1">Prețuiesc prietenia ta, dar nu pot face o alianță, cel puțin deocamdată.</STRING>
	<STRING hash="430778043" needed="1">Pacea între noi e un lucru. Să ne legăm soarta de a ta într-o alianță e cu totul altceva.</STRING>
	<STRING hash="234192001" needed="1">Mă tem că o alianță nu e în interesul nostru în acest moment.</STRING>
	<STRING hash="277561636" needed="1">Prețuim prietenia ta, dar nu îndrăznim să ne aliem cu tine acum.</STRING>
	<STRING hash="356361200" needed="1">O alianță presupune un angajament mult mai mare decât suntem dispuși să ne asumăm acum.</STRING>
	<STRING hash="321133867" needed="1">Să avem pace, dar calea noastră nu e a ta. Fără alianță deocamdată, mulțumim.</STRING>
	<STRING hash="215498525" needed="1">Accept bucuros pacea cu tine, dar nu-ți pot satisface cererea.</STRING>
	<STRING hash="214248016" needed="1">Prețuiesc prietenia ta, dar asta pur și simplu nu e posibil.</STRING>
	<STRING hash="302522727" needed="1">Marile noastre națiuni sunt prietene apropiate, dar regretăm că nu putem încheia această înțelegere.</STRING>
	<STRING hash="293937517" needed="1">Îmi pare foarte rău, dar suntem ocupați cu treburile statului. Întreabă din nou mai târziu.</STRING>
	<STRING hash="213973279" needed="1">Ești un prieten de nădejde, dar de data asta trebuie să spunem nu.</STRING>
	<STRING hash="232811955" needed="1">Cu tot respectul, trebuie să refuz propunerea ta generoasă.</STRING>
	<STRING hash="328051166" needed="1">E o înțelegere tentantă, dar cred că nu e în interesul nostru în acest moment.</STRING>
	<STRING hash="220738600" needed="1">Nu-mi pune răbdarea la încercare. Nu ești vrednic să-mi fii aliat.</STRING>
	<STRING hash="180224449" needed="1">O alianță cu tine? Nici vorbă!</STRING>
	<STRING hash="246616388" needed="1">Ce idee absurdă. Nu văd niciun folos într-o alianță cu tine.</STRING>
	<STRING hash="267446781" needed="1">Nu aduci destul la masă ca să ne dorim o alianță cu tine.</STRING>
	<STRING hash="277800348" needed="1">Cred că o alianță cu tine ar fi îngrozitoare pentru marea noastră națiune.</STRING>
	<STRING hash="296518323" needed="1">Ce? Și să întoarcem opinia lumii împotriva noastră? Refuzăm oferta ta de alianță!</STRING>
	<STRING hash="427403398" needed="1">Poate ar trebui să încerci să păcălești pe cineva mai prost. Nu vreau alianța ta ridicolă.</STRING>
	<STRING hash="246369465" needed="1">Nu ești vrednic să faci pace cu mine. Pregătește-te să fii distrus!</STRING>
	<STRING hash="194324741" needed="1">Râd de încercările tale firave de a negocia!</STRING>
	<STRING hash="305372968" needed="1">Umilința ta e jalnică. Nimicirea națiunii tale va fi o plăcere.</STRING>
	<STRING hash="311933370" needed="1">Destul cu vorbele astea prostești. Îmi voi trimite armata să termine cu tine.</STRING>
	<STRING hash="226154979" needed="1">Desigur că îți dorești pacea--dar eu aș prefera să te distrug!</STRING>
	<STRING hash="424658975" needed="1">Deci vrei să te predai, nu? Asta vrei să spui cu aceste propuneri de pace ridicole?</STRING>
	<STRING hash="267638248" needed="1">Ce idee absurdă. Nu văd mare folos în a face pace cu tine.</STRING>
	<STRING hash="292327957" needed="1">O ofertă de pace, zici? Asta poate să însemne doar că sunt pe cale să te frâng!</STRING>
	<STRING hash="189812417" needed="1">Nu poate fi pace cu un câine ca tine!</STRING>
	<STRING hash="212786238" needed="1">Nu-mi mai pune răbdarea la încercare cu cererile tale meschine!</STRING>
	<STRING hash="243043190" needed="1">Nu mă interesează târgurile tale ridicole. Pleacă de aici!</STRING>
	<STRING hash="219668072" needed="1">Condițiile tale ne interesează prea puțin. Răspunsul nostru e nu!</STRING>
	<STRING hash="217752922" needed="1">Mă sâcâi ca o muscă ce bâzâie. Pleacă sau te strivesc!</STRING>
	<STRING hash="326647968" needed="1">Nebunule; văicărelile tale doar mă înfurie. Ai grijă să nu mergi prea departe.</STRING>
	<STRING hash="225884819" needed="1">Ce ofertă absurdă. Du-te și negociază cu altcineva.</STRING>
	<STRING hash="234577067" needed="1">Așa-zisa ta ofertă e o insultă greu de îndurat.</STRING>
	<STRING hash="204384511" needed="1">Măreția ta e evidentă! Te pot ajuta cu ceva?</STRING>
	<STRING hash="361043818" needed="1">Sunt uimit de realizările glorioase ale națiunii tale. Facem o alianță?</STRING>
	<STRING hash="199391667" needed="1">Îmi îngădui să devin umilul tău slujitor?</STRING>
	<STRING hash="222404866" needed="1">Împreună, cele două națiuni ale noastre pot cuceri totul. Ce zici?</STRING>
	<STRING hash="223273732" needed="1">Ca prieteni, suntem puternici. Ca aliați, am fi de neînvins!</STRING>
	<STRING hash="304709757" needed="1">Avem multe țeluri comune. Ce-ai zice să facem o alianță ca să le atingem?</STRING>
	<STRING hash="316668167" needed="1">Trebuie să ne unim forțele înainte ca dușmanii noștri comuni să ne distrugă pe rând!</STRING>
	<STRING hash="221915984" needed="1">Aliază-te cu mine, o, mare și puternic prieten. E destinul tău!</STRING>
	<STRING hash="240666716" needed="1">Ai vrea să facem o alianță împotriva dușmanilor noștri comuni?</STRING>
	<STRING hash="219630192" needed="1">Dacă ne unim într-o alianță, vom fi de neoprit!</STRING>
	<STRING hash="372242136" needed="1">Alte națiuni ne întrec în glorie; asta nu trebuie permis. Ar trebui să ne aliem!</STRING>
	<STRING hash="380580075" needed="1">O alianță între marile noastre națiuni ne va aduce victoria amândurora! Ce zici?</STRING>
	<STRING hash="340298787" needed="1">Trebuie să acționăm împreună ca să ne oprim dușmanii comuni. Doar o alianță ne poate salva.</STRING>
	<STRING hash="305352665" needed="1">Ai nevoie de un aliat ca mine ca să ajungi la dominația totală a lumii.</STRING>
	<STRING hash="291650593" needed="1">Am fi bucuroși să-ți fim aliați ca să-ți atingi măreția evidentă.</STRING>
	<STRING hash="212991696" needed="1">Ar accepta marea ta națiune să facă pace cu noi?</STRING>
	<STRING hash="261670038" needed="1">Avem multe de învățat de la marea ta națiune. Facem pace?</STRING>
	<STRING hash="205232394" needed="1">Gloria națiunii tale e un exemplu pentru ceilalți.</STRING>
	<STRING hash="289430587" needed="1">Tremurăm în fața puternicului tău imperiu. Ai fi dispus să faci pace?</STRING>
	<STRING hash="316256472" needed="1">Ne plecăm în fața cunoașterii tale superioare. Ai fi dispus să faci pace cu noi?</STRING>
	<STRING hash="297356076" needed="1">Îți cerem cu umilință îngăduința și te rugăm să facem pace între națiunile noastre.</STRING>
	<STRING hash="330733030" needed="1">Avem puține de oferit, dar poate un tratat de pace ți-ar fi pe plac.</STRING>
	<STRING hash="211736033" needed="1">Trebuie să avem pace! Te rog, puternicule, nu ne distruge!</STRING>
	<STRING hash="190257595" needed="1">Națiunea ta e vrednică să facă pace cu noi.</STRING>
	<STRING hash="193087364" needed="1">Nu am nimic cu tine; facem pace?</STRING>
	<STRING hash="209612187" needed="1">Să lăsăm războiul deoparte și să trăim unul lângă altul în pace.</STRING>
	<STRING hash="413602476" needed="1">Cred că ai suferit destul. Îți acord pacea, dacă ești destul de înțelept s-o accepți.</STRING>
	<STRING hash="369552387" needed="1">Au apărut amenințări noi și se pare că ar fi înțelept să facem pace.</STRING>
	<STRING hash="380736976" needed="1">Pleacă-te în fața cunoașterii noastre superioare: fă pace cu noi acum sau suportă consecințele!</STRING>
	<STRING hash="454562223" needed="1">A fost distractiv, nu-i așa? Dar acum cred că e timpul pentru pace. Te pot distruge oricând mai târziu.</STRING>
	<STRING hash="451135382" needed="1">Ai pierdut. În loc să te las să suferi mai mult, sunt dispus să-ți acord un tratat de pace.</STRING>
	<STRING hash="199944527" needed="1">Mergi la Diplomație (tastă: $HOTKEY0) ca să răspunzi la ofertă.</STRING>
	<STRING hash="153453181" needed="1">Mergi la Diplomație ca să răspunzi la ofertă.</STRING>
	<STRING hash="185784728" needed="1">Salutări. Să trăim unul lângă altul în pace.</STRING>
	<STRING hash="260916963" needed="1">E mereu o plăcere să-l întâlnesc pe conducătorul unei națiuni mai primitive.</STRING>
	<STRING hash="211013884" needed="1">Salut, prietene. Suntem o națiune prietenoasă și pașnică.</STRING>
	<STRING hash="279830384" needed="1">Bine te-am găsit. Pari inofensiv, așa că te vom lăsa să trăiești în pace.</STRING>
	<STRING hash="429895836" needed="1">Salutări din partea marii și puternicei noastre națiuni către națiunea ta. Să coexistăm în pace.</STRING>
	<STRING hash="292042816" needed="1">Salutări. Deocamdată suntem dedicați coexistenței pașnice cu tine.</STRING>
	<STRING hash="306075614" needed="1">Fiindcă nu reprezinți o amenințare pentru noi, ce-ai zice să trăim mai departe în pace?</STRING>
	<STRING hash="266119979" needed="1">S-ar putea să ne fii de folos în viitor. Să fim prieteni deocamdată.</STRING>
	<STRING hash="218775631" needed="1">Salutări, puternicule! Fie ca popoarele noastre să trăiască multă vreme în pace.</STRING>
	<STRING hash="213753728" needed="1">Salut ție, mare conducător! Suntem un popor prietenos și pașnic.</STRING>
	<STRING hash="225835303" needed="1">Dacă mă lași în pace, nu te voi deranja.</STRING>
	<STRING hash="227999177" needed="1">Națiunea noastră salută pacea cu tine, o, mare și puternicule.</STRING>
	<STRING hash="448272607" needed="1">Sugerăm cu umilință că pacea între marile noastre națiuni ne va fi de folos amândurora.</STRING>
	<STRING hash="247247206" needed="1">Cu asemenea prieteni ca tine alături, ne simțim feriți de orice rău.</STRING>
	<STRING hash="245125934" needed="1">Bine te-am găsit. Te asigurăm că suntem inofensivi și ne dorim doar pacea.</STRING>
	<STRING hash="290233028" needed="1">E bine să întâlnesc un conducător atât de înțelept, puternic și pașnic ca tine.</STRING>
	<STRING hash="76857663" needed="1">Întreabă din nou mai târziu.</STRING>
	<STRING hash="210724823" needed="1">Nu avem deloc $RESOURCE0 disponibil în acest moment.</STRING>
	<STRING hash="50175601" needed="1">: Te acopăr.</STRING>
	<STRING hash="21952089" needed="1">: Am înțeles.</STRING>
	<STRING hash="56747190" needed="1">: Se va face.</STRING>
	<STRING hash="94567431" needed="1">: Mă ocup imediat.</STRING>
	<STRING hash="21738191" needed="1">: Super.</STRING>
	<STRING hash="36097099" needed="1">: Ești tare.</STRING>
	<STRING hash="129737840" needed="1">: Așa da!</STRING>
	<STRING hash="101456888" needed="1">: Consideră că s-a rezolvat.</STRING>
	<STRING hash="187637433" needed="1">: Nu degeaba mi se spune „$LEADERNAME0”, puștiule.</STRING>
	<STRING hash="66153372" needed="1">: Sună a plan.</STRING>
	<STRING hash="24296545" needed="1">: Mișto.</STRING>
	<STRING hash="268765007" needed="1">Ai atins limita de populație! Cercetează Militar la Bibliotecă</STRING>
