	<STRING hash="92152732" needed="1">Inițializare teren - drumuri</STRING>
	<STRING hash="96898148" needed="1">Inițializare teren - râuri</STRING>
	<STRING hash="79945274" needed="1">Inițializare teren - petrol</STRING>
