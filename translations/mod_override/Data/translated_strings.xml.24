	<STRING hash="67056579" needed="1">Start: $AGE0</STRING>
	<STRING hash="58209345" needed="1">Final: $AGE0</STRING>
	<STRING hash="104295860" needed="1">Condiții de victorie:</STRING>
	<STRING hash="286638078" needed="1">Pentru prestația ta în această bătălie, ai primit:</STRING>
	<STRING hash="143061679" needed="1">#ICON17 Carte bonus</STRING>
	<STRING hash="435981766" needed="1">Aliații tăi, $TRIBE0, au ales să trimită $NUM0 tribut în loc de ajutor militar.</STRING>
	<STRING hash="523014646" needed="1">Aliații tăi, $TRIBE0 și $TRIBE1, au ales să trimită fiecare câte $NUM0 tribut în loc de ajutor militar.</STRING>
