	<STRING hash="105567293" needed="1">Nu e loc ca negustorul să se instaleze.</STRING>
	<STRING hash="28501024" needed="1">Cercetașul e inactiv.</STRING>
	<STRING hash="72452796" needed="1">Nu poate ajunge la țintă.</STRING>
	<STRING hash="85957301" needed="1">Nu sunt resurse pentru reparații.</STRING>
	<STRING hash="101070157" needed="1">Nu se găsește un oraș cu care să facă comerț.</STRING>
	<STRING hash="218716308" needed="1">Nu poți face comerț cu alte națiuni până nu descoperi „Comerț”</STRING>
	<STRING hash="253317981" needed="1">Rutele comerciale sunt pline. Fiecare oraș poate avea 1 rută comercială pentru fiecare destinație.</STRING>
	<STRING hash="64627378" needed="1">Nu îți permiți această vrajă.</STRING>
	<STRING hash="61327187" needed="1">Nicio resursă rară aici.</STRING>
	<STRING hash="205833409" needed="1">Senatorul poate mitui unități doar pe teritoriu prietenos.</STRING>
	<STRING hash="128438183" needed="1">Un Spion inamic încearcă să mituiască!</STRING>
	<STRING hash="137050314" needed="1">Un Spion inamic plasează un Informator!</STRING>
	<STRING hash="222610845" needed="1">Avioanele tale se prăbușesc pentru că nu au unde să aterizeze!</STRING>
	<STRING hash="35274179" needed="1">Baza aeriană este plină.</STRING>
	<STRING hash="184462060" needed="1">Trebuie să asimilezi orașul înainte să pui garnizoană în el.</STRING>
	<STRING hash="195460388" needed="1">Nu poți adăuga la garnizoana Orașului cât timp e avariat peste 90%.</STRING>
	<STRING hash="173128833" needed="1">$UNITTYPE0 nu încape în acest $BUILDINGNAME1</STRING>
	<STRING hash="184135484" needed="1">Nu poți pune garnizoană într-o clădire pe teritoriu inamic</STRING>
	<STRING hash="8536484" needed="1"> o, </STRING>
	<STRING hash="61337025" needed="1"> who : unitatea are probleme.</STRING>
	<STRING hash="258228452" needed="1">Unitățile militare de pe teritoriul rus primesc daune de la „Iarna rusească”!</STRING>
	<STRING hash="237300063" needed="1">Unitățile militare de pe teritoriu inamic pot primi daune de uzură!</STRING>
	<STRING hash="235040544" needed="1">Construiește Care de provizii la o Fabrică pentru a preveni daunele de uzură.</STRING>
	<STRING hash="248760936" needed="1">Construiește Care de provizii la un Atelier de asediu pentru a preveni daunele de uzură.</STRING>
	<STRING hash="254202465" needed="1">Unitățile militare au treizeci de secunde să părăsească teritoriul fostului aliat.</STRING>
	<STRING hash="253956558" needed="1">Unitățile militare au treizeci de secunde să părăsească teritoriul fostului inamic.</STRING>
	<STRING hash="469176847" needed="1">Unitățile militare de pe teritoriul fostului aliat suferă daune grele de uzură! Declară război înainte de a ataca.</STRING>
	<STRING hash="468445325" needed="1">Unitățile militare de pe teritoriul fostului inamic suferă daune grele de uzură! Declară război înainte de a ataca.</STRING>
