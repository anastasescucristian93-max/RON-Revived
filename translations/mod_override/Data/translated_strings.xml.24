	<STRING hash="73873046" needed="1">Aliați: $NUM0</STRING>
	<STRING hash="475224216" needed="1">Obține cărți bonus tactice cucerind teritorii sau cumpărându-le pe harta strategică.</STRING>
	<STRING hash="133795735" needed="1">Cărțile tale bonus jucate</STRING>
	<STRING hash="155790073" needed="1">Cărțile bonus jucate de inamic</STRING>
	<STRING hash="231830992" needed="1">Ai obținut următoarele din acest teritoriu:</STRING>
	<STRING hash="113599954" needed="1">#ICON17 Carte bonus</STRING>
	<STRING hash="135527432" needed="1">#ICON18 Resursă rară</STRING>
	<STRING hash="140118470" needed="1">#ICON19 Tribut: $NUM0</STRING>
	<STRING hash="133330333" needed="1">#ICON15 Centru de aprovizionare</STRING>
	<STRING hash="60708573" needed="1">Continuă</STRING>
	<STRING hash="111141893" needed="1">O hartă nouă creată de utilizator.</STRING>
	<STRING hash="236675420" needed="1">Închide fereastra Evenimente mondiale înainte de a lansa un nou atac.</STRING>
	<STRING hash="296265146" needed="1">Ești invadat. Trebuie să rezolvi bătălia înainte de a continua.</STRING>
	<STRING hash="417524759" needed="1">Armatele care au efectuat o copleșire în tura curentă nu se pot muta și nu pot sprijini.</STRING>
	<STRING hash="256958382" needed="1">Armatele obținute în tura curentă nu se pot muta și nu pot sprijini.</STRING>
	<STRING hash="203230591" needed="1">Într-un teritoriu se poate construi o singură Minune.</STRING>
	<STRING hash="211029943" needed="1">Cărțile Trădare nu pot fi folosite împotriva unui aliat.</STRING>
	<STRING hash="246147350" needed="1">Cărțile Trădare nu pot fi jucate pentru a cuceri o capitală inamică.</STRING>
	<STRING hash="202812102" needed="1">Cartea trebuie jucată într-un teritoriu evidențiat</STRING>
	<STRING hash="204444083" needed="1">Trebuie să plasezi armatele în propriile teritorii</STRING>
	<STRING hash="195236091" needed="1">Un teritoriu poate fi ocupat de o singură armată</STRING>
	<STRING hash="208445991" needed="1">Trebuie să scoți o armată din propriul teritoriu</STRING>
	<STRING hash="201232972" needed="1">Trebuie să selectezi un teritoriu cu o armată</STRING>
	<STRING hash="200124357" needed="1">Poți întări doar propriile teritorii.</STRING>
	<STRING hash="443712865" needed="1">Nu ai destul Tribut pentru a întări puterea acestui teritoriu.  Ai nevoie de $NUM0 Tribut.</STRING>
	<STRING hash="205982226" needed="1">Teritoriile nu pot fi întărite peste nivelul $NUM0.</STRING>
	<STRING hash="347503620" needed="1">Nu poți cumpăra acest teritoriu, deoarece este ocupat de barbari.</STRING>
	<STRING hash="212864284" needed="1">Nu poți cumpăra capitala altei națiuni.</STRING>
	<STRING hash="244462875" needed="1">Poți cumpăra doar teritorii care se învecinează cu imperiul tău.</STRING>
	<STRING hash="237403672" needed="1">Poți plasa rachete nucleare doar în propriul teritoriu.</STRING>
	<STRING hash="204280249" needed="1">Poți ținti un teritoriu doar cu o singură rachetă.</STRING>
	<STRING hash="434852665" needed="1">Nu poți ținti capitala inamicului până când toate celelalte teritorii inamice nu au fost țintite.</STRING>
	<STRING hash="200785568" needed="1">Poți ținti doar teritorii deținute de inamic.</STRING>
